func main() {
    __syx_sql_exec("CREATE TABLE items (id INT, label TEXT)")
    __syx_sql_exec("INSERT INTO items VALUES (1, 'alpha')")
    __syx_sql_exec("INSERT INTO items VALUES (2, 'beta')")
    let cnt = __syx_sql_query("SELECT COUNT(*) AS c FROM items")
    print(cnt.count)
    print(cnt[0])
    let one = __syx_sql_query("SELECT id FROM items WHERE id = 1")
    print(one.count)
    let empty = __syx_sql_query("SELECT id FROM items WHERE id = 999")
    print(empty.count)
}

