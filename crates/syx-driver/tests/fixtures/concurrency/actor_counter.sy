actor Counter {
    var value: Int
    init(value: Int) {
        self.value = value
    }
    func increment() {
        self.value = self.value + 1
    }
    func get() -> Int {
        return self.value
    }
}

func main() {
    let c = Counter(value: 0)
    c.increment()
    c.increment()
    print(c.get())
}

