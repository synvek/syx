func main() {
    let a = __syx_plugin_faer_from([1.0, 2.0, 3.0, 4.0], 2, 2)
    let b = __syx_plugin_faer_from([10.0, 20.0, 30.0, 40.0], 2, 2)
    let s = __syx_plugin_faer_add(a, b)
    let d = __syx_plugin_faer_sub(a, b)
    let h = __syx_plugin_faer_hadamard(a, b)
    let sv = __syx_plugin_faer_to(s)
    let dv = __syx_plugin_faer_to(d)
    let hv = __syx_plugin_faer_to(h)
    print(sv[0])
    print(sv[1])
    print(sv[2])
    print(sv[3])
    print(dv[0])
    print(dv[1])
    print(dv[2])
    print(dv[3])
    print(hv[0])
    print(hv[1])
    print(hv[2])
    print(hv[3])
    __syx_plugin_v2probe_drop(a)
    __syx_plugin_v2probe_drop(b)
    __syx_plugin_v2probe_drop(s)
    __syx_plugin_v2probe_drop(d)
    __syx_plugin_v2probe_drop(h)
}
