// R-43 hard nail: type-erased Animal receiver (factory), not only
// `let a: Animal = Dog()` which can retain concrete Dog for static Call.
class Animal {
    func speak() {
        print("animal")
    }
}

class Dog: Animal {
    override func speak() {
        print("woof")
    }
}

func make() -> Animal {
    return Dog()
}

func main() {
    let a: Animal = make()
    a.speak()
}
