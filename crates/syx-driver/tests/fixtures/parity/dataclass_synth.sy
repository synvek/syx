import Hasher

data class Point(x: Int, y: Int)

func main() {
    let p = Point(3, 4)
    let q = Point(3, 4)
    let r = p.copy()
    print(p == q)
    print(p == r)
    print(p.description)
    var h = Hasher.newHasher()
    p.hash(into: h)
    let h1 = Hasher.finalize(h)
    var h2 = Hasher.newHasher()
    q.hash(into: h2)
    let h2v = Hasher.finalize(h2)
    print(h1 == h2v)
}

