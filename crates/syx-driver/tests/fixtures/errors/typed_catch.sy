// SA-2-02: thrown values must be String or conform to Error (not bare data class).
enum AppError: Error {
    case boom(code: Int, message: String)
}

func fail() throws {
    throw AppError.boom(code: 42, message: "boom")
}

func main() {
    do {
        fail()
    } catch (err: AppError) {
        print(err.message)
        print(err.code)
    }
}
