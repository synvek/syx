func main() {
    let v: SIMD4<Int32> = SIMD4.fromArray([1i32, 2i32, 3i32, 4i32])
    let w: SIMD4<Int32> = SIMD4.fromArray([10i32, 20i32, 30i32, 40i32])
    let s = v + w
    print(SIMD4.reduceAdd(s))
    let e = v == w
    print(SIMD4.reduceAdd(e))
    let l = v < w
    print(SIMD4.reduceAdd(l))
    let q = w / v
    print(SIMD4.reduceAdd(q))
    let sh = SIMD4.shuffleReverse(v)
    print(SIMD4.reduceAdd(sh))
}

