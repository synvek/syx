func bucket(n: Int) -> String {
    switch n {
    case 1...3:
        return "small"
    default:
        return "other"
    }
}

func main() {
    print((1...5).contains(5))
    print((1...5).contains(6))
    print((1...5).contains(1))
    var sum = 0
    for i in 1...3 {
        sum = sum + i
    }
    print(sum)
    print(bucket(n: 3))
    print(bucket(n: 4))
}

