// S1-I7: T: A & B composite protocol constraint (parse + check).
protocol A { func a() }
protocol B { func b() }

func use<T: A & B>(_ x: T) {
    x.a()
    x.b()
}

class C: A, B {
    func a() { print("a") }
    func b() { print("b") }
}

func main() {
    // Instantiation thin: call via protocol methods on concrete class.
    let c = C()
    c.a()
    c.b()
}
