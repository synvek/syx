// R-34 negative: non-conforming element must S014 under Array<Shape>.
protocol Shape {
    func area() -> Double
}

class Circle: Shape {
    var r: Double
    init(r: Double) { self.r = r }
    func area() -> Double { return self.r }
}

class Box {
    var n: Int
    init(n: Int) { self.n = n }
}

func main() {
    let shapes: Array<Shape> = [Circle(r: 1.0), Box(n: 1)]
    print(0)
}
