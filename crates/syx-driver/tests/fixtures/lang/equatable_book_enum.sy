// S1-I4 / S1-05: `@Equatable` no-payload enum + thin Equatable witness.
@Equatable
enum Status {
    case ok
    case err
}

func valuesEqual<T: Equatable>(a: T, b: T) -> Bool {
    return a == b
}

func main() {
    print(Status.ok == Status.err)
    print(valuesEqual(a: 1, b: 1))
    print(valuesEqual(a: "x", b: "y"))
}
