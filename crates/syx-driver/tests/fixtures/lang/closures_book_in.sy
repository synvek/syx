// S1-I4: book-style `{ x in }` / `(Int) -> Int` / HOF call of closure value.
let inc = { x in x + 1 }

func apply(_ f: (Int) -> Int, _ x: Int) -> Int {
    return f(x)
}

func main() {
    print(inc(41))
    let f: (Int) -> Int = { x in x * 2 }
    print(f(2))
    let sum = { (a, b) in a + b }
    print(sum(1, 2))
    print(apply({ x in x * 2 }, 3))
}
