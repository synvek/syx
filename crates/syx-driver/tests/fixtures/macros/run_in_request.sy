import Di

var __syx_req_hits = 0

@Scope("request")
@Service
class ReqSvc {
    init() {
        __syx_req_hits = __syx_req_hits + 1
    }
}

func handleReq() {
    let _a = Di.resolve("ReqSvc")
}

func main() {
    Di.runInRequest("handleReq")
    Di.runInRequest("handleReq")
    print(__syx_req_hits == 2)
}

