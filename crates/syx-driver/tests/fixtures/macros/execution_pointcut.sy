import Di

@Service
class Greeter {
    init() {
    }
    @Pointcut("execution(* Greeter.greet(..))")
    @Around("execution(* Greeter.greet(..))")
    func greet(name: String) -> String {
        print("__body__:greet")
        return "hello " + name
    }
}

@Service
class WildcardProbe {
    init() {
    }
    @Pointcut("execution(* WildcardProbe.*(..))")
    @Around("execution(* WildcardProbe.*(..))")
    func tick() -> String {
        print("__body__:tick")
        return "wildcard-ok"
    }
}

func main() {
    let g = Di.resolve("Greeter")
    print(g.greet(name: "world"))
    let w = Di.resolve("WildcardProbe")
    print(w.tick())
}

