// =============================================================================
// tutorial/14-inheritance.sy
// Corresponds to Chapter 14 "Inheritance" of the *SYX Language Guide*
//
// Runnable demos: single inheritance, override, vtable polymorphism, is / as?.
// note: super.init currently fails to resolve -> subclasses use default fields and do not call super.init.
// note: final class, protocol inheritance, and mixed Array<Animal> subclasses are limited in this runtime.
// =============================================================================

class Animal {
    var name: String = "anon"
    var age: Int = 0
    func speak() {
        print("...")
    }
}

class Dog: Animal {
    var breed: String = "unknown"
    override func speak() {
        print("woof")
    }
    func fetch() {
        print(self.name)
    }
}

class Puppy: Dog {
    override func speak() {
        print("yip")
    }
}

func basicInheritance() {
    let d = Dog()
    d.name = "Rex"
    d.age = 3
    d.breed = "Labrador"
    d.speak()
    d.fetch()
    print(d.breed)

    let p = Puppy()
    p.name = "Buddy"
    p.speak()
}

func polymorphicDemo() {
    let a1: Animal = Dog()
    let a2: Animal = Puppy()
    let a3: Animal = Animal()
    a1.speak()
    a2.speak()
    a3.speak()
}

func typeCheckDemo() {
    let a: Animal = Dog()
    print(a is Dog)
    print(a is Puppy)
    print(a is Animal)

    let d = a as? Dog
    print(d is Dog)

    let p = a as? Puppy
    print(p is Puppy)
}

// Multi-level override chain
class A2 {
    func f() {
        print("A")
    }
}
class B2: A2 {
    override func f() {
        print("B")
    }
}
class C2: B2 {
    override func f() {
        print("C")
    }
}

func overrideChain() {
    let c = C2()
    c.f()
    let asA: A2 = C2()
    asA.f()
}

// Vehicle example: subclass has its own fields + defaults (no super.init)
class Vehicle {
    var wheels: Int = 0
}
class Car: Vehicle {
    var brand: String = "none"
}

func vehicleDemo() {
    let c = Car()
    c.wheels = 4
    c.brand = "Toyota"
    print(c.wheels)
    print(c.brand)
}

func main() {
    basicInheritance()
    polymorphicDemo()
    typeCheckDemo()
    overrideChain()
    vehicleDemo()
}
