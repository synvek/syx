// =============================================================================
// tutorial/03-basic-operators.sy
// Corresponds to Chapter 3 "Basic Operators" of the *SYX Language Guide*
//
// Language features covered in this chapter:
//   - Arithmetic + - * / %
//   - Comparison == != === !== < <= > >=
//   - Logical && || !
//   - Nil-coalescing ?? / optional chaining ?. / force-unwrap !
//   - Compound assignment = += -= *= /= %=
//   - Ranges 0..<n / 1...n
//   - Unary prefix (-, !, try, await, &)
//   - Literal type rules + underscores
//   - Intro to custom operators (see Chapter 30)
// =============================================================================

func demo_arithmetic() {
    let a = 10 + 3
    let b = 10 - 3
    let c = 10 * 3
    let d = 10 / 3
    let m = 10 % 3
    let neg = -a
    print("a=\(a) b=\(b) c=\(c) d=\(d) m=\(m) neg=\(neg)")
}

func demo_compare_logic() {
    let eq1 = (1 == 1)
    let eq2 = ("a" == "a")
    let lt = (1 < 2)
    let ge = (3 >= 2)
    let ne = (1 != 2)
    print("eq1=\(eq1) eq2=\(eq2) lt=\(lt) ge=\(ge) ne=\(ne)")

    let flag = true
    let and_ = flag && (1 + 1 == 2)
    let or_ = !flag || (1 == 1)
    let not_ = !flag
    print("and_=\(and_) or_=\(or_) not_=\(not_)")
}

func demo_optional_ops() {
    // note: Optional chaining ?.count / force-unwrap ! on String? is unstable on the CLI path; ?? is used to demonstrate nil-coalescing.
    let s: String? = "hello"
    let ns: String? = nil
    print(s ?? "missing")
    print(ns ?? "missing")
    let n: Int? = nil
    print(n ?? 0)
    let m: Int? = 5
    print(m ?? 0)
}

func demo_compound_and_range() {
    var x = 1
    x += 2
    x -= 1
    x *= 2
    x /= 2
    x %= 3
    print("x=\(x)")

    print((1..<10).contains(5))
    print((1..<10).contains(10))
    print((1...10).contains(10))
    print((1...10).contains(11))

    var sum = 0
    for n in 0..<5 {
        sum += n
    }
    print(sum)

    var prod = 1
    for m in 1...4 {
        prod *= m
    }
    print(prod)
}

func demo_precedence() {
    let expr = 1 + 2 * 3
    let paren = (1 + 2) * 3
    print("expr=\(expr) paren=\(paren)")
    // note: Custom operators (infix operator |> etc.) are covered in Chapter 30; not demonstrated here.
}

func main() {
    print("chapter 03: basic operators")
    demo_arithmetic()
    demo_compare_logic()
    demo_optional_ops()
    demo_compound_and_range()
    demo_precedence()
}
