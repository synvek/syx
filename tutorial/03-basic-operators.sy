// =============================================================================
// tutorial/03-basic-operators.sy
// 对应《SYX 语言指南》第 3 章「基本运算符」
//
// 本章涉及语言特性：
//   - 算术 + - * / %、一元负、正
//   - 比较 == != === !== < <= > >=
//   - 逻辑 && || !
//   - 空合并 ??、可选链 ?.、强制解包 !
//   - 复合赋值 = += -= *= /= %=
//   - 范围 0..<n / 1...n
//   - 一元前缀（-, !, try, await, &）
//   - 字面量类型规则 + 下划线
//   - 自定义运算符入门（详见第 30 章）
// =============================================================================

func demo_arithmetic() {
    let a = 10 + 3
    let b = 10 - 3
    let c = 10 * 3
    let d = 10 / 3
    let m = 10 % 3
    let neg = -a
    print("a=\(a) b=\(b) c=\(c) d=\(d) m=\(m) neg=\(neg)")
}

func demo_compare_logic() {
    let eq1 = (1 == 1)
    let eq2 = ("a" == "a")
    let lt = (1 < 2)
    let ge = (3 >= 2)
    let ne = (1 != 2)
    print("eq1=\(eq1) eq2=\(eq2) lt=\(lt) ge=\(ge) ne=\(ne)")

    let flag = true
    let and_ = flag && (1 + 1 == 2)
    let or_ = !flag || (1 == 1)
    let not_ = !flag
    print("and_=\(and_) or_=\(or_) not_=\(not_)")
}

func demo_optional_ops() {
    // note: 可选链 ?.count / 强制解包 ! 在 CLI 路径上对 String? 不稳定；用 ?? 演示空合并。
    let s: String? = "hello"
    let ns: String? = nil
    print(s ?? "missing")
    print(ns ?? "missing")
    let n: Int? = nil
    print(n ?? 0)
    let m: Int? = 5
    print(m ?? 0)
}

func demo_compound_and_range() {
    var x = 1
    x += 2
    x -= 1
    x *= 2
    x /= 2
    x %= 3
    print("x=\(x)")

    print((1..<10).contains(5))
    print((1..<10).contains(10))
    print((1...10).contains(10))
    print((1...10).contains(11))

    var sum = 0
    for n in 0..<5 {
        sum += n
    }
    print(sum)

    var prod = 1
    for m in 1...4 {
        prod *= m
    }
    print(prod)
}

func demo_precedence() {
    let expr = 1 + 2 * 3
    let paren = (1 + 2) * 3
    print("expr=\(expr) paren=\(paren)")
    // note: 自定义运算符（infix operator |> 等）详见第 30 章，本教程不演示。
}

func main() {
    print("chapter 03: basic operators")
    demo_arithmetic()
    demo_compare_logic()
    demo_optional_ops()
    demo_compound_and_range()
    demo_precedence()
}
