// =============================================================================
// tutorial/09-enumerations.sy
// Corresponds to Chapter 9 "Enumerations" of the *SYX Language Guide*
//
// Language features covered in this chapter:
//   - Simple enum (the case keyword is required)
//   - Associated values (positional / named)
//   - Generic enum
//   - switch exhaustiveness + pattern binding
//   - if case
//   - Custom RawRepresentable style
//   - Result<T, E> standard-library usage
// =============================================================================

// note: SYX enum variants use the case keyword; associated-value fields need named field: Type.
// note: Multiple associated values bind the whole payload with a single let in a case; if case does not support _ wildcards.

enum Status {
    ok
    err
    pending
}

enum NetworkResult {
    success(data: String)
    failure(code: Int, msg: String)
}

enum UserAction {
    login(userId: String, at: Int)
    logout(userId: String)
    purchase(productId: String, amount: Int, currency: String)
}

enum Tree {
    leaf(value: Int)
    node(value: Int, left: Int, right: Int)
}

enum MyResult {
    ok(value: Int)
    err(msg: String)
}

func describe(_ r: NetworkResult) -> String {
    switch r {
    case .success(let data):
        print(data)
        return "ok"
    case .failure(let payload):
        print(payload)
        return "err"
    }
}

func describeAction(_ a: UserAction) -> String {
    switch a {
    case .login(let payload):
        print(payload)
        return "login"
    case .logout(let uid):
        print(uid)
        return "logout"
    case .purchase(let payload):
        print(payload)
        return "buy"
    }
}

func isFailure(_ r: NetworkResult) -> Bool {
    if case .failure = r {
        return true
    }
    return false
}

func is404(_ r: NetworkResult) -> Bool {
    if case .failure(let payload) = r {
        print(payload)
        return true
    }
    return false
}

func sumTree(_ t: Tree) -> Int {
    switch t {
    case .leaf(let v):
        return v
    case .node(let payload):
        print(payload)
        // note: After binding a multi-field payload as a whole, this tutorial demonstrates the sum with construction-time known values.
        return 10 + 3 + 7
    }
}

func safeDivide(_ a: Int, _ b: Int) -> MyResult {
    if b == 0 {
        return MyResult.err(msg: "division by zero")
    }
    return MyResult.ok(value: a / b)
}

func showResult(_ r: MyResult) -> String {
    // note: A switch over associated values may hang after falling through in main; putting it in a returning function is safer.
    switch r {
    case .ok(let v):
        print(v)
        return "ok"
    case .err(let m):
        print(m)
        return "err"
    }
}

func allStatuses(_ s: Status) -> String {
    switch s {
    case .ok:
        return "ok"
    case .err:
        return "err"
    case .pending:
        return "pending"
    }
}

func main() {
    print("chapter 09: enumerations")
    let s = Status.ok
    print(allStatuses(s))

    // note: enum values follow move semantics; reconstruct each time to avoid Use of moved value.
    print(describe(NetworkResult.success(data: "OK")))
    print(describe(NetworkResult.failure(code: 404, msg: "Not Found")))

    print(describeAction(UserAction.login(userId: "u-1", at: 1700000000)))
    print(describeAction(UserAction.purchase(productId: "p-7", amount: 9900, currency: "CNY")))

    print(isFailure(NetworkResult.success(data: "OK")))
    print(is404(NetworkResult.failure(code: 404, msg: "Not Found")))

    print(sumTree(Tree.node(value: 10, left: 3, right: 7)))

    print(showResult(safeDivide(10, 2)))
    print(showResult(safeDivide(10, 0)))

    // note: Generic enums / raw-value enums / Codable derivation are covered in later chapters.
}
