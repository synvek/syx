// =============================================================================
// tutorial/08-closures.sy
// Corresponds to Chapter 8 "Closures" of the *SYX Language Guide*
//
// Language features covered in this chapter:
//   - Closure expression { params in body }
//   - Shorthand $0, $1 (partially implemented)
//   - Closures as parameters / return values
//   - Closure capture
//   - Trailing closures
//   - HOF: map / filter / reduce / sort / sorted(by:)
//   - Function reference
// =============================================================================

func applyMapped(_ x: Int, f: (Int) -> Int) -> Int {
    let arr = [x]
    let out = arr.map(f)
    return out[0]
}

func demo_basic() {
    // note: Closure parameters must be written as `(x)` / `(x: Int)`; a bare `{ x in ... }` is parsed as a dictionary.
    let r1 = applyMapped(5, f: { (x: Int) in return x * x })
    print(r1)

    let r2 = applyMapped(10, f: { (x: Int) in return x + 100 })
    print(r2)
}

func demo_capture_via_hof() {
    // note: A returned closure value should not be called by name directly; use map to show capture.
    let base = 10
    let nums = [1, 2, 3]
    let mapped = nums.map({ (x: Int) in return x + base })
    print(mapped)

    let scale = 2
    let offset = 1
    let mapped2 = nums.map({ (x: Int) in return x * scale + offset })
    print(mapped2)
}

func demo_hof() {
    let nums = [5, 1, 4, 2, 3]

    let sq = nums.map({ (x: Int) in return x * x })
    print(sq)

    let big = nums.filter({ (x: Int) in return x > 2 })
    print(big)

    // note: reduce needs the initial-value form reduce(0, closure).
    let s = nums.reduce(0, { (a: Int, b: Int) in return a + b })
    print(s)

    let bigSq = nums
        .filter({ (x: Int) in return x > 1 })
        .map({ (x: Int) in return x * x })
        .reduce(0, { (a: Int, b: Int) in return a + b })
    print(bigSq)

    let asc = nums.sorted()
    print(asc)

    // note: sorted(by:) / sortBy / $0 shorthand / trailing closures / operator references (+) are not demonstrated here.
}

func demo_predicate_via_filter() {
    let nums = [1, 5, 10, 50]
    let threshold = 5
    let gt = nums.filter({ (x: Int) in return x > threshold })
    print(gt)
}

func main() {
    print("chapter 08: closures")
    demo_basic()
    demo_capture_via_hof()
    demo_hof()
    demo_predicate_via_filter()
}
