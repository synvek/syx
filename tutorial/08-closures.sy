// =============================================================================
// tutorial/08-closures.sy
// 对应《SYX 语言指南》第 8 章「闭包」
//
// 本章涉及语言特性：
//   - 闭包表达式 { params in body }
//   - 简写 $0, $1（部分实现）
//   - 闭包作为参数 / 返回值
//   - 闭包捕获
//   - 尾随闭包
//   - HOF：map / filter / reduce / sort / sorted(by:)
//   - 函数引用 (function reference)
// =============================================================================

func applyMapped(_ x: Int, f: (Int) -> Int) -> Int {
    let arr = [x]
    let out = arr.map(f)
    return out[0]
}

func demo_basic() {
    // note: 闭包参数必须写 `(x)` / `(x: Int)`；裸 `{ x in ... }` 会被当成字典。
    let r1 = applyMapped(5, f: { (x: Int) in return x * x })
    print(r1)

    let r2 = applyMapped(10, f: { (x: Int) in return x + 100 })
    print(r2)
}

func demo_capture_via_hof() {
    // note: 返回的闭包值不宜按名直接调用；用 map 展示捕获。
    let base = 10
    let nums = [1, 2, 3]
    let mapped = nums.map({ (x: Int) in return x + base })
    print(mapped)

    let scale = 2
    let offset = 1
    let mapped2 = nums.map({ (x: Int) in return x * scale + offset })
    print(mapped2)
}

func demo_hof() {
    let nums = [5, 1, 4, 2, 3]

    let sq = nums.map({ (x: Int) in return x * x })
    print(sq)

    let big = nums.filter({ (x: Int) in return x > 2 })
    print(big)

    // note: reduce 需要初始值形态 reduce(0, closure)。
    let s = nums.reduce(0, { (a: Int, b: Int) in return a + b })
    print(s)

    let bigSq = nums
        .filter({ (x: Int) in return x > 1 })
        .map({ (x: Int) in return x * x })
        .reduce(0, { (a: Int, b: Int) in return a + b })
    print(bigSq)

    let asc = nums.sorted()
    print(asc)

    // note: sorted(by:) / sortBy / $0 简写 / 尾随闭包 / 运算符引用(+) 本教程不演示。
}

func demo_predicate_via_filter() {
    let nums = [1, 5, 10, 50]
    let threshold = 5
    let gt = nums.filter({ (x: Int) in return x > threshold })
    print(gt)
}

func main() {
    print("chapter 08: closures")
    demo_basic()
    demo_capture_via_hof()
    demo_hof()
    demo_predicate_via_filter()
}
