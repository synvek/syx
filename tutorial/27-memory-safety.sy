// =============================================================================
// tutorial/27-memory-safety.sy
// Memory safety concepts via class refs and local mutation (no &mut borrow).
// note: `&T` / `&mut T` borrow syntax is dropped if it fails — use simple refs.
// =============================================================================

class Cell {
    var value: Int
    init(value: Int) { self.value = value }
    func read() -> Int { return self.value }
    func write(_ v: Int) { self.value = v }
}

func sharedRefs() {
    let a = Cell(value: 10)
    let b = a
    print(a.read())
    b.write(20)
    print(a.read())
    print(a === b)
}

func localMutation() {
    var n = 10
    n = n + 1
    print(n)
}

func closureCapture() {
    // Prefer HOF map over capturing mutable locals in standalone closures
    let nums = [10]
    let bumped = nums.map({ (x) in return x + 1 })
    print(bumped)
}

func arraySafety() {
    var arr: Array<Int> = [1, 2, 3]
    arr.append(4)
    print(arr.count)
    print(arr[0])
}

data class Point3D(x: Int, y: Int, z: Int)

func fieldDemo() {
    let p = Point3D(x: 1, y: 2, z: 3)
    print(p.x)
    print(p.y)
    print(p.z)
}

func forInDemo() {
    let arr = [1, 2, 3]
    for x in arr {
        print(x)
    }
}

// Borrow conflict matrix (conceptual):
//   no borrow     → read/write OK
//   shared refs   → many readers via class ARC
//   exclusive mut → mutate through one owner (Cell / local var)

func main() {
    sharedRefs()
    localMutation()
    closureCapture()
    arraySafety()
    fieldDemo()
    forInDemo()
    print("memory-safety demo done")
}
