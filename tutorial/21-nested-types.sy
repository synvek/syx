// =============================================================================
// tutorial/21-nested-types.sy
// Nested types: Outer.Inner paths, multi-level nesting, flatten naming.
// note: nested enum construction is limited — use top-level enums when needed.
// note: Swift-style struct { var x } is unsupported — use class / data class.
// =============================================================================

// 1) Single-level nested class
class Outer {
    class Inner {
        var value: Int
        init(value: Int) { self.value = value }
        func describe() -> String { return "Outer.Inner(\(self.value))" }
    }
}

// 2) Multi-level nesting
class App {
    class UI {
        class View {
            var frame: String
            init(frame: String) { self.frame = frame }
            func describe() -> String { return "App.UI.View(\(self.frame))" }
        }
    }
    class Model {
        class User {
            var name: String
            init(name: String) { self.name = name }
            func describe() -> String { return "App.Model.User(\(self.name))" }
        }
    }
}

// 3) Top-level enum used by a class (preferred over nested enum)
enum GameState {
    menu
    playing
    paused
    gameOver(score: Int)
}

func describeState(_ s: GameState) -> String {
    switch s {
    case .menu: return "menu"
    case .playing: return "playing"
    case .paused: return "paused"
    case .gameOver(let score): return "game over \(score)"
    }
}

class Game {
    var state: GameState
    init() { self.state = GameState.menu }
    func transition(to s: GameState) { self.state = s }
    func describe() -> String { return describeState(self.state) }
}

// 4) Nested final class
class ServiceContainer {
    final class Logger {
        var prefix: String
        init(prefix: String) { self.prefix = prefix }
        func log(_ s: String) { print("\(self.prefix) \(s)") }
    }
}

// 5) Flatten naming (recommended when nesting is awkward)
data class ColorRGB(r: Int, g: Int, b: Int)
data class ColorHSV(h: Double, s: Double, v: Double)

class ColorPalette {
    func rgb(_ r: Int, _ g: Int, _ b: Int) -> ColorRGB {
        return ColorRGB(r: r, g: g, b: b)
    }
    func hsv(_ h: Double, _ s: Double, _ v: Double) -> ColorHSV {
        return ColorHSV(h: h, s: s, v: v)
    }
}

// 6) Nested type as parameter / return
func makeInner() -> Outer.Inner {
    return Outer.Inner(value: 7)
}

func useInner(_ i: Outer.Inner) {
    print(i.describe())
}

func main() {
    let i = Outer.Inner(value: 7)
    print(i.describe())
    useInner(makeInner())

    let v = App.UI.View(frame: "0,0,100,100")
    print(v.describe())
    let u = App.Model.User(name: "anon")
    print(u.describe())

    let g = Game()
    print(g.describe())
    g.transition(to: GameState.playing)
    print(g.describe())
    // note: associated-value enum stored on class fields can be flaky —
    // demonstrate gameOver via a free value + describeState.
    print(describeState(GameState.gameOver(score: 100)))

    let logger = ServiceContainer.Logger(prefix: "[log]")
    logger.log("hello")

    let pal = ColorPalette()
    let c = pal.rgb(255, 0, 0)
    print("rgb=\(c.r),\(c.g),\(c.b)")
}
