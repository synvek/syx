// =============================================================================
// tutorial/23-protocols.sy
// Protocols: default method bodies + class conformance via `: Proto`.
// note: associatedtype / any P / protocol composition may be limited —
//       keep demos to witness-style methods (see protocol_witness.sy).
// =============================================================================

protocol Named {
    func describe() -> String {
        return "?"
    }
}

class User23: Named {
    var name: String
    init(name: String) { self.name = name }
    func describe() -> String { return "User(\(self.name))" }
}

class Product23: Named {
    var name: String
    var price: Int
    init(name: String, price: Int) {
        self.name = name
        self.price = price
    }
    func describe() -> String {
        return "Product(\(self.name), \(self.price))"
    }
}

protocol CounterProto {
    func next() -> Int {
        return 0
    }
}

class Counter: CounterProto {
    var value: Int
    init(value: Int) { self.value = value }
    func next() -> Int {
        self.value = self.value + 1
        return self.value
    }
}

protocol Shape23 {
    func area() -> Int {
        return 0
    }
}

class Square23: Shape23 {
    var side: Int
    init(side: Int) { self.side = side }
    func area() -> Int { return self.side * self.side }
}

class Circle23: Shape23 {
    var r: Int
    init(r: Int) { self.r = r }
    func area() -> Int { return 3 * self.r * self.r }
}

protocol Factory {
    func tag() -> String {
        return "factory"
    }
}

class Widget: Factory {
    var id: Int
    init(id: Int) { self.id = id }
    func tag() -> String { return "Widget(\(self.id))" }
}

func main() {
    print(User23(name: "Alice").describe())
    print(Product23(name: "Book", price: 10).describe())

    let c = Counter(value: 0)
    print(c.next())
    print(c.next())

    print("square=\(Square23(side: 2).area())")
    print("circle=\(Circle23(r: 1).area())")

    print(Widget(id: 7).tag())

    // Witness-style dispatch via concrete receivers
    print(User23(name: "Bob").describe())
    print(Product23(name: "Pen", price: 2).describe())
}
