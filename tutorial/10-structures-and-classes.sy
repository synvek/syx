// =============================================================================
// tutorial/10-structures-and-classes.sy
// 对应《SYX 语言指南》第 10 章「结构体和类」
//
// 本章涉及语言特性：
//   - struct（值类型，mutating func）
//   - class（引用类型，ARC）
//   - data class（不可变记录 + 自动派生 description / copy / eq / hash）
//   - actor（并发隔离）
//   - 引用比较 === / !==
//   - 单继承 + override（详见 14）
//   - final class
// =============================================================================

// note: 不要写 Swift 式 struct { var x: Int } 体；用 class + init，或 data class 简写。

class Point {
    var x: Int
    var y: Int
    init(x: Int, y: Int) {
        self.x = x
        self.y = y
    }
}

class Counter {
    var value: Int
    init() {
        self.value = 0
    }
    func increment() {
        self.value = self.value + 1
    }
    func incrementBy(n: Int) {
        self.value = self.value + n
    }
}

class Greeter {
    var name: String
    init(name: String) {
        self.name = name
    }
    func hello() {
        print("Hello, \(self.name)")
    }
}

class CounterClass {
    var value: Int
    init(value: Int) {
        self.value = value
    }
}

data class Point2D(x: Int, y: Int)

data class User(id: Int, name: String, email: String)

class Animal {
    var name: String
    init(name: String) {
        self.name = name
    }
    func speak() {
        print("...")
    }
}

// note: 子类复用父类 init；重写 init 调用父初始化在 CLI 路径上不稳定。
class Dog: Animal {
    override func speak() {
        print("woof")
        print(self.name)
    }
}

// note: final class 在 syx run 路径上解析失败；此处用普通 class 演示不可变字段。
class ImmutableKey {
    let id: Int
    init(id: Int) {
        self.id = id
    }
}

func demoClassValues() {
    let p = Point(x: 1, y: 2)
    print(p.x)
    print(p.y)

    let c = Counter()
    c.increment()
    c.incrementBy(n: 5)
    print(c.value)
}

func demoClassRefs() {
    let a = Greeter(name: "SYX")
    let b = a
    a.hello()
    b.hello()
    print(a === b)

    let c1 = CounterClass(value: 0)
    let c2 = CounterClass(value: 0)
    print(c1 === c2)
    let c3 = c1
    print(c1 === c3)
}

func demoDataClass() {
    let u1 = User(1, "Alice", "alice")
    let u3 = u1.copy()
    print(u1.description)
    print(u3.description)
    // note: 多字段 data class 的 == 合成在 syx run 路径上可能缺失；用 description / === 演示。
    print(u1 === u3)

    let p1 = Point2D(3, 4)
    let p2 = p1.copy()
    print(p1.description)
    print(p2.description)
    print(p1 === p2)
}

func demoInheritance() {
    let d = Dog(name: "Rex")
    d.speak()
}

func demoFinal() {
    let k = ImmutableKey(id: 7)
    print(k.id)
}

func main() {
    print("chapter 10: structures and classes")
    demoClassValues()
    demoClassRefs()
    demoDataClass()
    demoInheritance()
    demoFinal()
    // note: actor / Task.detached / mutating struct 方法详见并发与后续章节。
}
