// =============================================================================
// tutorial/10-structures-and-classes.sy
// 对应《SYX 语言指南》第 10 章「结构体和类」
//
// 本章涉及语言特性：
//   - struct（值类型，mutating func）
//   - class（引用类型，ARC）
//   - data class（不可变记录 + 自动派生 description / copy / eq / hash）
//   - actor（并发隔离）
//   - 引用比较 === / !==
//   - 单继承 + override（详见 14）
//   - final class
// =============================================================================

// 1) struct — 值类型
struct Point {
    var x: Int
    var y: Int
}

struct Counter {
    var value: Int = 0
    mutating func increment() { value = value + 1 }
    mutating func increment(by n: Int) { value += n }
}

func demoStruct() {
    let p = Point(x: 1, y: 2)
    print("p=(\(p.x), \(p.y))")                       // 1, 2

    var c = Counter()
    c.increment()
    c.increment(by: 5)
    print("c.value=\(c.value)")                      // 6
}

// 2) class — 引用类型 + ARC
class Greeter {
    var name: String
    init(name: String) { self.name = name }
    func hello() { print("Hello, \(self.name)") }
}

class CounterClass {
    var value: Int = 0
    init() {}
    init(value: Int) { self.value = value }
    func describe() -> String { return "Counter(\(self.value))" }
}

func demoClass() {
    let a = Greeter(name: "SYX")
    let b = a                                          // 引用复制，refcount +1
    a.hello()
    b.hello()
    print("a === b = \(a === b)")                      // true（同一对象）
}

// 3) data class — 自动派生 description / copy / == / hash
data class User {
    let id: Int
    let name: String
    let email: String
}

data class Point2D(x: Int, y: Int)                     // 简写形式

func demoDataClass() {
    let u1 = User(id: 1, name: "Alice", email: "a@x.com")
    let u2 = User(id: 1, name: "Alice", email: "a@x.com")
    let u3 = u1.copy()                                 // 自动 copy
    print("u1=\(u1.description())")                    // User(id:1, name:Alice, ...)
    print("u1 == u2 = \(u1 == u2)")                    // true（结构相等）
    print("u1 === u3 = \(u1 === u3)")                  // false（不同对象）

    let p1 = Point2D(x: 3, y: 4)
    let p2 = Point2D(x: 3, y: 4)
    print("p1 == p2 = \(p1 == p2)")                    // true
}

// 4) actor — 并发隔离
actor BankAccount {
    var balance: Int
    init(balance: Int) { self.balance = balance }
    func deposit(_ amount: Int) { self.balance += amount }
    func withdraw(_ amount: Int) -> Bool {
        if self.balance >= amount {
            self.balance -= amount
            return true
        }
        return false
    }
    func currentBalance() -> Int { return self.balance }
}

async func demoActor() {
    let acct = BankAccount(balance: 100)
    await acct.deposit(50)
    let ok = await acct.withdraw(30)
    let bal = await acct.currentBalance()
    print("withdraw=\(ok) balance=\(bal)")             // true 120
}

// 5) 单继承 + override
class Animal {
    var name: String
    init(name: String) { self.name = name }
    func speak() { print("...") }
}

class Dog: Animal {
    init(name: String) { super.init(name: name) }
    override func speak() { print("woof, I'm \(self.name)") }
}

class Puppy: Dog {
    override func speak() { super.speak(); print("(small)") }
}

func demoInheritance() {
    let d = Dog(name: "Rex")
    d.speak()                                          // "woof, I'm Rex"
    let p = Puppy(name: "Buddy")
    p.speak()                                          // 父类 speak + "(small)"
}

// 6) final class — 禁止子类化
final class ImmutableKey {
    let id: Int
    init(id: Int) { self.id = id }
}
// class SubKey: ImmutableKey {}  ← ❌ 编译错误：cannot inherit from final class

// 7) class identity === / !==
func identityDemo() {
    let a = CounterClass()
    let b = CounterClass()
    print("a === b = \(a === b)")                      // false
    let c = a
    print("a === c = \(a === c)")                      // true
}

// 8) struct vs class 选择
//
// - struct：值类型；语义简单；适合小型数据聚合（Point、Size、Money）
// - class：引用类型；需要身份（==）或共享可变状态；适合大对象
// - data class：不可变记录；自动 == / hash / description；适合 DTO / 值对象
// - actor：并发隔离的引用类型；适合多线程共享状态

// 9) mutating 限制
struct Stack {
    var items: Array<Int> = []
    mutating func push(_ v: Int) { items.append(v) }
    // func peek() -> Int { return items[items.count - 1] }  // 非 mutating，只读
}
func mutatingDemo() {
    var s = Stack()
    s.push(1)
    s.push(2)
    // let cs = Stack(); cs.push(1)   ← ❌ S020: cannot mutate through let
}

func main() {
    demoStruct()
    demoClass()
    demoDataClass()
    identityDemo()
    demoInheritance()
    mutatingDemo()
    // 启动一个 async 任务跑 actor demo
    Task.detached { await demoActor() }
}
