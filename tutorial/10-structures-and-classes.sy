// =============================================================================
// tutorial/10-structures-and-classes.sy
// Corresponds to Chapter 10 "Structures and Classes" of the *SYX Language Guide*
//
// Language features covered in this chapter:
//   - struct (value type, mutating func)
//   - class (reference type, ARC)
//   - data class (immutable record + auto-derived description / copy / eq / hash)
//   - actor (concurrency isolation)
//   - Reference comparison === / !==
//   - Single inheritance + override (see 14)
//   - final class
// =============================================================================

// note: Do not write a Swift-style `struct { var x: Int }` body; use class + init, or the data class shorthand.

class Point {
    var x: Int
    var y: Int
    init(x: Int, y: Int) {
        self.x = x
        self.y = y
    }
}

class Counter {
    var value: Int
    init() {
        self.value = 0
    }
    func increment() {
        self.value = self.value + 1
    }
    func incrementBy(n: Int) {
        self.value = self.value + n
    }
}

class Greeter {
    var name: String
    init(name: String) {
        self.name = name
    }
    func hello() {
        print("Hello, \(self.name)")
    }
}

class CounterClass {
    var value: Int
    init(value: Int) {
        self.value = value
    }
}

data class Point2D(x: Int, y: Int)

data class User(id: Int, name: String, email: String)

class Animal {
    var name: String
    init(name: String) {
        self.name = name
    }
    func speak() {
        print("...")
    }
}

// note: Subclasses reuse the parent init; overriding init to call the parent initializer is unstable on the CLI path.
class Dog: Animal {
    override func speak() {
        print("woof")
        print(self.name)
    }
}

// note: final class fails to resolve on the syx run path; a plain class with immutable fields is used here.
class ImmutableKey {
    let id: Int
    init(id: Int) {
        self.id = id
    }
}

func demoClassValues() {
    let p = Point(x: 1, y: 2)
    print(p.x)
    print(p.y)

    let c = Counter()
    c.increment()
    c.incrementBy(n: 5)
    print(c.value)
}

func demoClassRefs() {
    let a = Greeter(name: "SYX")
    let b = a
    a.hello()
    b.hello()
    print(a === b)

    let c1 = CounterClass(value: 0)
    let c2 = CounterClass(value: 0)
    print(c1 === c2)
    let c3 = c1
    print(c1 === c3)
}

func demoDataClass() {
    let u1 = User(1, "Alice", "alice")
    let u3 = u1.copy()
    print(u1.description)
    print(u3.description)
    // note: == synthesis for multi-field data class may be missing on the syx run path; demonstrate with description / ===.
    print(u1 === u3)

    let p1 = Point2D(3, 4)
    let p2 = p1.copy()
    print(p1.description)
    print(p2.description)
    print(p1 === p2)
}

func demoInheritance() {
    let d = Dog(name: "Rex")
    d.speak()
}

func demoFinal() {
    let k = ImmutableKey(id: 7)
    print(k.id)
}

func main() {
    print("chapter 10: structures and classes")
    demoClassValues()
    demoClassRefs()
    demoDataClass()
    demoInheritance()
    demoFinal()
    // note: actor / Task.detached / mutating struct methods are covered in the concurrency and later chapters.
}
