// =============================================================================
// tutorial/07-functions.sy
// Corresponds to Chapter 7 "Functions" of the *SYX Language Guide*
//
// Language features covered in this chapter:
//   - func declaration / named parameters / default parameters
//   - Argument external labels (label name / _ name)
//   - Multiple return values (tuples)
//   - Nested functions
//   - Effect annotations requires Pure / requires IO
//   - async / throws functions
//   - Overloading
//   - inout (not implemented, comment only)
//   - Function references / function types
// =============================================================================

func greet(name: String) {
    print("Hello, \(name)")
}

func addNums(a: Int, b: Int) -> Int {
    return a + b
}

// note: Default parameters are often nil on the CLI path; this tutorial passes them explicitly.
func logMsg(msg: String, level: String, tag: String) {
    print(level)
    print(tag)
    print(msg)
}

func moveTo(to destination: String) -> String {
    return "moved to \(destination)"
}

func joinTask(_ task: String) -> String {
    return "joined \(task)"
}

func minMax(_ arr: Array<Int>) -> (min: Int, max: Int) {
    var mn = arr[0]
    var mx = arr[0]
    for x in arr {
        if x < mn {
            mn = x
        }
        if x > mx {
            mx = x
        }
    }
    return (min: mn, max: mx)
}

// note: Nested functions / overloading / requires Pure|IO / async / variadic / inout are not demonstrated here.

func processInt(_ x: Int) -> Int {
    return x * 2
}

func processStr(_ s: String) -> String {
    return s + "!"
}

// note: Function-type parameters cannot be called directly as `f(x)`; apply indirectly via Array.map.
func applyMapped(_ x: Int, f: (Int) -> Int) -> Int {
    let arr = [x]
    let out = arr.map(f)
    return out[0]
}

func divideSafe(_ a: Int, _ b: Int) -> Int {
    if b == 0 {
        return 0
    }
    return a / b
}

func main() {
    print("chapter 07: functions")
    greet(name: "SYX")
    print(addNums(a: 1, b: 2))
    logMsg(msg: "boot", level: "info", tag: "app")
    logMsg(msg: "warn", level: "warn", tag: "boot")
    print(moveTo(to: "home"))
    print(joinTask("worker"))

    let mm = minMax([3, 1, 4, 1, 5, 9, 2, 6])
    print(mm.min)
    print(mm.max)

    print(processInt(3))
    print(processStr("hi"))

    let squared = applyMapped(5, f: { (x: Int) in return x * x })
    print(squared)

    print(divideSafe(10, 2))
    print(divideSafe(10, 0))
    // note: throws / try-catch error handling is covered in Chapter 17.
}
