// =============================================================================
// tutorial/07-functions.sy
// 对应《SYX 语言指南》第 7 章「函数」
//
// 本章涉及语言特性：
//   - func 声明 / 命名参数 / 默认参数
//   - 形参外部标签（label name / _ name）
//   - 多返回值（元组）
//   - 嵌套函数
//   - 效果注解 requires Pure / requires IO
//   - async / throws 函数
//   - 重载
//   - inout（未实现，仅注释）
//   - 函数引用 / 函数类型
// =============================================================================

func greet(name: String) {
    print("Hello, \(name)")
}

func addNums(a: Int, b: Int) -> Int {
    return a + b
}

// note: 默认参数在 CLI 路径上常为 nil，教程改为显式传参。
func logMsg(msg: String, level: String, tag: String) {
    print(level)
    print(tag)
    print(msg)
}

func moveTo(to destination: String) -> String {
    return "moved to \(destination)"
}

func joinTask(_ task: String) -> String {
    return "joined \(task)"
}

func minMax(_ arr: Array<Int>) -> (min: Int, max: Int) {
    var mn = arr[0]
    var mx = arr[0]
    for x in arr {
        if x < mn {
            mn = x
        }
        if x > mx {
            mx = x
        }
    }
    return (min: mn, max: mx)
}

// note: 嵌套函数 / 重载 / requires Pure|IO / async / variadic / inout 本教程不演示。

func processInt(_ x: Int) -> Int {
    return x * 2
}

func processStr(_ s: String) -> String {
    return s + "!"
}

// note: 函数类型参数不能直接 `f(x)` 调用；通过 Array.map 间接应用。
func applyMapped(_ x: Int, f: (Int) -> Int) -> Int {
    let arr = [x]
    let out = arr.map(f)
    return out[0]
}

func divideSafe(_ a: Int, _ b: Int) -> Int {
    if b == 0 {
        return 0
    }
    return a / b
}

func main() {
    print("chapter 07: functions")
    greet(name: "SYX")
    print(addNums(a: 1, b: 2))
    logMsg(msg: "boot", level: "info", tag: "app")
    logMsg(msg: "warn", level: "warn", tag: "boot")
    print(moveTo(to: "home"))
    print(joinTask("worker"))

    let mm = minMax([3, 1, 4, 1, 5, 9, 2, 6])
    print(mm.min)
    print(mm.max)

    print(processInt(3))
    print(processStr("hi"))

    let squared = applyMapped(5, f: { (x: Int) in return x * x })
    print(squared)

    print(divideSafe(10, 2))
    print(divideSafe(10, 0))
    // note: throws / try-catch 错误处理详见第 17 章。
}
