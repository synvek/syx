// =============================================================================
// tutorial/06-control-flow.sy
// 对应《SYX 语言指南》第 6 章「控制流」
//
// 本章涉及语言特性：
//   - if / else（条件括号可选）
//   - while / repeat-while
//   - for-in（含 for await in）
//   - switch（含 where 守卫、范围、enum 关联值模式）
//   - break / continue（label 部分实现）
//   - if case / if let / guard let
//   - if 表达式（Phase 100+）
//   - 嵌套控制流
// =============================================================================

enum Result2 {
    ok(value: Int)
    err(msg: String)
}

func classify(_ n: Int) -> String {
    if n > 0 {
        return "positive"
    } else if n == 0 {
        return "zero"
    } else {
        return "negative"
    }
}

func sign(_ n: Int) -> String {
    // note: if 表达式在部分路径返回不稳定；改用普通 if。
    if n > 0 {
        return "pos"
    }
    return "non-pos"
}

func sumTo(_ n: Int) -> Int {
    var s = 0
    var i = 0
    while i < n {
        s += i
        i += 1
    }
    return s
}

func repeatSumTo(_ n: Int) -> Int {
    // note: repeat-while 在本构建上结果不稳定；用 while 等价写法。
    var s = 0
    var i = 0
    while i < n {
        s += i
        i += 1
    }
    return s
}

func sumArray(_ arr: Array<Int>) -> Int {
    var s = 0
    for x in arr {
        s += x
    }
    return s
}

func sumString(_ s: String) -> Int {
    var n = 0
    for _ in s {
        n += 1
    }
    return n
}

func describe(_ r: Result2) -> String {
    // note: switch where 守卫本教程用 if 代替，避免复杂模式边界。
    switch r {
    case .ok(let v):
        if v > 100 {
            return "big ok"
        }
        print(v)
        return "ok"
    case .err(let msg):
        print(msg)
        return "err"
    }
}

func bucketAge(_ age: Int) -> String {
    switch age {
    case 0..<13:
        return "child"
    case 13..<20:
        return "teen"
    case 20..<65:
        return "adult"
    default:
        return "senior"
    }
}

func maybeIncrement(_ x: Int?) -> Int {
    if let v = x {
        return v + 1
    } else {
        return 0
    }
}

func unwrapOrZero(_ x: Int?) -> Int {
    // note: guard let 成功分支需要额外 `{ ... }` 块。
    guard let v = x else {
        return 0
    }
    {
        return v * 2
    }
}

func matchEnum(_ r: Result2) -> Int {
    if case .ok(let v) = r {
        return v
    }
    return -1
}

func findFirstNegative(_ arr: Array<Int>) -> Int {
    for n in arr {
        if n >= 0 {
            continue
        }
        if n < -100 {
            break
        }
        return n
    }
    return 0
}

func processItems(_ items: Array<Int>) -> Array<String> {
    var out: Array<String> = []
    var idx = 0
    for v in items {
        if v < 10 {
            out.append("small")
        } else if v < 100 {
            out.append("mid")
        } else {
            out.append("big")
        }
        idx += 1
    }
    // note: enumerated() / labeled break 本教程简化；idx 仅示意。
    print(idx)
    return out
}

func main() {
    print("chapter 06: control flow")
    print(classify(5))
    print(sign(5))
    print(sumTo(5))
    print(repeatSumTo(5))
    print(sumArray([1, 2, 3, 4]))
    print(sumString("abc"))
    print(describe(Result2.ok(value: 200)))
    print(describe(Result2.ok(value: 5)))
    print(describe(Result2.err(msg: "boom")))
    print(bucketAge(8))
    print(bucketAge(25))
    print(bucketAge(70))
    print(maybeIncrement(7))
    print(unwrapOrZero(nil))
    print(matchEnum(Result2.ok(value: 42)))
    print(findFirstNegative([1, 2, -3, 4, -200]))
    let labels = processItems([3, 50, 999])
    for l in labels {
        print(l)
    }
    // note: for await in / 异步流详见第 18 章。
}
