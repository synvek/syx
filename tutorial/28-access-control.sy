// =============================================================================
// tutorial/28-access-control.sy
// Access control: public / internal / private / fileprivate (same-file demo).
// note: cross-module S005 visibility needs a multi-file project — commented only.
// =============================================================================

public func sumAB(a: Int, b: Int) -> Int {
    return a + b
}

public func subtractAB(a: Int, b: Int) -> Int {
    return a - b
}

internal func moduleHelper() -> Int {
    return 42
}

private var secretCounter = 0
private func incrementSecret() {
    secretCounter = secretCounter + 1
}

fileprivate var fileLocalVar = 1

public class PublicClass {
    public var openField: Int
    internal var internalField: Int
    private var privateField: Int

    public init() {
        self.openField = 0
        self.internalField = 0
        self.privateField = 0
    }

    public func openMethod() { print("open") }
    internal func internalMethod() { print("internal") }
    private func privateMethod() { print("private") }

    public func touchPrivate() {
        self.privateField = self.privateField + 1
        print(self.privateField)
    }
}

internal class InternalClass {
    var x: Int
    init() { self.x = 0 }
}

private class PrivateHelper {
    func help() { print("help") }
}

class OuterClass {
    private var privateField: Int
    internal var internalField: Int
    init() {
        self.privateField = 100
        self.internalField = 200
    }
    func accessInside() {
        print(self.privateField)
        print(self.internalField)
    }
}

class CounterAccess {
    private var count: Int
    init() { self.count = 0 }
    func increment() { self.count = self.count + 1 }
    func current() -> Int { return self.count }
}

extension PublicClass {
    func extensionMethod() {
        print(self.openField)
    }
}

func withinFile() {
    print(sumAB(a: 1, b: 2))
    print(moduleHelper())
    print(secretCounter)
    incrementSecret()
    print(secretCounter)
    print(fileLocalVar)

    let p = PublicClass()
    p.openField = 1
    p.internalField = 2
    p.openMethod()
    p.internalMethod()
    p.touchPrivate()
    p.extensionMethod()

    let ic = InternalClass()
    print(ic.x)
    PrivateHelper().help()
}

func accessOutside() {
    let o = OuterClass()
    o.accessInside()
    print(o.internalField)
    // print(o.privateField)  ← private: not visible outside type
}

func main() {
    withinFile()
    accessOutside()
    let ca = CounterAccess()
    ca.increment()
    ca.increment()
    print(ca.current())
    print(subtractAB(a: 5, b: 2))
    print("access-control demo done")
}
