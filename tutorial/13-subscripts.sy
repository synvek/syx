// =============================================================================
// tutorial/13-subscripts.sy
// Corresponds to Chapter 13 "Subscripts" of the *SYX Language Guide*
//
// Runnable demos: built-in subscripts for Array / Dictionary / String.
// note: Custom subscript triggers S001 (duplicate self definition) in the current runtime -> omitted.
// note: KeyPath and Object dynamic subscripts are not demonstrated here.
// =============================================================================

func arraySubscript() {
    let items = [10, 20, 30]
    print(items[0])
    print(items[2])

    var mut = [1, 2, 3]
    mut[1] = 99
    print(mut[0])
    print(mut[1])
    print(mut[2])
    // print(items[5])  // note: out of bounds -> R003
}

func dictSubscript() {
    let m: Dictionary<String, Int> = {"a": 1, "b": 2}
    print(m["a"])
    print(m["missing"])

    var mut: Dictionary<String, Int> = {"x": 10}
    mut["y"] = 20
    print(mut["x"])
    print(mut["y"])
}

func stringSubscript() {
    let s = "syx"
    print(s[0])
    print(s[1])
    print(s[2])
}

func nestedAccess() {
    // Simulate 2D subscript with an "array of arrays" to avoid a custom subscript
    var row0 = [1.0, 2.0, 0.0]
    var row1 = [0.0, 5.0, 0.0]
    var row2 = [0.0, 0.0, 0.0]
    print(row0[0])
    print(row0[1])
    print(row1[1])
    row2[2] = 9.0
    print(row2[2])
}

func main() {
    arraySubscript()
    dictSubscript()
    stringSubscript()
    nestedAccess()
}
