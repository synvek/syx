// =============================================================================
// tutorial/13-subscripts.sy
// 对应《SYX 语言指南》第 13 章「下标」
//
// 可运行演示：Array / Dictionary / String 内置下标。
// note: 自定义 subscript 在当前运行时会触发 S001（self 重复定义）→ 省略。
// note: KeyPath、Object 动态下标此处不演示。
// =============================================================================

func arraySubscript() {
    let items = [10, 20, 30]
    print(items[0])
    print(items[2])

    var mut = [1, 2, 3]
    mut[1] = 99
    print(mut[0])
    print(mut[1])
    print(mut[2])
    // print(items[5])  // note: 越界 → R003
}

func dictSubscript() {
    let m: Dictionary<String, Int> = {"a": 1, "b": 2}
    print(m["a"])
    print(m["missing"])

    var mut: Dictionary<String, Int> = {"x": 10}
    mut["y"] = 20
    print(mut["x"])
    print(mut["y"])
}

func stringSubscript() {
    let s = "syx"
    print(s[0])
    print(s[1])
    print(s[2])
}

func nestedAccess() {
    // 用「数组的数组」模拟二维下标，避免自定义 subscript
    var row0 = [1.0, 2.0, 0.0]
    var row1 = [0.0, 5.0, 0.0]
    var row2 = [0.0, 0.0, 0.0]
    print(row0[0])
    print(row0[1])
    print(row1[1])
    row2[2] = 9.0
    print(row2[2])
}

func main() {
    arraySubscript()
    dictSubscript()
    stringSubscript()
    nestedAccess()
}
