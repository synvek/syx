// =============================================================================
// tutorial/17-error-handling.sy
// Corresponds to Chapter 17 "Error Handling" of the *SYX Language Guide*
//
// Runnable demos: try/catch block structure, data class error types, Result, Optional.
// note: In the current runtime, throw may not enter catch -> express failure with Result/Optional.
// note: switch over an associated-value enum may prevent the process from exiting -> avoid switch.
// note: throws -> T, try?, try!, rethrows, and Optional == nil are omitted here.
// =============================================================================

data class AppError(code: Int, message: String)

// 1) try / catch structure (no throw, demonstrating that the block runs)
func tryCatchBlock() {
    try {
        let content = "fake-content"
        print(content)
    } catch (err) {
        print("failed")
    }
}

// 2) Express fallible operations with Optional
func divide(_ a: Int, _ b: Int) -> Int? {
    if b == 0 {
        return nil
    }
    return a / b
}

func loadFile(_ path: String) -> String? {
    if path == "" {
        return nil
    }
    return "content"
}

func optionalErrors() {
    let v1 = divide(10, 2)
    let v2 = divide(10, 0)
    print(v1)
    print(v2)

    let ok = loadFile("/tmp/x")
    let bad = loadFile("")
    print(ok)
    print(bad)
}

// 3) Standard-library Result (String success / failure)
func safeDivide(_ a: Int, _ b: Int) -> Result<String, String> {
    if b == 0 {
        return Result.err(value: "div by zero")
    }
    return Result.ok(value: "ok")
}

func resultDemo() {
    let r1 = safeDivide(20, 4)
    print(Result.isOk(result: r1))
    let r2 = safeDivide(20, 0)
    print(Result.isErr(result: r2))
    let r3 = Result.ok(value: "hello")
    print(Result.isOk(result: r3))
    let r4 = Result.err(value: "boom")
    print(Result.isErr(result: r4))
}

// 4) data class as error carrier
func appErrorDemo() {
    let e = AppError(code: 500, message: "internal")
    print(e.code)
    print(e.message)
}

// 5) Optional lookup
data class User(id: Int, name: String)

func findUser(_ id: Int) -> User? {
    if id > 0 {
        return User(id: id, name: "u")
    }
    return nil
}

func optionalFind() {
    let u1 = findUser(7)
    let u2 = findUser(-1)
    print(u1)
    print(u2)
}

// 6) Workflow: use a Bool flag instead of reusing path (avoid moved value)
func workflowOk() -> String? {
    let content = loadFile("/tmp/x")
    let n = divide(42, 2)
    print(n)
    print(content)
    return "result"
}

func workflowBad() -> String? {
    return nil
}

func callWorkflow() {
    let r = workflowOk()
    print(r)
    let bad = workflowBad()
    print(bad)
}

func main() {
    tryCatchBlock()
    optionalErrors()
    resultDemo()
    appErrorDemo()
    optionalFind()
    callWorkflow()
}
