// =============================================================================
// tutorial/17-error-handling.sy
// 对应《SYX 语言指南》第 17 章「错误处理」
//
// 可运行演示：try/catch 块结构、data class 错误类型、Result、Optional。
// note: 当前运行时 throw 可能不会进入 catch → 用 Result/Optional 表达失败。
// note: switch 匹配关联值 enum 可能导致进程不退出 → 避免 switch。
// note: throws -> T、try?、try!、rethrows、Optional == nil 此处省略。
// =============================================================================

data class AppError(code: Int, message: String)

// 1) try / catch 结构（无 throw，演示块可运行）
func tryCatchBlock() {
    try {
        let content = "fake-content"
        print(content)
    } catch (err) {
        print("failed")
    }
}

// 2) 用 Optional 表达可失败操作
func divide(_ a: Int, _ b: Int) -> Int? {
    if b == 0 {
        return nil
    }
    return a / b
}

func loadFile(_ path: String) -> String? {
    if path == "" {
        return nil
    }
    return "content"
}

func optionalErrors() {
    let v1 = divide(10, 2)
    let v2 = divide(10, 0)
    print(v1)
    print(v2)

    let ok = loadFile("/tmp/x")
    let bad = loadFile("")
    print(ok)
    print(bad)
}

// 3) 标准库 Result（String 成功 / 失败）
func safeDivide(_ a: Int, _ b: Int) -> Result<String, String> {
    if b == 0 {
        return Result.err(value: "div by zero")
    }
    return Result.ok(value: "ok")
}

func resultDemo() {
    let r1 = safeDivide(20, 4)
    print(Result.isOk(result: r1))
    let r2 = safeDivide(20, 0)
    print(Result.isErr(result: r2))
    let r3 = Result.ok(value: "hello")
    print(Result.isOk(result: r3))
    let r4 = Result.err(value: "boom")
    print(Result.isErr(result: r4))
}

// 4) data class 作为错误载体
func appErrorDemo() {
    let e = AppError(code: 500, message: "internal")
    print(e.code)
    print(e.message)
}

// 5) Optional 查找
data class User(id: Int, name: String)

func findUser(_ id: Int) -> User? {
    if id > 0 {
        return User(id: id, name: "u")
    }
    return nil
}

func optionalFind() {
    let u1 = findUser(7)
    let u2 = findUser(-1)
    print(u1)
    print(u2)
}

// 6) 工作流：用 Bool 标志代替二次使用 path（避免 moved value）
func workflowOk() -> String? {
    let content = loadFile("/tmp/x")
    let n = divide(42, 2)
    print(n)
    print(content)
    return "result"
}

func workflowBad() -> String? {
    return nil
}

func callWorkflow() {
    let r = workflowOk()
    print(r)
    let bad = workflowBad()
    print(bad)
}

func main() {
    tryCatchBlock()
    optionalErrors()
    resultDemo()
    appErrorDemo()
    optionalFind()
    callWorkflow()
}
