// =============================================================================
// tutorial/02-the-basics.sy
// Corresponds to Chapter 2 "The Basics" of the *SYX Language Guide*
//
// Language features covered in this chapter:
//   - let / var declarations
//   - Explicit type annotation + type inference
//   - Comments (//, /* */, ///)
//   - Numeric literals (Int/UInt/Float/Double, 8/16/32/64/128-bit, hex/binary/octal, underscore separators)
//   - Numeric promotion and literal rules
//   - Bool, nil
//   - typealias
//   - Nested types (flattened naming is recommended)
//   - Naming conventions
// =============================================================================

/// Doc-comment example (extractable by `syx doc`)
func documented(a: Int, b: Int) -> Int {
    return a + b
}

typealias Handle = Int

// note: Function-type values can be declared, but calling a closure variable by name is unstable on some paths; a plain function is used here instead of a Handler.
func formatId(n: Int) -> String {
    return "id=\(n)"
}

func register(h: Handle) {
    print("handle=\(h)")
}

// note: Use flattened naming for nested types; do not write a Swift-style `struct { var x: Int }` body.
data class OuterMarker_Inner(value: Int)

func demo_bindings() {
    // 1) Immutable / mutable
    let pi = 3.14159
    var counter = 0
    counter = counter + 1
    // pi = 3.14  // note: cannot assign to let

    // 2) Explicit type annotation
    let x: Int = 10
    let name: String = "SYX"
    let items: Array<Int> = [1, 2, 3]
    let scores: Dictionary<String, Int> = {"a": 1, "b": 2}
    let maybe: Int? = nil

    // 3) Comments
    // Single-line comment
    /* Block comment (nested block-comment syntax is in the Language Guide; single-level used here) */

    print("counter=")
    print(counter)
    print(pi)
    print(x)
    print(name)
    print(items.count)
    print(scores.count)
    // note: Optional == nil comparison is unstable at type-checking; use ?? to observe the default value.
    print(maybe ?? 0)
}

func demo_numbers() {
    // 4) Numeric literals
    let a = 42
    let b = 100i8
    let c = 1000i64
    let d = 0xFFu8
    let e = 0b1010u16
    let f = 0o17u32
    let g = 1_000_000i64
    let h = 42i128
    let i = 3.14f32
    let j = 3.14
    // note: Scientific-notation literals print incompletely on some paths; this tutorial uses a plain Float64.
    let k = 2.5
    let u = 0xFFu128

    print(a)
    print(b)
    print(c)
    print(d)
    print(e)
    print(f)
    print(g)
    print(h)
    print(i)
    print(j)
    print(k)
    print(u)

    // 5) Same-type arithmetic
    let p: Int = 1
    let r = p + 1
    print(r)
    // note: Int + Float64 auto-promotion is unstable on the CLI path; this tutorial keeps same-type operations.
}

func demo_bool_alias_tuple() {
    // 6) Bool and nil
    let ok: Bool = true
    let ng: Bool = false
    let empty: String? = nil
    let present: String? = "hi"
    print(ok)
    print(ng)
    print(empty ?? "none")
    print(present ?? "none")

    // 7) typealias
    register(h: 42)
    print(formatId(n: 7))

    // 8) Flattened record types
    let inner = OuterMarker_Inner(7)
    print(inner.value)

    // 9) Tuples
    let pair: (Int, String) = (1, "a")
    print(pair.0)
    print(pair.1)
    let named = (x: 10, y: 20)
    print(named.x)
    print(named.y)
    let (a1, a2) = (3, 4)
    print(a1)
    print(a2)

    // 10) Multiline strings
    let name = "SYX"
    let multiline = """
line one
line two with \(name) interpolation
line three
"""
    print(multiline)
    let doc = documented(a: 1, b: 2)
    print(doc)
}

func main() {
    print("chapter 02: the basics")
    demo_bindings()
    demo_numbers()
    demo_bool_alias_tuple()
}
