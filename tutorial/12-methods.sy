// =============================================================================
// tutorial/12-methods.sy
// 对应《SYX 语言指南》第 12 章「方法」
//
// 可运行演示：实例方法、静态方法、override、self、init / deinit。
// note: struct mutating / 协议默认实现在本教程中省略（解析或运行时受限）。
// note: class 上 Array 字段的 append 在当前运行时不可靠 → 用 Int 状态演示。
// =============================================================================

// 1) 实例方法
class Counter {
    var value: Int
    init(value: Int) {
        self.value = value
    }
    func increment() {
        self.value = self.value + 1
    }
    func incrementBy(_ n: Int) {
        self.value = self.value + n
    }
    func describe() {
        print(self.value)
    }
}

func demoInstance() {
    let c = Counter(value: 0)
    c.increment()
    c.incrementBy(5)
    c.describe()
}

// 2) 静态方法 / 工厂
class Factory {
    static var defaultName: String = "anon"
    static func create() -> Factory {
        return Factory()
    }
    static func withName(_ s: String) -> Factory {
        print(s)
        return Factory()
    }
}

func demoStatic() {
    let f1 = Factory.create()
    let f2 = Factory.withName("primary")
    print(Factory.defaultName)
}

// 3) override（无 super.init；子类自有默认字段）
class Shape {
    var name: String = "Shape"
    func area() -> Double {
        return 0.0
    }
    func describe() {
        print(self.name)
    }
}

class Square: Shape {
    var side: Double = 1.0
    override func area() -> Double {
        return self.side * self.side
    }
    override func describe() {
        print("Square")
    }
}

class CircleShape: Shape {
    var radius: Double = 1.0
    override func area() -> Double {
        return 3.14159 * self.radius * self.radius
    }
}

func demoOverride() {
    let sq = Square()
    sq.side = 2.0
    sq.describe()
    print(sq.area())

    let ci = CircleShape()
    ci.radius = 1.0
    print(ci.area())

    let asShape: Shape = Square()
    asShape.describe()
}

// 4) self 显式 / 隐式
class Box {
    var value: Int
    init(value: Int) {
        self.value = value
    }
    func set(_ v: Int) {
        self.value = v
    }
    func show() {
        print(self.value)
    }
}

func demoSelf() {
    let b = Box(value: 1)
    b.set(9)
    b.show()
}

// 5) init / deinit
class Resource {
    var name: String
    init(name: String) {
        self.name = name
        print("init")
    }
    deinit {
        print("deinit")
    }
}

func demoLifecycle() {
    let r = Resource(name: "temp")
    print(r.name)
}

// 6) 链式：返回 self（非 Array 状态）
class Accumulator {
    var total: Int
    init() {
        self.total = 0
    }
    static func make() -> Accumulator {
        return Accumulator()
    }
    func add(_ n: Int) -> Accumulator {
        self.total = self.total + n
        return self
    }
}

func demoChain() {
    let a = Accumulator.make().add(1).add(2).add(3)
    print(a.total)
}

func main() {
    demoInstance()
    demoStatic()
    demoOverride()
    demoSelf()
    demoLifecycle()
    demoChain()
}
