// =============================================================================
// tutorial/05-collection-types.sy
// 对应《SYX 语言指南》第 5 章「集合类型」
//
// 本章涉及语言特性：
//   - Array<T> 字面量 / 方法 / 下标
//   - Set<T> 去重 / 集合运算
//   - Dictionary<K,V> 字面量 / 访问
//   - Object 动态 JSON
//   - HOF：map / filter / reduce
//   - for-in 遍历（含字符串 / 数组 / 文件 readLines）
//   - 集合与字符串互转
// =============================================================================

// 1) Array
let nums: Array<Int> = [1, 2, 3, 4, 5]
let empty: Array<Int> = []
print("length=\(nums.count) first=\(nums.first) last=\(nums.last)")

// 强类型：禁止裸 Array
// let bad = [1, "a"]                    // ❌ 元素类型不统一
let anyArr: Array<Any> = [1, "a", true]

// 下标读写
var arr = [10, 20, 30]
print(arr[0])                              // 10
arr[1] = 99
print("arr=\(arr)")

// 常用方法
let contains3 = nums.contains(3)          // true
let sortedDesc = [3, 1, 2].sorted()       // [1, 2, 3]
let reversed = [1, 2, 3].reverse()        // [3, 2, 1]
let joined = [1, 2, 3].joined(",")        // "1,2,3"
let appended = [1, 2].append(3)           // 副作用式追加

// 2) Set
let tags: Set<Int> = [1, 2, 2, 3, 3, 3]   // 自动去重
print("tags.count=\(tags.count)")
print("tags.contains(2)=\(tags.contains(2))")
print("tags.union(Set([3,4]))=\(tags.union(Set([3, 4])))")
print("tags.intersection(Set([2,3]))=\(tags.intersection(Set([2, 3])))")
print("tags.subtracting(Set([1]))=\(tags.subtracting(Set([1])))")

// 3) Dictionary
let scores: [String: Int] = ["a": 1, "b": 2, "c": 3]
print("scores.count=\(scores.count)")
print("scores[a]=\(scores["a"])")         // Optional(1)
print("scores.count=\(scores.count)")
print("scores.containsKey(\"b\")=\(scores.containsKey("b"))")
let keys = scores.keys                    // 所有键
let values = scores.values                // 所有值
var mutableScores = ["x": 10]
mutableScores["y"] = 20
mutableScores.remove("x")
print("mutableScores=\(mutableScores)")

// 4) Object（动态 JSON 式）
let user: Object = { "name": "SYX", "version": 110, "stable": true }
print("user=\(user)")
print("user.name=\(user["name"])")
print("user.version=\(user["version"])")
let nested: Object = {
    "id": 1,
    "tags": ["a", "b", "c"],
    "meta": { "created": 1700000000 }
}
print("nested.tags=\(nested["tags"])")
print("nested.meta.created=\(nested["meta"]?["created"] ?? 0)")

// 5) HOF：map / filter / reduce
let doubled = [1, 2, 3, 4, 5].map({ |x| x * 2 })              // [2,4,6,8,10]
let evens = [1, 2, 3, 4, 5].filter({ |x| x % 2 == 0 })        // [2, 4]
let sum10 = [1, 2, 3, 4].reduce(0, { |a, b| a + b })         // 10
let s2s = [1, 2, 3].map({ |x| "n=\(x)" })                    // ["n=1", "n=2", "n=3"]

// 链式 HOF
let sumEvenSq = [1, 2, 3, 4, 5]
    .filter({ |x| x % 2 == 0 })    // [2, 4]
    .map({ |x| x * x })            // [4, 16]
    .reduce(0, { |a, b| a + b })   // 20

// 6) 字符串与 Array 互转
let csv = "a,b,c"
let parts = csv.split(",")                // ["a", "b", "c"]
let rejoined = parts.joined("-")          // "a-b-c"
let chars: Array<Character> = Array("abc")
let back = chars.joined("")               // "abc"

// 7) for-in 遍历
for n in [10, 20, 30] { print("n=\(n)") }
for ch in "xyz" { print("ch=\(ch)") }

// 8) zip / chunked
let zipped = [1, 2, 3].zip(["a", "b", "c"])
let chunks = [1, 2, 3, 4, 5].chunked(2)   // [[1,2],[3,4],[5]]

func main() {
    print("doubled=\(doubled) evens=\(evens) sum10=\(sum10)")
    print("s2s=\(s2s) sumEvenSq=\(sumEvenSq)")
    print("parts=\(parts) rejoined=\(rejoined)")
    print("zipped=\(zipped) chunks=\(chunks)")
    print("anyArr.count=\(anyArr.count)")
    print("keys=\(keys) values=\(values)")
}
