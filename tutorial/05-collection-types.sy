// =============================================================================
// tutorial/05-collection-types.sy
// Corresponds to Chapter 5 "Collection Types" of the *SYX Language Guide*
//
// Language features covered in this chapter:
//   - Array<T> literals / methods / subscript
//   - Set<T> deduplication / set operations
//   - Dictionary<K,V> literals / access
//   - Object dynamic JSON
//   - HOF: map / filter / reduce
//   - for-in traversal (strings / arrays / file readLines)
//   - Conversion between collections and strings
// =============================================================================

func demo_array() {
    let nums: Array<Int> = [1, 2, 3, 4, 5]
    let empty: Array<Int> = []
    print("nums.count=\(nums.count) empty.count=\(empty.count)")
    // note: Array has no first/last/isEmpty; use subscript and count.

    var arr = [10, 20, 30]
    print(arr[0])
    arr[1] = 99
    print(arr[1])

    print(nums.contains(3))
    let sortedAsc = [3, 1, 2].sorted()
    print(sortedAsc)
    let reversed = [1, 2, 3].reverse()
    print(reversed)
    let joined = [1, 2, 3].joined(",")
    print(joined)
    arr.append(40)
    print(arr.count)
}

func demo_set() {
    let tags: Set<Int> = [1, 2, 2, 3, 3, 3]
    print(tags.count)
    print(tags.contains(2))

    var s: Set<Int> = [1, 2]
    print(s.insert(3))
    print(s.contains(3))
    print(s.remove(1))

    // note: union/intersection accept array literals; subtracting is not demonstrated here.
    let u = tags.union([3, 4])
    print(u.count)
    let inter = tags.intersection([2, 3])
    print(inter.count)
}

func demo_dictionary() {
    let scores: Dictionary<String, Int> = {"a": 1, "b": 2, "c": 3}
    print(scores.count)
    print(scores["a"])
    print(scores.containsKey("b"))
    print(scores.keys)
    print(scores.values)

    var mutableScores: Dictionary<String, Int> = {"x": 10}
    mutableScores["y"] = 20
    print(mutableScores.remove("x"))
    print(mutableScores)

    // note: Object dynamic JSON and nested optional chaining are not demonstrated here.
}

func demo_hof() {
    let nums: Array<Int> = [1, 2, 3, 4, 5]
    // note: Closure parameters must be parenthesized; HOF bodies should use return.
    let doubled = nums.map({ (x: Int) in return x * 2 })
    let evens = nums.filter({ (x: Int) in return x % 2 == 0 })
    let sum10 = nums.reduce(0, { (a: Int, b: Int) in return a + b })
    print(doubled)
    print(evens)
    print(sum10)

    let sumEvenSq = nums
        .filter({ (x: Int) in return x % 2 == 0 })
        .map({ (x: Int) in return x * x })
        .reduce(0, { (a: Int, b: Int) in return a + b })
    print(sumEvenSq)

    let zipped = [1, 2, 3].zip(["a", "b", "c"])
    let chunks = [1, 2, 3, 4, 5].chunked(2)
    print(zipped)
    print(chunks)
}

func demo_for_and_string() {
    for n in [10, 20, 30] {
        print(n)
    }
    for ch in "xyz" {
        print(__syx_value_description(ch))
    }

    let csv = "a,b,c"
    let parts = csv.split(",")
    let rejoined = parts.joined("-")
    print(parts)
    print(rejoined)
}

func main() {
    print("chapter 05: collection types")
    demo_array()
    demo_set()
    demo_dictionary()
    demo_hof()
    demo_for_and_string()
}
