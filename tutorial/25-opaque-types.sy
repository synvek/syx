// =============================================================================
// tutorial/25-opaque-types.sy
// Opaque types: `some Equatable` (MVP from fixtures/format/opaque_some_mvp).
// note: broader `some Shape` / `any Shape` demos may fail — keep minimal.
// =============================================================================

func makeNum() -> some Equatable {
    return 42
}

func makeFlag() -> some Equatable {
    return true
}

func opaqueLocal() {
    let x: some Equatable = 1
    let y: some Equatable = "ok"
    print(x)
    print(y)
}

func main() {
    opaqueLocal()
    let n = makeNum()
    let f = makeFlag()
    print(n)
    print(f)

    // Conceptual note: `some P` fixes a concrete type per return site
    // (static dispatch), while `any P` would box existentials (when available).
    print("opaque mvp ok")
}
