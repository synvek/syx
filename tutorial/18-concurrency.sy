// =============================================================================
// tutorial/18-concurrency.sy
// Corresponds to Chapter 18 "Concurrency" of the *SYX Language Guide*
//
// Runnable demos: Task / Task.detached, Channel, Concurrency runtime configuration.
// note: async main + await Concurrency.sleep may re-enter the loop in the current runtime -> this file uses a synchronous main.
// note: actor / async let / @MainActor / TaskGroup are omitted or limited.
// =============================================================================

import Sync
import Concurrency

func work() {
    print("task-body")
}

func taskDemo() {
    let t = Task {
        work()
    }
    Concurrency.join(t)
    print("joined")
}

func detachedDemo() {
    Task.detached {
        work()
    }
    Concurrency.sleep(40)
    print("detached-done")
}

func channelDemo() {
    let ch = Channel.create(2)
    print(ch.capacity())
    ch.trySend(1)
    ch.trySend(2)
    print(ch.count())
    let a = ch.tryRecv()
    print(a)
    print(ch.count())

    let unbounded = Channel()
    print(unbounded.capacity())
}

func configDemo() {
    Concurrency.setWorkerCount(4)
    print(Concurrency.workerCount())
    Concurrency.setMaxActors(8)
    print(Concurrency.maxActors())
    Concurrency.setMailboxCapacity(16)
    print(Concurrency.mailboxCapacity())
    Concurrency.setTaskQueueCapacity(100)
    print(Concurrency.taskQueueCapacity())
    Concurrency.setTaskRejectPolicy("abort")
    print(Concurrency.taskRejectPolicy())
}

func poolDemo() {
    Concurrency.setCorePoolSize(2)
    print(Concurrency.corePoolSize())
    Concurrency.setMaximumPoolSize(8)
    print(Concurrency.maximumPoolSize())
    Concurrency.setKeepAliveMs(30000)
    print(Concurrency.keepAliveMs())
}

func main() {
    print("begin")
    taskDemo()
    detachedDemo()
    channelDemo()
    configDemo()
    poolDemo()
    print("end")
}
