// =============================================================================
// tutorial/24-generics.sy
// Generics: data class type params and simple typed helpers.
// note: `func id<T>` / `class Box<T>` may not lower at runtime —
//       prefer `data class Box<T>(...)` and concrete helpers.
// =============================================================================

data class Box<T>(value: T)
data class Pair<A, B>(first: A, second: B)

func idInt(_ value: Int) -> Int { return value }
func idString(_ value: String) -> String { return value }

func eqInt(a: Int, b: Int) -> Bool { return a == b }

func swapInt(a: Int, b: Int) -> Pair<Int, Int> {
    return Pair(first: b, second: a)
}

func mergeUnique(_ a: Array<Int>, _ b: Array<Int>) -> Array<Int> {
    var out: Array<Int> = []
    for itemA in a {
        var seen = false
        for y in out { if y == itemA { seen = true } }
        if !seen { out.append(itemA) }
    }
    for itemB in b {
        var seen = false
        for y in out { if y == itemB { seen = true } }
        if !seen { out.append(itemB) }
    }
    return out
}

func sumInts(_ arr: Array<Int>) -> Int {
    var s = 0
    for n in arr { s = s + n }
    return s
}

func main() {
    print(idInt(42))
    print(idString("hi"))
    print(eqInt(a: 1, b: 1))

    let b1 = Box(value: 42)
    let b2 = Box(value: "hello")
    print(b1.value)
    print(b2.value)

    let p = Pair(first: "Alice", second: 30)
    print(p.first)
    print(p.second)

    let sw = swapInt(a: 1, b: 2)
    print(sw.first)
    print(sw.second)

    // Prefer local arrays for push/pop demos
    var items: Array<Int> = []
    items.append(1)
    items.append(2)
    items.append(3)
    print(items.count)
    print(items[items.count - 1])

    print(mergeUnique([1, 2, 3], [3, 4, 5]))
    print(sumInts([1, 2, 3]))

    let dict: Dictionary<String, Int> = {"default": 99, "key": 1}
    print(dict["default"])
}
