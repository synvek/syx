// =============================================================================
// tutorial/33-runtime-extensions.sy
// Runtime / Host surface: Math + Crypto (no missing plugin symbols).
// note: do NOT call `__syx_plugin_echo_echo` / custom plugins unless loaded.
//       Plugin paths (SYX_HOST_PLUGIN_PATH) are project/runtime config.
// =============================================================================

import Math
import Crypto

func demoMathHost() {
    print(Math.add(2, 3))
    print(Math.sqrt(9.0))
    print(Math.min(8, 3))
}

func demoCryptoHost() {
    print(Crypto.sha256("hello from syx"))
}

func demoHasher() {
    var h = Hasher.newHasher()
    let n: Int = 42
    n.hash(into: h)
    print(Hasher.finalize(h))
}

// Optional: native Host plugins are registered outside the source file, e.g.
//   export SYX_HOST_PLUGIN_PATH=...
//   syx run app.sy
// Missing `__syx_plugin_*` symbols will fail link/load — prefer Core Host APIs.

func main() {
    demoMathHost()
    demoCryptoHost()
    demoHasher()
    print("runtime-extensions demo done")
}
