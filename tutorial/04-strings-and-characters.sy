// =============================================================================
// tutorial/04-strings-and-characters.sy
// Corresponds to Chapter 4 "Strings and Characters" of the *SYX Language Guide*
//
// Language features covered in this chapter:
//   - String literals (single-line / multiline / escape / interpolation)
//   - Character type (Phase 139 MVP GA)
//   - Grapheme-cluster semantics (Phase 84+)
//   - Subscript s[i] character access
//   - Common string methods (split/trim/case/prefix/suffix/substring/replace/...)
//   - for-in traversal
//   - Regex literals
//   - String concatenation / comparison
//   - Conversion with Array
// =============================================================================

func demo_literals() {
    let s = "Hello"
    let msg = "Hello, \(s)!"
    let multi = "a" + "b" + "c"
    let tabbed = "col1\tcol2\tcol3"
    print("msg=\(msg)")
    print("multi=\(multi)")
    print(tabbed)

    // note: `\u{...}` is preserved verbatim on some paths; multiline strings and interpolation work.
    let haiku = """
line one
line two with \(s)
line three
"""
    print(haiku)
}

func demo_methods() {
    let parts = "a,b,c".split(",")
    let trimmed = "  hi  ".trim()
    let lower = "ABC".lowercased()
    let upper = "abc".uppercased()
    let hasPre = "file.txt".hasPrefix("file")
    let len = "text".count
    let digitMatches = "abc123def".matches("\\d+")

    print("parts=\(parts)")
    print("trimmed=\(trimmed) lower=\(lower) upper=\(upper)")
    print("hasPrefix=\(hasPre) len=\(len)")
    print("matches=\(digitMatches)")

    // note: hasSuffix / replacingOccurrences / substring / repeat / isEmpty are unavailable or unstable in this build.
    let back = parts.joined("-")
    print("joined=\(back)")
}

func demo_chars_and_compare() {
    for c in "abc" {
        print(__syx_value_description(c))
    }

    let w = "syx"
    let first: Character = w[0]
    let second = w[1]
    print(__syx_value_description(first))
    print(__syx_value_description(second))

    let a1 = "Hello"
    let a2 = ", World"
    let a3 = a1 + a2
    let a4 = "\(a1)\(a2)!"
    print(a3)
    print(a4)

    print("abc" == "abc")
    // note: String lexicographic comparison with `<` may be unexpected on the current runtime; only == is demonstrated.
}

func main() {
    print("chapter 04: strings and characters")
    demo_literals()
    demo_methods()
    demo_chars_and_compare()
}
