// =============================================================================
// tutorial/04-strings-and-characters.sy
// 对应《SYX 语言指南》第 4 章「字符串和字符」
//
// 本章涉及语言特性：
//   - 字符串字面量（单行 / 多行 / 转义 / 插值）
//   - Character 类型（Phase 139 MVP GA）
//   - 字素簇语义（Phase 84+）
//   - 下标 s[i] 字符访问
//   - 字符串常用方法（split/trim/case/prefix/suffix/substring/replace/...）
//   - for-in 遍历
//   - 正则字面量
//   - String 拼接 / 比较
//   - 与 Array 互转
// =============================================================================

func demo_literals() {
    let s = "Hello"
    let msg = "Hello, \(s)!"
    let multi = "a" + "b" + "c"
    let tabbed = "col1\tcol2\tcol3"
    print("msg=\(msg)")
    print("multi=\(multi)")
    print(tabbed)

    // note: `\u{...}` 在部分路径会原样保留；多行字符串与插值可用。
    let haiku = """
line one
line two with \(s)
line three
"""
    print(haiku)
}

func demo_methods() {
    let parts = "a,b,c".split(",")
    let trimmed = "  hi  ".trim()
    let lower = "ABC".lowercased()
    let upper = "abc".uppercased()
    let hasPre = "file.txt".hasPrefix("file")
    let len = "text".count
    let digitMatches = "abc123def".matches("\\d+")

    print("parts=\(parts)")
    print("trimmed=\(trimmed) lower=\(lower) upper=\(upper)")
    print("hasPrefix=\(hasPre) len=\(len)")
    print("matches=\(digitMatches)")

    // note: hasSuffix / replacingOccurrences / substring / repeat / isEmpty 在本构建中不可用或行为不稳定。
    let back = parts.joined("-")
    print("joined=\(back)")
}

func demo_chars_and_compare() {
    for c in "abc" {
        print(__syx_value_description(c))
    }

    let w = "syx"
    let first: Character = w[0]
    let second = w[1]
    print(__syx_value_description(first))
    print(__syx_value_description(second))

    let a1 = "Hello"
    let a2 = ", World"
    let a3 = a1 + a2
    let a4 = "\(a1)\(a2)!"
    print(a3)
    print(a4)

    print("abc" == "abc")
    // note: 字符串字典序比较 `<` 结果在当前运行时可能不符合预期，仅演示 ==。
}

func main() {
    print("chapter 04: strings and characters")
    demo_literals()
    demo_methods()
    demo_chars_and_compare()
}
