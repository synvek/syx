// =============================================================================
// tutorial/22-extensions.sy
// Extensions: methods and computed properties on custom types.
// note: extending Int/String/Array builtins may not dispatch at runtime —
//       demos use custom classes. Prefer { (x) in ... } closures.
// =============================================================================

class Num {
    var value: Int
    init(value: Int) { self.value = value }
}

extension Num {
    func doubled() -> Int { return self.value + self.value }
    var isEven: Bool {
        get { return self.value % 2 == 0 }
    }
    var squared: Int {
        get { return self.value * self.value }
    }
}

class Vec2 {
    var x: Double
    var y: Double
    init(x: Double, y: Double) {
        self.x = x
        self.y = y
    }
}

extension Vec2 {
    func lengthSquared() -> Double {
        return self.x * self.x + self.y * self.y
    }
    func describe() -> String {
        return "Vec2(\(self.x), \(self.y))"
    }
}

protocol DescribableExt {
    func describe() -> String {
        return "?"
    }
}

class UserX: DescribableExt {
    var firstName: String
    var lastName: String
    init(first: String, last: String) {
        self.firstName = first
        self.lastName = last
    }
    func describe() -> String {
        return self.firstName + " " + self.lastName
    }
}

extension UserX {
    func greeting() -> String {
        return "Hello, " + self.firstName + " " + self.lastName
    }
}

class IntBag {
    var items: Array<Int>
    init(items: Array<Int>) { self.items = items }
}

extension IntBag {
    func sum() -> Int {
        var s = 0
        for x in self.items { s = s + x }
        return s
    }
    func product() -> Int {
        var p = 1
        for x in self.items { p = p * x }
        return p
    }
}

func main() {
    let n = Num(value: 5)
    print("doubled=\(n.doubled()) even=\(Num(value: 4).isEven) squared=\(n.squared)")

    let v = Vec2(x: 3.0, y: 4.0)
    print(v.describe())
    print("len2=\(v.lengthSquared())")

    let u = UserX(first: "Alice", last: "Wang")
    print(u.describe())
    print(u.greeting())

    let bag = IntBag(items: [1, 2, 3, 4, 5])
    print("sum=\(bag.sum()) product=\(bag.product())")

    // HOF with paren-in closures
    let doubled = [1, 2, 3].map({ (x) in return x * 2 })
    print(doubled)
}
