// =============================================================================
// tutorial/11-properties.sy
// Corresponds to Chapter 11 "Properties" of the *SYX Language Guide*
//
// Runnable demos: stored properties, static properties, computed properties get/set, willSet/didSet, lazy.
// note: Swift-style `struct { var x }` is unsupported -> use class / data class.
// note: Computed properties on extension / the @Published observation chain are limited in this runtime, so they are omitted here.
// =============================================================================

// 1) Stored properties (class + init)
class Person {
    var name: String
    let id: Int
    init(name: String, id: Int) {
        self.name = name
        self.id = id
    }
}

// 2) data class record
data class Settings(theme: String, version: Int)

// 3) Static properties
class Config {
    static var debug: Bool = false
    static let version: Int = 116
    static var name: String = "SYX"
}

func demoStatic() {
    print(Config.version)
    Config.debug = true
    print(Config.debug)
    print(Config.name)
}

// 4) Computed property get / set
class Circle {
    var radius: Double
    init(radius: Double) {
        self.radius = radius
    }
    var area: Double {
        get { return 3.14159 * self.radius * self.radius }
        set { self.radius = newValue / 3.14159 }
    }
    var diameter: Double {
        get { return self.radius * 2.0 }
    }
}

func demoComputed() {
    let c = Circle(radius: 2.0)
    print(c.area)
    print(c.diameter)
    c.area = 12.56636
    print(c.radius)
}

// 5) willSet / didSet
class Counter {
    var value: Int
        willSet { print("willSet") }
        didSet { print("didSet") }
    init(value: Int) {
        self.value = value
    }
}

func demoObservers() {
    let c = Counter(value: 0)
    c.value = 7
    c.value = 100
    print(c.value)
}

// 6) lazy (initialized on first access)
class HeavyResource {
    lazy var buffer: Array<Int> = [0, 1, 2]
    init() {}
}

func demoLazy() {
    let h = HeavyResource()
    print(h.buffer.count)
    print(h.buffer[1])
}

// 7) Static computed
class MathConst {
    static let pi: Double = 3.14159265358979
    static var tau: Double {
        get { return MathConst.pi * 2.0 }
    }
}

// 8) Thermometer: read-write computed property
class Thermometer {
    var celsius: Double
    init(celsius: Double) {
        self.celsius = celsius
    }
    var fahrenheit: Double {
        get { return self.celsius * 9.0 / 5.0 + 32.0 }
        set { self.celsius = (newValue - 32.0) * 5.0 / 9.0 }
    }
}

func demoTemp() {
    let t = Thermometer(celsius: 100.0)
    print(t.fahrenheit)
    t.fahrenheit = 32.0
    print(t.celsius)
}

func main() {
    let p = Person(name: "Ada", id: 1)
    print(p.name)
    print(p.id)

    let s = Settings(theme: "light", version: 1)
    print(s.theme)
    print(s.version)

    demoStatic()
    demoComputed()
    demoObservers()
    demoLazy()
    print(MathConst.pi)
    print(MathConst.tau)
    demoTemp()
}
