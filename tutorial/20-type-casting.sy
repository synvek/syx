// =============================================================================
// tutorial/20-type-casting.sy
// 对应《SYX 语言指南》第 20 章「类型转换」
//
// 可运行演示：数值提升、as / as?、类层次 is / as?、字面量类型。
// note: as!、异构 Array<Any>、协议存在性 cast、Int8.from 工厂在本教程中省略或受限。
// =============================================================================

func numericPromotion() {
    let x: Int = 1
    print(x + 1.5)

    let a: Double = 1.0 + 2.0
    print(a)

    let z8: Int8 = 1
    let zi: Int = 100
    print(z8 + zi)
}

func narrowingAndAs() {
    let n: Int = 8
    print(n as Int8)
    print(n as? Int8)

    let big: Int = 128
    print(big as? Int8)

    let n8: Int8 = 8
    print(n8 as Int)

    let d: Double = 1.5
    print(d as Int)
    print(d as Int8)
    print(d as? Int8)
}

class Animal {
    var tag: String = "animal"
}
class Dog2: Animal {
    var barkCount: Int = 0
    func bark() {
        self.barkCount = self.barkCount + 1
        print("woof")
    }
}
class Cat2: Animal {
    func meow() {
        print("meow")
    }
}

func isCheck() {
    let dog = Dog2()
    let cat = Cat2()
    print(dog is Dog2)
    print(dog is Animal)
    print(cat is Cat2)
    print(cat is Dog2)

    let a: Animal = Dog2()
    print(a is Dog2)
    print(a is Cat2)
}

func asOptional() {
    let a: Animal = Dog2()
    let d = a as? Dog2
    print(d is Dog2)
    let c = a as? Cat2
    print(c is Cat2)

    let dog = Dog2()
    dog.bark()
}

func literalInference() {
    let a = 42
    let b: Int8 = 42
    let c = 3.14
    let e = "hello"
    let f = true
    let h: Int? = nil
    print(a)
    print(b)
    print(c)
    print(e)
    print(f)
    print(h)
}

func numericConversion() {
    let a: Int = 42
    let b = a as Int8
    print(b)
    // note: Int as Double 可能失败 → 用算术提升
    let widened = a + 0.0
    print(widened)

    let d: Double = 3.14
    let i = d as Int
    print(i)
}

func optionalWrap() {
    let i: Int = 42
    let o: Int? = i
    let n: Int? = nil
    print(o)
    print(n)
    let v = n ?? 99
    print(v)
}

func main() {
    numericPromotion()
    narrowingAndAs()
    isCheck()
    asOptional()
    literalInference()
    numericConversion()
    optionalWrap()
}
