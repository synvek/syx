// ----- 9) DI 容器使用 -----
//
// import Di
// func main() {
//     Di.setProfile("dev")
//     let svc = Di.resolve(UserService.self)
//     print(svc?.getUser(1)?.name ?? "none")
// }

// ----- 10) 完整使用示例（综合） -----
func main() {
    print("=== macros demo ===")

    // 1) @Equatable / @Hashable 派生
    let p1 = Point3D(x: 1, y: 2, z: 3)
    let p2 = Point3D(x: 1, y: 2, z: 3)
    print("p1 == p2 = \(p1 == p2)")                      // true

    // 2) @resultBuilder 列表
    print("list=\(list)")

    // 3) DI 容器解析（需 import Di）
    // let svc = resolve(UserService.self)
    // print(svc?.getUser(1)?.name ?? "none")

    // 4) AOP
    let us = UserService()
    us.userRepo = UserRepository()
    let u = us.getUser(1)
    print("user=\(u?.name ?? "none")")
}
