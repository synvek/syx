// =============================================================================
// tutorial/19-macros.sy
// Corresponds to Chapter 19 "Macros" of the *SYX Language Guide*
//
// Minimal runnable demo: Service DI (@Service + Di.resolve).
// note: #assert / #stringify / @resultBuilder / full AOP require a macro package or special startup config.
// note: Conformance macros like @Equatable are supported for data class, but this file focuses on the runnable DI path.
// =============================================================================

import Di

data class Point3D(x: Int, y: Int, z: Int)

data class UserDTO(id: Int, name: String, email: String, active: Bool)

@Service
class UserRepository {
    init() {}
    func find(_ id: Int) -> String {
        if id == 1 {
            return "Alice"
        }
        return "none"
    }
}

@Service
class UserService {
    init() {}
    func getUser(_ id: Int) -> String {
        let repo = Di.resolve("UserRepository")
        return repo.find(id)
    }
}

@Service
class Greeter {
    init() {}
    func hello() -> String {
        return "hi-from-di"
    }
}

func main() {
    print("macros-demo")

    // data class can still be used as a plain record (constructible without a macro)
    let p1 = Point3D(x: 1, y: 2, z: 3)
    let p2 = Point3D(x: 1, y: 2, z: 3)
    print(p1.x)
    print(p2.z)

    let u = UserDTO(id: 1, name: "Alice", email: "a@x.com", active: true)
    print(u.name)
    print(u.active)

    let g = Di.resolve("Greeter")
    print(g.hello())

    let svc = Di.resolve("UserService")
    print(svc.getUser(1))
    print(svc.getUser(99))

    Di.destroy()
}
