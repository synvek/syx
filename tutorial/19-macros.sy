// =============================================================================
// tutorial/19-macros.sy
// 对应《SYX 语言指南》第 19 章「宏」
//
// 最小可运行演示：Service DI（@Service + Di.resolve）。
// note: #assert / #stringify / @resultBuilder / 完整 AOP 需宏包或特殊启动配置。
// note: @Equatable 等 conformance 宏对 data class 有支持，但本文件聚焦 DI 可运行路径。
// =============================================================================

import Di

data class Point3D(x: Int, y: Int, z: Int)

data class UserDTO(id: Int, name: String, email: String, active: Bool)

@Service
class UserRepository {
    init() {}
    func find(_ id: Int) -> String {
        if id == 1 {
            return "Alice"
        }
        return "none"
    }
}

@Service
class UserService {
    init() {}
    func getUser(_ id: Int) -> String {
        let repo = Di.resolve("UserRepository")
        return repo.find(id)
    }
}

@Service
class Greeter {
    init() {}
    func hello() -> String {
        return "hi-from-di"
    }
}

func main() {
    print("macros-demo")

    // data class 仍可作普通记录使用（无需宏即可构造）
    let p1 = Point3D(x: 1, y: 2, z: 3)
    let p2 = Point3D(x: 1, y: 2, z: 3)
    print(p1.x)
    print(p2.z)

    let u = UserDTO(id: 1, name: "Alice", email: "a@x.com", active: true)
    print(u.name)
    print(u.active)

    let g = Di.resolve("Greeter")
    print(g.hello())

    let svc = Di.resolve("UserService")
    print(svc.getUser(1))
    print(svc.getUser(99))

    Di.destroy()
}
