// =============================================================================
// tutorial/29-modules-and-packages.sy
// Modules & packages: single-file import of built-in Math / Crypto.
// note: multi-file syx.toml / git / registry deps are project-level — comments only.
// =============================================================================

import Math
import Crypto

// Conceptual project layout (not required for this demo):
//   my-app/
//   ├── syx.toml
//   ├── main.sy
//   └── lib/math.sy
//
// syx.toml [dependencies] path / git / registry entries resolve via `syx install`.
// Cross-module: only `public` symbols are visible (S005 otherwise).

func builtinDemo() {
    print(Math.add(1, 2))
    print(Math.sqrt(4.0))
    print(Math.min(10, 20))
    print(Crypto.sha256("data"))
}

func main() {
    builtinDemo()
    print("modules demo done")
}
