// =============================================================================
// tutorial/16-deinitialization.sy
// 对应《SYX 语言指南》第 16 章「析构过程」
//
// 可运行演示：class deinit、引用共享、嵌套对象、静态计数。
// note: actor deinit、弱引用、enum/struct deinit 不支持或受限。
// =============================================================================

// 1) 基础 deinit
class Resource {
    var id: Int
    init(id: Int) {
        self.id = id
        print("init Resource")
    }
    deinit {
        print("deinit Resource")
    }
}

func basicDeinit() {
    let r = Resource(id: 1)
    print(r.id)
}

// 2) 多个引用共享同一对象
class Shared {
    var tag: String
    init(tag: String) {
        self.tag = tag
        print("init Shared")
    }
    deinit {
        print("deinit Shared")
    }
}

func refcountDemo() {
    let a = Shared(tag: "A")
    let b = a
    let c = a
    print(a === b)
    print(b === c)
    print(a.tag)
}

// 3) 嵌套对象
class Inner {
    var name: String
    init(name: String) {
        self.name = name
    }
    deinit {
        print("deinit Inner")
    }
}

class Outer {
    var inner: Inner
    init(name: String) {
        self.inner = Inner(name: name)
    }
    deinit {
        print("deinit Outer")
    }
}

func nestedDeinit() {
    let o = Outer(name: "deep")
    print(o.inner.name)
}

// 4) 静态计数跟踪存活实例
class Tracked {
    static var live: Int = 0
    var id: Int
    init(id: Int) {
        self.id = id
        Tracked.live = Tracked.live + 1
    }
    deinit {
        Tracked.live = Tracked.live - 1
    }
}

func trackDemo() {
    print(Tracked.live)
    let a = Tracked(id: 1)
    print(Tracked.live)
    let b = Tracked(id: 2)
    print(Tracked.live)
    print(a.id)
    print(b.id)
}

// 5) 文件句柄风格资源
class FileHandle {
    var path: String
    init(path: String) {
        self.path = path
        print("opened")
    }
    deinit {
        print("closed")
    }
}

func fileDemo() {
    let h = FileHandle(path: "/tmp/a.txt")
    print(h.path)
}

// 6) 继承链 deinit（子类 deinit 先跑）
class Base3 {
    init() {}
    deinit {
        print("Base3 deinit")
    }
}
class Sub3: Base3 {
    deinit {
        print("Sub3 deinit")
    }
}

func deinitChain() {
    let s = Sub3()
    print("alive")
}

// note: data class / enum 无 deinit
data class Value(x: Int)

func main() {
    basicDeinit()
    refcountDemo()
    nestedDeinit()
    trackDemo()
    fileDemo()
    deinitChain()
    let v = Value(x: 1)
    print(v.x)
}
