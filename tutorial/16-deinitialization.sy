// =============================================================================
// tutorial/16-deinitialization.sy
// Corresponds to Chapter 16 "Deinitialization" of the *SYX Language Guide*
//
// Runnable demos: class deinit, reference sharing, nested objects, static counter.
// note: actor deinit, weak references, and enum/struct deinit are unsupported or limited.
// =============================================================================

// 1) Basic deinit
class Resource {
    var id: Int
    init(id: Int) {
        self.id = id
        print("init Resource")
    }
    deinit {
        print("deinit Resource")
    }
}

func basicDeinit() {
    let r = Resource(id: 1)
    print(r.id)
}

// 2) Multiple references share the same object
class Shared {
    var tag: String
    init(tag: String) {
        self.tag = tag
        print("init Shared")
    }
    deinit {
        print("deinit Shared")
    }
}

func refcountDemo() {
    let a = Shared(tag: "A")
    let b = a
    let c = a
    print(a === b)
    print(b === c)
    print(a.tag)
}

// 3) Nested objects
class Inner {
    var name: String
    init(name: String) {
        self.name = name
    }
    deinit {
        print("deinit Inner")
    }
}

class Outer {
    var inner: Inner
    init(name: String) {
        self.inner = Inner(name: name)
    }
    deinit {
        print("deinit Outer")
    }
}

func nestedDeinit() {
    let o = Outer(name: "deep")
    print(o.inner.name)
}

// 4) Static counter to track live instances
class Tracked {
    static var live: Int = 0
    var id: Int
    init(id: Int) {
        self.id = id
        Tracked.live = Tracked.live + 1
    }
    deinit {
        Tracked.live = Tracked.live - 1
    }
}

func trackDemo() {
    print(Tracked.live)
    let a = Tracked(id: 1)
    print(Tracked.live)
    let b = Tracked(id: 2)
    print(Tracked.live)
    print(a.id)
    print(b.id)
}

// 5) File-handle-style resource
class FileHandle {
    var path: String
    init(path: String) {
        self.path = path
        print("opened")
    }
    deinit {
        print("closed")
    }
}

func fileDemo() {
    let h = FileHandle(path: "/tmp/a.txt")
    print(h.path)
}

// 6) Inheritance-chain deinit (subclass deinit runs first)
class Base3 {
    init() {}
    deinit {
        print("Base3 deinit")
    }
}
class Sub3: Base3 {
    deinit {
        print("Sub3 deinit")
    }
}

func deinitChain() {
    let s = Sub3()
    print("alive")
}

// note: data class / enum have no deinit
data class Value(x: Int)

func main() {
    basicDeinit()
    refcountDemo()
    nestedDeinit()
    trackDemo()
    fileDemo()
    deinitChain()
    let v = Value(x: 1)
    print(v.x)
}
