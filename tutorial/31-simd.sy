// =============================================================================
// tutorial/31-simd.sy
// SIMD: SIMD4.fromArray / lane ops / SIMD4.reduceAdd (see examples/basic_demo.sy).
// note: prefer Int32 lanes; wider SIMD8/16 / mask helpers may be incomplete.
// =============================================================================

func basicSimd() {
    let v: SIMD4<Int32> = SIMD4.fromArray([1i32, 2i32, 3i32, 4i32])
    let w: SIMD4<Int32> = SIMD4.fromArray([10i32, 20i32, 30i32, 40i32])
    let s = v + w
    print(SIMD4.reduceAdd(s))
}

func vectorizedAdd() {
    let a: SIMD4<Int32> = SIMD4.fromArray([1i32, 2i32, 3i32, 4i32])
    let b: SIMD4<Int32> = SIMD4.fromArray([5i32, 6i32, 7i32, 8i32])
    let r = a + b
    print(SIMD4.reduceAdd(r))
}

func simdSubMul() {
    let a: SIMD4<Int32> = SIMD4.fromArray([10i32, 20i32, 30i32, 40i32])
    let b: SIMD4<Int32> = SIMD4.fromArray([1i32, 2i32, 3i32, 4i32])
    let d = a - b
    let p = a * b
    print(SIMD4.reduceAdd(d))
    print(SIMD4.reduceAdd(p))
}

func main() {
    basicSimd()
    vectorizedAdd()
    simdSubMul()
    print("simd demo done")
}
