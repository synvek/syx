// =============================================================================
// tutorial/32-operators-vs-host.sy
// Operators (intrinsic) vs Host APIs (Math / Hasher / Array HOF).
// note: BigInt / custom Result enum / Hasher on data class may be unavailable.
// =============================================================================

func intrinsicLayer() {
    let a = 10
    let b = 3
    print(a + b)
    print(a - b)
    print(a * b)
    print(a / b)
    print(a % b)
    print(a == b)
    print(a < b)
    print(a & b)
    print(a | b)
    print(a ^ b)
    print(a << 2)
    print(a >> 1)
    print(~a)
    print((a > 0) && (b > 0))
    print((a < 0) || (b > 0))
    print(!(a > 0))
}

func hostLayer() {
    print(Int32.min)
    print(Int32.max)
    print(Math.add(10, 20))
    print(Math.min(10, 20))

    let arr = [1, 2, 3, 4, 5]
    let doubled = arr.map({ (x) in return x * 2 })
    let evens = arr.filter({ (x) in return x % 2 == 0 })
    let s = arr.reduce(0, { (acc, x) in return acc + x })
    print(doubled)
    print(evens)
    print(s)
}

func hashableDemo() {
    var h = Hasher.newHasher()
    let n: Int = 3
    n.hash(into: h)
    print(Hasher.finalize(h))
}

func hotPath(_ a: Int, _ b: Int) -> Int {
    return (a * b + a - b) / (a + 1)
}

func warmPath(_ arr: Array<Int>) -> Int {
    let doubled = arr.map({ (x) in return x * 2 })
    return doubled.reduce(0, { (acc, x) in return acc + x })
}

// Path choice (conceptual):
//   + - * / == < & | <<   → Operator Intrinsic (direct codegen)
//   Math.* / Array.map    → Host Explicit (__syx_* calls)

func main() {
    intrinsicLayer()
    hostLayer()
    hashableDemo()
    print(hotPath(3, 4))
    print(warmPath([1, 2, 3, 4, 5]))
    print("operators-vs-host demo done")
}
