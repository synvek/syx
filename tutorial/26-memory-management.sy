// =============================================================================
// tutorial/26-memory-management.sy
// Memory: ARC for class, shared refs, deinit, data class immutability.
// note: avoid &mut / weak / actor Task demos if unsupported; keep class refs.
// =============================================================================

class Node {
    var id: Int
    init(id: Int) {
        self.id = id
        print("init Node(\(id))")
    }
    deinit { print("deinit Node(\(self.id))") }
}

func arcDemo() {
    let a = Node(id: 1)
    let b = a
    print(a === b)
    print(a.id)
}

class Holder {
    var value: Int
    init(v: Int) { self.value = v }
    func bump() { self.value = self.value + 1 }
}

func holderDemo() {
    let h = Holder(v: 1)
    h.bump()
    h.bump()
    print(h.value)
}

func arrayLocalDemo() {
    var big: Array<Int> = []
    var i = 0
    while i < 100 {
        big.append(i)
        i = i + 1
    }
    print(big.count)
    big = []
    print(big.count)
}

func stringDemo() {
    let s1 = "hello"
    let s2 = "hello"
    print(s1 == s2)
}

data class Immutable(id: Int, name: String)

func immutableDemo() {
    let u = Immutable(id: 1, name: "Alice")
    print(u.description())
    print(u.id)
    print(u.name)
}

func noCapture() {
    // HOF-style: pass closure to map (standalone typed closure params are limited)
    let doubled = [21].map({ (x) in return x * 2 })
    print(doubled)
}

func main() {
    arcDemo()
    holderDemo()
    arrayLocalDemo()
    stringDemo()
    immutableDemo()
    noCapture()
    print("memory demo done")
}
