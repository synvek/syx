// =============================================================================
// tutorial/15-initialization.sy
// Corresponds to Chapter 15 "Initialization" of the *SYX Language Guide*
//
// Runnable demos: designated init, data class construction, multi-parameter init, inherited field assignment.
// note: super.init / init? / actor init / throws init / self.init delegation are currently limited.
// note: Multi-label overload resolution is unstable -> keep only one clear init per type.
// =============================================================================

// 1) Basic class init
class Greeter {
    var name: String
    var greeting: String
    init(name: String, greeting: String) {
        self.name = name
        self.greeting = greeting
    }
}

func basicInit() {
    let g1 = Greeter(name: "SYX", greeting: "Hello")
    let g2 = Greeter(name: "World", greeting: "Hi")
    print(g1.greeting)
    print(g1.name)
    print(g2.greeting)
    print(g2.name)
}

// 2) Explicit defaults written inside init (avoid multi-overload label clashes)
class Counter {
    var value: Int
    var step: Int
    init(value: Int, step: Int) {
        self.value = value
        self.step = step
    }
}

func counterInit() {
    let c0 = Counter(value: 0, step: 1)
    print(c0.value)
    print(c0.step)
    let c1 = Counter(value: 10, step: 2)
    print(c1.value)
    print(c1.step)
}

// 3) data class field construction
data class Point(x: Int, y: Int)
data class User(id: Int, name: String, email: String)

func dataClassInit() {
    let p = Point(x: 1, y: 2)
    print(p.x)
    print(p.y)
    let u = User(id: 1, name: "Alice", email: "a@x.com")
    print(u.id)
    print(u.name)
    print(u.description())
}

// 4) Inheritance: subclass default field + later assignment (no super.init)
class Animal {
    var name: String = "anon"
}
class Dog: Animal {
    var breed: String = "unknown"
}

func inheritInit() {
    let d = Dog()
    d.name = "Rex"
    d.breed = "Lab"
    print(d.name)
    print(d.breed)
}

// 5) Two-phase: assign all stored first, then use
class Car {
    var brand: String
    var maxSpeed: Int
    var wheels: Int
    init(brand: String, maxSpeed: Int, wheels: Int) {
        self.brand = brand
        self.maxSpeed = maxSpeed
        self.wheels = wheels
    }
}

func carInit() {
    let c = Car(brand: "Tesla", maxSpeed: 250, wheels: 4)
    print(c.brand)
    print(c.wheels)
    print(c.maxSpeed)
}

// 6) Server config
class Server {
    var host: String
    var port: Int
    var secure: Bool
    init(host: String, port: Int, secure: Bool) {
        self.host = host
        self.port = port
        self.secure = secure
    }
}

// 7) Compute derived values at construction
class CircleInit {
    var radius: Double
    var area: Double
    init(radius: Double) {
        self.radius = radius
        self.area = 3.14159 * radius * radius
    }
}

// 8) Use Optional to express failure (instead of init?)
func makePort(_ number: Int) -> Int? {
    if number < 1 {
        return nil
    }
    if number > 65535 {
        return nil
    }
    return number
}

func failableDemo() {
    let p1 = makePort(80)
    let p2 = makePort(70000)
    print(p1)
    print(p2)
}

func main() {
    basicInit()
    counterInit()
    dataClassInit()
    inheritInit()
    carInit()

    let s = Server(host: "0.0.0.0", port: 9000, secure: true)
    print(s.host)
    print(s.port)
    print(s.secure)

    let circle = CircleInit(radius: 5.0)
    print(circle.radius)
    print(circle.area)

    failableDemo()
}
