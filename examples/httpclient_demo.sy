import Networking

func tryLocalServer() {
    let base = "http://127.0.0.1:8765"
    print("--- local server ---")
    let health = Http.get(url: "\(base)/health")
    print("GET /health -> \(health.status)")
    print(health.body)
    let echo = Http.get(url: "\(base)/echo")
    print("GET /echo -> \(echo.status)")
    print(echo.body)
}

func tryRemoteApi() {
    print("--- httpbin.org ---")
    let resp = Http.fetch(url: "https://httpbin.org/get?from=syx")
    print("GET /get -> \(resp.status)")
    print(resp.body)
    let posted = Http.post(url: "https://httpbin.org/post", body: "{\"hello\":\"SYX\"}")
    print("POST /post -> \(posted.status)")
    print(posted.body)
}

func main() {
    do {
        tryLocalServer()
    } catch (localErr) {
        print("local server not reachable (start examples/httpserver.sy first)")
    }
    do {
        tryRemoteApi()
    } catch (remoteErr) {
        print("remote request skipped (network unavailable)")
    }
}
