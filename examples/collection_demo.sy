func test002() {
    let int1: Int8 = 8
    let int2: Int = 8

    print("Set demo")
    let s1: Set<Int> = [1, 2,3]
    print(s1.count)
    s1.insert(2)
    print(s1.count)
    let s2: Set<Int> = Set()
    s2.insert(1)
    s2.insert(1)
    s2.insert(3)
    print(s2.count)
    let s3: Set<Int> = []
    s3.insert(1)
    s3.insert(2)
    s3.insert(1)
    print(s3.count)
}

func test001() {
    print("Dictionary demo")
    let d: Dictionary<String, Int> = {"a": 1, "b": 2}
    d["abc"] = 33
    print(d.count)    
    print("Array demo")
    let c: Array<Int> = [3,4]
    print(c.count)
}

