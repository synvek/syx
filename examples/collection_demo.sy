func main() {
    test001()
    test002()
    test003()
    test004()
    test005()
    test006()
}

func test006() {
    let int1: Double = 8.0
    let int2: Double = 8.0

    print("Dict demo 6")
    var s2: Dictionary<String, Double> = {}
    print(s2.count)
    s2["A"] = int1 
    print(s2.count)
    s2["B"] = int2
    // Dictionary has no append (Array API); would be S002 in semantic / LSP.
    // s2.append(2.0)
    print(s2.count)
}

func test005() {
    let int1: Double = 8.0
    let int2: Double = 8.0

    print("Array demo 5")
    let s2: Array<Double> = []
    print(s2.count)
    s2.append(2)
    print(s2.count)
    //s2.append("2")
    //print(s2.count)
    s2.append(2.0)
    print(s2.count)
}

func test004() {
    let int1: Double = 8.0
    let int2: Double = 8.0

    print("Set demo 4")
    let s1: Set<Double> = []
    print(s1.count)
    s1.insert(2)
    print(s1.count)
    //s1.insert("2")
    //print(s1.count)
    s1.insert(2.0)
    print(s1.count)
}

