import Sql

func bump(c: Int, left: Int) {
    if left > 0 {
        Sql.execOn(connId: c, sql: "INSERT INTO t VALUES (1)")
        bump(c: c, left: left - 1)
    }
}

func main() {
    try {
        let c = Sql.open(dsn: ":memory:")
        Sql.execOn(connId: c, sql: "CREATE TABLE t(id INTEGER)")
        bump(c: c, left: 5)
        Sql.close(connId: c)
        print("ok")
        print(5)
    } catch (e) {
        print("UNEXPECTED")
        print(e.message)
    }
}

