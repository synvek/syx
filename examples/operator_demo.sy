func main() {
    let a: Int = 0b1100                        // 12
    let b: Int = 0b1010                        // 10

    print(a & b)                                // 8  (0b1000)
    print(a | b)                                // 14 (0b1110)
    print(a ^ b)                                // 6  (0b0110)
    print(~a)                                   // -13
    print(a << 2)                               // 48
    print(a >> 1)                               // 6
}

