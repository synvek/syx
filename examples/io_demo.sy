import System
import Networking

func main() {
    let home = Env.get(key: "HOME")
    print(home)
    let cfg = FilePath.join(a: ".", b: "syx.toml")
    print(FilePath.normalize(path: cfg))
    print(FilePath.exists(path: cfg))
    let built = Url.build(base: "https://api.example.com", path: "/v1/status", query: {"q": "syx"})
    print(built)
    let t0 = Time.nowMs()
    Time.sleepMs(ms: 10)
    print(Time.nowMs() - t0)
}
