import Linalg

func main() {
    let a = Mat.from([1.0, 2.0, 3.0, 4.0], rows: 2, cols: 2)
    let t = a.transposed()
    let tp = t.packed()
    print(tp[0])
    print(tp[1])
    print(tp[2])
    print(tp[3])
    let b = Mat.from([5.0, 6.0], rows: 2, cols: 1)
    let h = a.hstack(b)
    let hp = h.packed()
    print(h.rows)
    print(h.cols)
    print(hp[0])
    print(hp[1])
    print(hp[2])
    print(hp[3])
    print(hp[4])
    print(hp[5])
    let top = a.takeRows(1)
    let tp2 = top.packed()
    print(tp2[0])
    print(tp2[1])
    let rightDropped = a.dropCols(1)
    let rp = rightDropped.packed()
    print(rp[0])
    print(rp[1])
    let still = a.packed()
    print(still[0])
    print(still[1])
    print(still[2])
    print(still[3])
}
