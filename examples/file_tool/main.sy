import System

func main() {
    let path = FilePath.normalize(path: FilePath.join(a: "/tmp", b: "syx_file_tool.txt"))
    do {
        let wh = FileHandle.open(path: path, mode: "w")
        let _ = FileHandle.write(handle: wh, bytes: [65u8, 66u8, 67u8])
        FileHandle.close(handle: wh)
        let rh = FileHandle.open(path: path, mode: "r")
        let bytes = FileHandle.readAllBytes(handle: rh)
        FileHandle.close(handle: rh)
        print("ok")
        print(bytes.count)
        print(FilePath.exists(path: path))
    } catch (e) {
        print("UNEXPECTED")
        print(e)
    }
}

