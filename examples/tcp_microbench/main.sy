import Net

/// M2 W47 / ADR-191: EC-M2-4 Tcp Instant micro-benchmark first tier.
/// TcpStream.connect refuse loop (no bare hosts; no listener).
/// W901: while + non-empty catch for CST-first format / comment trivia.

func main() {
    var i = 0
    while i < 100 {
        try {
            let _ = TcpStream.connect(host: "127.0.0.1", port: 1)
            print("UNEXPECTED")
        } catch (e) {
            print("refused")
        }
        i += 1
    }
    print("ok")
    print(100)
}
