import System

func main() {
    print(ProcessInfo.processorCount)
    do {
        print(ProcessInfo.memoryTotal())
    } catch (e) {
        print("memoryTotal-unavailable")
    }
    do {
        print(ProcessInfo.memoryAvailable())
    } catch (e) {
        print("memoryAvailable-unavailable")
    }
    do {
        print(ProcessInfo.userName())
    } catch (e) {
        print("userName-unavailable")
    }
    do {
        print(ProcessInfo.homeDir())
    } catch (e) {
        print("homeDir-unavailable")
    }
    do {
        print(ProcessInfo.hostname())
    } catch (e) {
        print("hostname-unavailable")
    }
    do {
        print(ProcessInfo.uptimeMs())
    } catch (e) {
        print("uptimeMs-unavailable")
    }
}
