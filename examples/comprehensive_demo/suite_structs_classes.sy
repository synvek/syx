// suite_structs_classes.sy — structs and classes: struct construction / fields / value-semantics copy / mutating,
// class single-property init / methods / reference semantics, final class, data class + @Equatable.
// Corresponds to chapter 10 of the language guide. struct construction requires labels; init parameter
// assignment for classes with multiple stored properties is buggy, so classes are tested with a single
// property only. Type names are globally unique; prefix Sc.

struct ScPoint {
    var x: Int
    var y: Int
}

struct ScCounter {
    var value: Int = 0
    mutating func increment() { value = value + 1 }
}

class ScGreeter {
    var name: String
    init(name: String) { self.name = name }
    func hello() -> String { return "Hi \(self.name)" }
}

final class ScToken {
    let value: String
    init(value: String) { self.value = value }
}

// data class without @Equatable here: on the current build the @Equatable macro conflicts with
// generic-enum monomorphization (Self unresolved); synthesized == is covered in the macros suite
// (which avoids generic-enum monomorphization).
data class ScUser(name: String, age: Int)

func runStructsClasses() -> (Int, Int, Int) {
    beginSuite("lang.structs_classes")

    // struct construction (labeled) and field access
    let p = ScPoint(x: 1, y: 2)
    check("struct_field_x", p.x == 1)
    check("struct_field_y", p.y == 2)

    // struct value semantics: assignment copies; mutating the copy leaves the original unchanged
    var a = ScPoint(x: 1, y: 1)
    var b = a
    b.x = 9
    check("struct_value_copy_orig", a.x == 1)
    check("struct_value_copy_mut", b.x == 9)

    // mutating method
    var c = ScCounter()
    c.increment()
    c.increment()
    check("mutating_method", c.value == 2)

    // class single-property init and method
    let g = ScGreeter(name: "World")
    check("class_init_method", g.hello() == "Hi World")

    // class reference semantics: shared reference
    let g2 = g
    g2.name = "SYX"
    check("class_reference_semantics", g.name == "SYX")

    // final class
    let t = ScToken(value: "abc")
    check("final_class", t.value == "abc")

    // data class construction and fields (synthesized == covered in the macros suite)
    let u1 = ScUser(name: "A", age: 30)
    check("data_class_field", u1.name == "A")
    check("data_class_field_age", u1.age == 30)
    skipCase("data_class_eq", "@Equatable conflicts with generic enum monomorphization; see the macros suite")

    return endSuite()
}