// suite_collections.sy — 集合：Array（append/count/contains/sorted/reverse/下标/HOF）、
// Dictionary（字面量/下标/containsKey/keys/values/remove）、Set（insert 去重/contains/remove/union）。
// 对应语言指南第 05 章。Array 无 isEmpty/first/last；Dictionary 下标须 Int 键壳见文档。

func runCollections() -> (Int, Int, Int) {
    beginSuite("lang.collections")

    // Array 基本
    var a = [3, 1, 2]
    check("array_count", a.count == 3)
    a.append(5)
    check("array_append", a.count == 4)
    check("array_contains", a.contains(2))
    check("array_contains_false", a.contains(99) == false)
    check("array_subscript", a[1] == 1)
    a[0] = 9
    check("array_subscript_assign", a[0] == 9)

    // Array 排序/反转（返回新数组）
    let sorted = [3, 1, 2].sorted()
    check("array_sorted", sorted[0] == 1)
    check("array_sorted_last", sorted[2] == 3)
    let rev = [1, 2, 3].reverse()
    check("array_reverse", rev[0] == 3)

    // Array HOF
    let nums = [1, 2, 3, 4]
    check("array_map", nums.map({ x in x * 2 })[3] == 8)
    check("array_filter", nums.filter({ x in x % 2 == 0 }).count == 2)
    check("array_reduce", nums.reduce(0, { acc, x in acc + x }) == 10)

    // Array 字素拼接
    check("array_joined", ["a", "b", "c"].joined("-") == "a-b-c")

    // 空数组
    let empty: Array<Int> = []
    check("array_empty_count", empty.count == 0)

    // Dictionary 字面量与访问
    let d = ["a": 1, "b": 2]
    check("dict_count", d.count == 2)
    check("dict_subscript", d["a"] == 1)
    check("dict_contains_key", d.containsKey("b"))
    check("dict_contains_key_false", d.containsKey("z") == false)
    check("dict_keys", d.keys().count == 2)
    check("dict_values", d.values().count == 2)

    // Dictionary 可变与 remove
    var md = ["x": 10]
    md["y"] = 20
    check("dict_insert", md.count == 2)
    check("dict_remove", md.remove("x"))
    check("dict_after_remove", md.count == 1)

    // Set 去重
    var s = Set<Int>()
    s.insert(1)
    s.insert(2)
    s.insert(1)
    check("set_dedup", s.count == 2)
    check("set_contains", s.contains(2))
    check("set_remove", s.remove(1))
    check("set_after_remove", s.count == 1)

    // Set 运算
    var s1 = Set<Int>()
    s1.insert(1)
    s1.insert(2)
    var s2 = Set<Int>()
    s2.insert(2)
    s2.insert(3)
    check("set_union", s1.union(s2).count == 3)
    check("set_intersection", s1.intersection(s2).count == 1)

    return endSuite()
}