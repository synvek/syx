// suite_control_flow.sy — 控制流：if/else、if 表达式、while、repeat-while、for-in、
// break/continue、标签循环、switch（值/多模式/范围/where/default）、guard let。
// 对应语言指南第 06 章。switch 用块形式 case v { }；fallthrough 被拒绝。

func cfGuardUnwrap(_ o: Int?) -> Int {
    guard let v = o else {
        return -1
    }
    // 当前构建 guard let 不解包类型（v 仍为 Int?），用 ?? 取具体值。
    return v ?? -1
}

func runControlFlow() -> (Int, Int, Int) {
    beginSuite("lang.control_flow")

    // if / else if / else
    var branch = ""
    let x = 0
    if x > 0 { branch = "pos" } else if x == 0 { branch = "zero" } else { branch = "neg" }
    check("if_else_chain", branch == "zero")

    // if 表达式（Phase 100+）
    let label = if x > 0 { "pos" } else { "non-pos" }
    check("if_expression", label == "non-pos")

    // while
    var w = 10
    var wCount = 0
    while w > 0 {
        wCount = wCount + 1
        w = w - 1
    }
    check("while", wCount == 10)

    // repeat-while（至少执行一次）
    var r = 0
    repeat {
        r = r + 1
    } while r < 3
    check("repeat_while", r == 3)

    // for-in 数组
    var arrSum = 0
    for item in [1, 2, 3, 4] { arrSum = arrSum + item }
    check("for_in_array", arrSum == 10)

    // for-in 半开 range
    var rSum = 0
    for ri in 0..<5 { rSum = rSum + ri }
    check("for_in_range", rSum == 10)

    // break
    var bCount = 0
    for bi in 0..<100 {
        if bi == 5 { break }
        bCount = bCount + 1
    }
    check("break", bCount == 5)

    // continue
    var cSum = 0
    for ci in 0..<10 {
        if ci % 2 == 0 { continue }
        cSum = cSum + ci
    }
    check("continue", cSum == 25)

    // 标签 break（跳出外层循环）
    var outerCount = 0
    outer: for oi in 0..<10 {
        for oj in 0..<10 {
            if oj == 2 { break outer }
            outerCount = outerCount + 1
        }
    }
    check("labeled_break", outerCount == 2)

    // switch 值匹配（块形式）
    var sw = ""
    let num = 5
    switch num {
    case 1 { sw = "one" }
    case 2, 3, 5, 7 { sw = "prime" }
    default { sw = "other" }
    }
    check("switch_multi_pattern", sw == "prime")

    // switch 范围 case
    var swr = ""
    let n = 42
    switch n {
    case 0..<10 { swr = "single" }
    case 10..<100 { swr = "two" }
    default { swr = "large" }
    }
    check("switch_range", swr == "two")

    // switch where 守卫
    var swg = ""
    let g = 4
    switch g {
    case let v where v < 0 { swg = "neg" }
    case let v where v % 2 == 0 { swg = "even" }
    case let v { swg = "odd" }
    }
    check("switch_where", swg == "even")

    // switch default
    var swd = ""
    let s = "hello"
    switch s {
    case "hi" { swd = "hi" }
    default { swd = "default" }
    }
    check("switch_default", swd == "default")

    // guard let（else 必须退出）
    check("guard_some", cfGuardUnwrap(7) == 7)
    check("guard_nil", cfGuardUnwrap(nil) == -1)

    return endSuite()
}