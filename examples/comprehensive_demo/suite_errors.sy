// suite_errors.sy — 错误处理：throws/try/do-catch、错误枚举（含关联值）、
// 错误经 throws 函数向上传播、try! 强制解包。对应语言指南第 17 章。
// try? 当前触发 R007 崩溃、typed catch（catch MyErr.bad）P001 不支持，记 SKIP。前缀 Er。

enum ErError: Error {
    case bad
    case worse(code: Int)
}

func erRisky(_ x: Int) throws -> Int {
    if x < 0 { throw ErError.bad }
    if x == 0 { throw ErError.worse(code: 42) }
    return x * 2
}

func erWrap(_ x: Int) throws -> Int {
    return try erRisky(x)
}

func runErrors() -> (Int, Int, Int) {
    beginSuite("lang.errors")

    // try 正常路径
    do {
        let v1 = try erRisky(5)
        check("try_success", v1 == 10)
    } catch {
        check("try_success", false)
    }

    // throw + 通用 catch（全局 flag 观察是否进入 catch）
    var caught1 = false
    do {
        let v2 = try erRisky(-1)
        check("throw_not_reached", v2 == 0)
    } catch {
        caught1 = true
    }
    check("catch_entered", caught1)

    // 关联值错误枚举也可 throw/catch
    var caught2 = false
    do {
        let v3 = try erRisky(0)
        check("assoc_throw_not_reached", v3 == 0)
    } catch {
        caught2 = true
    }
    check("assoc_error_caught", caught2)

    // 错误经 throws 包装函数传播：正常路径
    do {
        let v4 = try erWrap(3)
        check("propagate_success", v4 == 6)
    } catch {
        check("propagate_success", false)
    }

    // 错误经 throws 包装函数传播：异常路径
    var caught3 = false
    do {
        let v5 = try erWrap(-2)
        check("propagate_not_reached", v5 == 0)
    } catch {
        caught3 = true
    }
    check("propagated_throw_caught", caught3)

    // try! 强制成功路径
    let forced = try! erRisky(4)
    check("try_bang", forced == 8)

    // 错误枚举关联值构造与模式解构
    let e = ErError.worse(code: 42)
    switch e {
    case .bad:
        check("error_enum_match", false)
    case .worse(let code):
        check("error_enum_match", code == 42)
    }

    // 已知缺口
    skipCase("try_optional", "try? 当前触发 R007 崩溃")
    skipCase("typed_catch", "catch ErError.bad 形式 P001 不支持")
    skipCase("catch_binding", "catch let e 绑定错误值未验证支持")

    return endSuite()
}