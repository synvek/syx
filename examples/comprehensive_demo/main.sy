// main.sy — 综合测试范例入口与调度器。
// 同包所有 .sy 共享命名空间：harness.sy 提供 beginSuite/check/checkMsg/skipCase/endSuite，
// 各 suite_*.sy 提供唯一入口 runXxx() -> (Int, Int, Int)。
//
// 运行：
//   syx run .                          # VM，跑全部套件
//   syx run . -- --list                # 列出套件与后端标注
//   syx run . -- --only basics,strings # 仅跑指定套件（短名/全名/组名均可）
//   syx run . -- --skip host.net       # 跳过指定套件
//   syx run . -- --backend wasm        # 声明当前后端（vm|native|wasm），不符的套件整套 SKIP
//   syx run . -- --force               # 忽略后端标注强制运行
//   syx run . -- --strict              # 有 FAIL 时以退出码 1 结束
//
// 扩展约定：新增套件 = 新建 suite_xxx.sy（定义 runXxx）+ 在 allSuites() 加名称
//           + 在 dispatch() 加一个分支；如非全后端支持，再在 backendsFor()/reasonFor() 登记。

import System

enum SuiteError: Error {
    case strictFailure
}

// === 套件注册表（名称含分组前缀 lang.* / stdlib.* / host.*）===
func allSuites() -> Array<String> {
    return [
        "lang.basics",
        "lang.operators",
        "lang.strings",
        "lang.control_flow",
        "lang.functions",
        "lang.enums",
        "lang.structs_classes",
        "lang.properties",
        "lang.inheritance",
        "lang.errors",
        "lang.generics",
        "lang.protocols",
        "lang.extensions",
        "lang.macros",
        "lang.access_control",
        "lang.memory",
        "lang.collections",
        "stdlib.math",
        "stdlib.text_json",
        "stdlib.time_path",
        "host.concurrency",
        "host.simd",
        "host.io",
        "host.net",
        "host.services"
    ]
}

// 套件支持的后端（逗号分隔），按实测标注：当前编译器 build 仅 VM 可完整运行。
// - native：17 个 lang 套件可构建（stdlib/host 阻塞于 MIR001/C020），但运行时控制流损坏：
//   if Bool 变量/String== 条件体不执行、Bool==Bool 条件与 while Bool 死循环、switch 返回 scrutinee，
//   无法产出有效用例结果，故全部标注不支持。
// - wasm：W001 If underflow、if 语句体不执行，同样全部不支持。
// 编译器修复后，将对应套件改回 "vm,native" / "vm,native,wasm" 即可（数据驱动，无需改调度逻辑）。
// 注意：native 后端 String != 返回 nil，调度器一律用 !(x == y) 等价写法。
func backendsFor(_ name: String) -> String {
    return "vm"
}

// 后端不支持时的 SKIP 原因（按后端区分；native 编译阻塞清单保留供编译器修复后参考）。
func reasonFor(_ name: String, _ backend: String) -> String {
    if backend == "wasm" { return "wasm 后端当前不可用：W001 If underflow，if 语句体不执行（编译器缺陷）" }
    if backend == "native" { return "native 运行时控制流损坏：if Bool 条件体不执行、Bool==Bool/while Bool 死循环（编译器缺陷）" }
    if name == "stdlib.math" { return "native MIR001：Double lowering 未支持" }
    if name == "stdlib.text_json" { return "native C020：Int hash(into:) 未生成" }
    if name == "stdlib.time_path" { return "native MIR001：FilePath lowering 未支持" }
    if name == "host.concurrency" { return "native MIR001：Channel；Task/actor 宿主调度未验证" }
    if name == "host.simd" { return "SIMD lowering 仅 VM 验证" }
    if name == "host.io" { return "native 宿主 IO 函数返回 nil" }
    if name == "host.net" { return "HTTP/TCP 回环依赖 VM 宿主线程" }
    if name == "host.services" { return "Logging/Metrics/Trace 宿主服务仅 VM" }
    return "未标注"
}

// 调度：按名称调用对应套件入口。
func dispatch(_ name: String) -> (Int, Int, Int) {
    if name == "lang.basics" { return runBasics() }
    if name == "lang.operators" { return runOperators() }
    if name == "lang.strings" { return runStrings() }
    if name == "lang.control_flow" { return runControlFlow() }
    if name == "lang.functions" { return runFunctions() }
    if name == "lang.enums" { return runEnums() }
    if name == "lang.structs_classes" { return runStructsClasses() }
    if name == "lang.properties" { return runProperties() }
    if name == "lang.inheritance" { return runInheritance() }
    if name == "lang.errors" { return runErrors() }
    if name == "lang.generics" { return runGenerics() }
    if name == "lang.protocols" { return runProtocols() }
    if name == "lang.extensions" { return runExtensions() }
    if name == "lang.macros" { return runMacros() }
    if name == "lang.access_control" { return runAccessControl() }
    if name == "lang.memory" { return runMemory() }
    if name == "lang.collections" { return runCollections() }
    if name == "stdlib.math" { return runStdlibMath() }
    if name == "stdlib.text_json" { return runStdlibTextJson() }
    if name == "stdlib.time_path" { return runStdlibTimePath() }
    if name == "host.concurrency" { return runConcurrency() }
    if name == "host.simd" { return runSimd() }
    if name == "host.io" { return runHostIo() }
    if name == "host.net" { return runHostNet() }
    if name == "host.services" { return runHostServices() }
    return (0, 0, 0)
}

// === 选择辅助 ===
// token 可匹配全名（lang.basics）、短名（basics）或组名（lang）。
func nameMatches(_ name: String, _ tokens: Array<String>) -> Bool {
    var t = 0
    while t < tokens.count {
        let tok = tokens[t]
        if !(tok == "") {
            if tok == name { return true }
            let parts = name.split(".")
            if parts.count == 2 {
                if tok == parts[1] { return true }
                if tok == parts[0] { return true }
            }
        }
        t = t + 1
    }
    return false
}

func containsToken(_ csv: String, _ tok: String) -> Bool {
    let parts = csv.split(",")
    var i = 0
    while i < parts.count {
        if parts[i] == tok { return true }
        i = i + 1
    }
    return false
}

func main() throws {
    let args = Process.args()
    var only = ""
    var skip = ""
    var backend = "vm"
    var list = false
    var force = false
    var strict = false

    var i = 0
    while i < args.count {
        let a = args[i]
        if a == "--only" {
            i = i + 1
            if i < args.count { only = args[i] }
        } else if a == "--skip" {
            i = i + 1
            if i < args.count { skip = args[i] }
        } else if a == "--backend" {
            i = i + 1
            if i < args.count { backend = args[i] }
        } else if a == "--list" {
            list = true
        } else if a == "--force" {
            force = true
        } else if a == "--strict" {
            strict = true
        }
        i = i + 1
    }

    let names = allSuites()

    if list {
        print("== suites ==")
        var k = 0
        while k < names.count {
            print("\(names[k])  [\(backendsFor(names[k]))]")
            k = k + 1
        }
        return
    }

    let onlyTokens = only.split(",")
    let skipTokens = skip.split(",")

    var totalPass = 0
    var totalFail = 0
    var totalSkip = 0
    var suitesRun = 0
    var suitesSkipped = 0

    var j = 0
    while j < names.count {
        // 注意：String 是按值 move 类型，数组下标 names[j] 每次返回新克隆，
        // 故直接内联 names[j] 而不缓存为局部变量；backend 用 "\(backend)" 复制传参。
        if !(only == "") && !nameMatches(names[j], onlyTokens) {
            j = j + 1
            continue
        }
        if !(skip == "") && nameMatches(names[j], skipTokens) {
            print("[SKIP] \(names[j]) (user skip)")
            suitesSkipped = suitesSkipped + 1
            j = j + 1
            continue
        }
        if !force && !containsToken(backendsFor(names[j]), "\(backend)") {
            let reason = reasonFor(names[j], "\(backend)")
            print("[SKIP] \(names[j]) (backend \(backend) unsupported: \(reason))")
            suitesSkipped = suitesSkipped + 1
            j = j + 1
            continue
        }
        let r = dispatch(names[j])
        totalPass = totalPass + r.0
        totalFail = totalFail + r.1
        totalSkip = totalSkip + r.2
        suitesRun = suitesRun + 1
        j = j + 1
    }

    print("== summary ==")
    print("suites: \(suitesRun) run, \(suitesSkipped) skipped")
    print("cases: \(totalPass) pass, \(totalFail) fail, \(totalSkip) skip")

    if strict && totalFail > 0 {
        print("RESULT: FAIL (strict)")
        throw SuiteError.strictFailure
    }
    print("RESULT: OK")
}