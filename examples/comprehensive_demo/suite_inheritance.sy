// suite_inheritance.sy — 继承：多级继承、override/super 链、super.init 初始化链、
// 基类类型多态（vtable 动态分发）、is/as? 类型检查与转换、deinit 作用域触发。
// 对应语言指南第 12 章。convenience init 当前 P001 不支持，记 SKIP。前缀 In。

var gInDeinit = 0

class InBase {
    var name: String
    init(name: String) { self.name = name }
    func speak() -> String { return "base" }
    func label() -> String { return "animal:" + self.name }
}

class InMid: InBase {
    var tag: Int
    init(name: String, tag: Int) {
        self.tag = tag
        super.init(name: name)
    }
    override func speak() -> String { return "mid:" + super.speak() }
    override func label() -> String { return "mid:" + super.label() }
}

class InLeaf: InMid {
    override func speak() -> String { return "leaf:" + super.speak() }
}

class InThing {
    var n: Int
    init(n: Int) { self.n = n }
    deinit { gInDeinit = gInDeinit + 1 }
}

func inScoped() {
    let t = InThing(n: 1)
    print("  (inScoped created \(t.n))")
}

// 多态：参数声明为基类类型，实际分发到子类 override。
func inDescribe(_ a: InBase) -> String {
    return a.speak()
}

func runInheritance() -> (Int, Int, Int) {
    beginSuite("lang.inheritance")

    // 单级继承与字段继承
    let m = InMid(name: "m", tag: 3)
    check("inherited_field", m.name == "m")
    check("own_field", m.tag == 3)

    // init 链：super.init 正确执行
    check("init_chain", m.name == "m")

    // override + super 调用链
    check("override_super", m.speak() == "mid:base")
    check("override_label", m.label() == "mid:animal:m")

    // 多级继承
    let l = InLeaf(name: "l", tag: 9)
    check("multi_level_override", l.speak() == "leaf:mid:base")
    check("multi_level_field", l.tag == 9)

    // 多态：基类类型变量动态分发
    let b: InBase = InLeaf(name: "up", tag: 1)
    check("polymorphic_dispatch", b.speak() == "leaf:mid:base")

    // 函数参数多态（注意：多字段子类临时对象直接传基类形参会损坏，
    // 须先 let 绑定再经基类类型变量传入）
    let pm = InMid(name: "p", tag: 0)
    let pb: InBase = pm
    check("param_polymorphism", inDescribe(pb) == "mid:base")

    // is 类型检查
    let c1: InBase = InLeaf(name: "c", tag: 2)
    check("is_true", c1 is InLeaf)
    let c2: InBase = InMid(name: "d", tag: 0)
    check("is_false", (c2 is InLeaf) == false)

    // as? 向下转换
    let c3: InBase = InLeaf(name: "e", tag: 7)
    if let d = c3 as? InLeaf {
        check("downcast_field", d.tag == 7)
    } else {
        check("downcast_field", false)
    }

    // deinit 作用域触发（ARC 可观察）
    gInDeinit = 0
    inScoped()
    check("deinit_on_scope_exit", gInDeinit == 1)

    // 已知缺口
    skipCase("convenience_init", "convenience 修饰符当前 P001 不支持")

    return endSuite()
}