// suite_generics.sy — generics: generic functions (single / multiple type parameters), generic structs, generic methods,
// method-level second type parameter + closure parameter, tuple returns. Corresponds to chapter 16 of the language guide.
// Constrained generics (T: Equatable/Comparable) currently fail monomorphization with C020 (Int→Int64 bodies not generated);
// generic-enum instantiation conflicts with the @Equatable macro (S002 Self); generic method map<U>+closure conflicts with
// data class synthesized init (returns an empty data class instance). All recorded as SKIP. Prefix Ge.
// Note: integer literals infer as Int64, so generic calls always pass explicit Int variables;
// generic calls must not be embedded directly in string interpolation (misinfers Int64) — bind with let first, then interpolate and compare.

func geIdentity<T>(_ x: T) -> T { return x }

func geFirst<A, B>(_ a: A, _ b: B) -> A { return a }

func geFlip<A, B>(_ a: A, _ b: B) -> (B, A) { return (b, a) }

struct GeBox<T> {
    var v: T
    func get() -> T { return self.v }
}

func runGenerics() -> (Int, Int, Int) {
    beginSuite("lang.generics")

    // Generic functions: Int / String monomorphization (generic returns are not Equatable; bind first, then compare via interpolation)
    let n: Int = 7
    let r1 = geIdentity(n)
    check("generic_fn_int", "\(r1)" == "7")
    let s = geIdentity("hi")
    check("generic_fn_string", "\(s)" == "hi")

    // Multiple type parameters (no nested string literals inside interpolation; bind first)
    let m: Int = 3
    let fst = geFirst(m, "x")
    check("generic_two_params", "\(fst)" == "3")

    // Generic tuple return (generic types are not Equatable; convert to String via interpolation to compare)
    let k: Int = 5
    let t = geFlip(k, "z")
    check("generic_tuple_return", "\(t.0)" == "z")
    check("generic_tuple_return_int", "\(t.1)" == "5")

    // Generic struct: Int / String instantiation and field access (field type T is not Equatable; compare via interpolation)
    let bi = GeBox<Int>(v: 4)
    check("generic_struct_int", "\(bi.v)" == "4")
    let bs = GeBox<String>(v: "ok")
    check("generic_struct_string", "\(bs.v)" == "ok")

    // Generic method
    let g1 = bi.get()
    check("generic_method", "\(g1)" == "4")

    // Method-level second type parameter + closure: conflicts with @Equatable data class synthesized init; recorded as SKIP
    skipCase("generic_method_map", "map<U> + closure monomorphization conflicts with data class synthesized init (returns an empty instance)")
    skipCase("generic_method_map_str", "same as above")

    // Known gaps
    skipCase("constrained_generics", "T: Equatable/Comparable monomorphization C020 (eq_Int64 not generated)")
    skipCase("generic_enum", "generic enum instantiation conflicts with the @Equatable macro (S002 Self)")
    skipCase("where_clause", "where clauses depend on constrained generics, currently unavailable")

    return endSuite()
}