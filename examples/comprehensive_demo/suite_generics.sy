// suite_generics.sy — 泛型：泛型函数（单/多类型参数）、泛型 struct、泛型方法、
// 方法级第二类型参数 + 闭包参数、元组返回。对应语言指南第 16 章。
// 约束泛型（T: Equatable/Comparable）当前单态化 C020（Int→Int64 未生成函数体），
// 泛型枚举实例化与 @Equatable 宏冲突（S002 Self），泛型方法 map<U>+闭包与 data class
// 合成 init 冲突（返回 data class 空实例），均记 SKIP。前缀 Ge。
// 注意：整数字面量推断为 Int64，泛型调用一律传显式 Int 变量；
// 泛型调用不可直接嵌在字符串插值内（误推断 Int64），须先 let 绑定再插值比较。

func geIdentity<T>(_ x: T) -> T { return x }

func geFirst<A, B>(_ a: A, _ b: B) -> A { return a }

func geFlip<A, B>(_ a: A, _ b: B) -> (B, A) { return (b, a) }

struct GeBox<T> {
    var v: T
    func get() -> T { return self.v }
}

func runGenerics() -> (Int, Int, Int) {
    beginSuite("lang.generics")

    // 泛型函数：Int / String 单态化（泛型返回值非 Equatable，先绑定再经插值比较）
    let n: Int = 7
    let r1 = geIdentity(n)
    check("generic_fn_int", "\(r1)" == "7")
    let s = geIdentity("hi")
    check("generic_fn_string", "\(s)" == "hi")

    // 多类型参数（插值内不能嵌套字符串字面量，先绑定）
    let m: Int = 3
    let fst = geFirst(m, "x")
    check("generic_two_params", "\(fst)" == "3")

    // 泛型元组返回（泛型类型非 Equatable，经插值转 String 比较）
    let k: Int = 5
    let t = geFlip(k, "z")
    check("generic_tuple_return", "\(t.0)" == "z")
    check("generic_tuple_return_int", "\(t.1)" == "5")

    // 泛型 struct：Int / String 实例化与字段访问（字段类型 T 非 Equatable，经插值比较）
    let bi = GeBox<Int>(v: 4)
    check("generic_struct_int", "\(bi.v)" == "4")
    let bs = GeBox<String>(v: "ok")
    check("generic_struct_string", "\(bs.v)" == "ok")

    // 泛型方法
    let g1 = bi.get()
    check("generic_method", "\(g1)" == "4")

    // 方法级第二类型参数 + 闭包：与 @Equatable data class 合成 init 冲突，记 SKIP
    skipCase("generic_method_map", "map<U>+闭包单态化与 data class 合成 init 冲突（返回空实例）")
    skipCase("generic_method_map_str", "同上")

    // 已知缺口
    skipCase("constrained_generics", "T: Equatable/Comparable 单态化 C020（eq_Int64 未生成）")
    skipCase("generic_enum", "泛型枚举实例化与 @Equatable 宏冲突（S002 Self）")
    skipCase("where_clause", "where 子句依赖约束泛型，当前不可用")

    return endSuite()
}