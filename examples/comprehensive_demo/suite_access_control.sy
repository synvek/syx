// suite_access_control.sy — 访问控制：public/internal/private 修饰符、
// public class 成员、跨文件共享命名空间访问（ac_helper.sy）。对应语言指南第 28/29 章。
// 实测：修饰符可解析，但 private 跨文件未强制（仍可调用），FAIL 为有效覆盖。前缀 Ac。

public func acPubFn() -> Int { return 1 }

private func acPrivFn() -> Int { return 2 }

internal func acIntFn() -> Int { return 3 }

public class AcBox {
    public var v: Int
    public init(v: Int) { self.v = v }
    public func twice() -> Int { return self.v * 2 }
}

func runAccessControl() -> (Int, Int, Int) {
    beginSuite("lang.access_control")

    // 修饰符声明与同文件调用
    check("public_func", acPubFn() == 1)
    check("private_func_same_file", acPrivFn() == 2)
    check("internal_func", acIntFn() == 3)

    // public class：构造/字段/方法
    let b = AcBox(v: 3)
    check("public_class_field", b.v == 3)
    check("public_class_method", b.twice() == 6)

    // 跨文件 public 访问（ac_helper.sy，同包共享命名空间，无需 import）
    check("cross_file_public", acHelperPub() == 42)

    // 跨文件 private 强制：acHelperPriv 在 ac_helper.sy 中声明为 private，
    // 本文件调用应被拒绝；当前实测仍可调用（未强制），FAIL 为有效覆盖。
    let leaked = acHelperPriv()
    checkMsg("private_cross_file_enforcement", leaked != 7, "private 跨文件仍可调用，返回 \(leaked)")

    // 本套件入口 runAccessControl 由 main.sy 跨文件调用，本身即模块机制验证
    check("module_dispatch_works", true)

    // 已知缺口
    skipCase("compile_negative_cases", "private 跨文件拒绝等编译期负例无法纳入可运行套件")

    return endSuite()
}