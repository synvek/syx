// suite_access_control.sy — access control: public/internal/private modifiers,
// public class members, cross-file shared-namespace access (ac_helper.sy). Corresponds to chapters 28/29 of the language guide.
// Observed: modifiers parse, but private is not enforced across files (still callable); the FAIL is valid coverage. Prefix Ac.

public func acPubFn() -> Int { return 1 }

private func acPrivFn() -> Int { return 2 }

internal func acIntFn() -> Int { return 3 }

public class AcBox {
    public var v: Int
    public init(v: Int) { self.v = v }
    public func twice() -> Int { return self.v * 2 }
}

func runAccessControl() -> (Int, Int, Int) {
    beginSuite("lang.access_control")

    // Modifier declarations and same-file calls
    check("public_func", acPubFn() == 1)
    check("private_func_same_file", acPrivFn() == 2)
    check("internal_func", acIntFn() == 3)

    // public class: construction / field / method
    let b = AcBox(v: 3)
    check("public_class_field", b.v == 3)
    check("public_class_method", b.twice() == 6)

    // Cross-file public access (ac_helper.sy; shared package namespace, no import needed)
    check("cross_file_public", acHelperPub() == 42)

    // Cross-file private enforcement: acHelperPriv is declared private in ac_helper.sy,
    // so calling it from this file should be rejected; it is currently still callable
    // (not enforced) — the FAIL is valid coverage.
    let leaked = acHelperPriv()
    checkMsg("private_cross_file_enforcement", leaked != 7, "private still callable across files, returned \(leaked)")

    // This suite's entry runAccessControl is called cross-file from main.sy, which itself verifies the module mechanism
    check("module_dispatch_works", true)

    // Known gaps
    skipCase("compile_negative_cases", "compile-time negatives such as cross-file private rejection cannot be part of a runnable suite")

    return endSuite()
}