// suite_memory.sy — 内存管理可观察行为：deinit 作用域触发、weak 引用、
// 循环引用回收观察。对应语言指南第 26/27 章（ARC/GC）。
// 实测：VM 会回收强循环（GC 式行为）；weak 不自动置 nil；全局 weak var S002。前缀 Me。

var gMeFreed = 0

class MeThing {
    var n: Int
    init(n: Int) { self.n = n }
    deinit { gMeFreed = gMeFreed + 1 }
}

class MeParent {
    var child: MeChild?
    init() {}
    deinit { gMeFreed = gMeFreed + 1 }
}

class MeChild {
    weak var parent: MeParent?
    init() {}
    deinit { gMeFreed = gMeFreed + 1 }
}

class MeStrong {
    var other: MeStrong?
    init() {}
    deinit { gMeFreed = gMeFreed + 1 }
}

class MeWeakTarget {
    var name: String
    init(name: String) { self.name = name }
}

class MeHolder {
    weak var ref: MeWeakTarget?
    init() {}
}

func meScoped() {
    let t = MeThing(n: 1)
    print("  (meScoped created \(t.n))")
}

func meWeakCycle() {
    let p = MeParent()
    let c = MeChild()
    p.child = c
    c.parent = p
}

func meStrongCycle() {
    let a = MeStrong()
    let b = MeStrong()
    a.other = b
    b.other = a
}

// target 在函数内创建并经 weak 挂到 holder，函数返回后 target 应已释放。
func meMakeLinked() -> MeHolder {
    let h = MeHolder()
    let n = MeWeakTarget(name: "target")
    h.ref = n
    return h
}

func runMemory() -> (Int, Int, Int) {
    beginSuite("lang.memory")

    // deinit 作用域触发
    gMeFreed = 0
    meScoped()
    check("deinit_scope_exit", gMeFreed == 1)

    // weak 父子链接：作用域结束两者均释放
    gMeFreed = 0
    meWeakCycle()
    check("weak_link_released", gMeFreed == 2)

    // 强循环引用：实测 VM 同样回收（GC 式行为，非纯 ARC 泄漏语义）
    gMeFreed = 0
    meStrongCycle()
    check("strong_cycle_reclaimed", gMeFreed == 2)

    // weak 自动置 nil：target 释放后 weak 应读到 nil（?? 落到 sentinel）。
    // 当前实测 weak 不置 nil（仍读到 target），FAIL 为有效覆盖。
    let h = meMakeLinked()
    let sentinel = MeWeakTarget(name: "sentinel")
    let observed = h.ref ?? sentinel
    checkMsg("weak_auto_nil", observed.name == "sentinel", "期望 sentinel，实际 \(observed.name)（weak 未自动置 nil）")

    // 已知缺口
    skipCase("global_weak_var", "全局 weak var 声明 S002 未定义")
    skipCase("unowned_reference", "unowned 引用未验证支持")

    return endSuite()
}