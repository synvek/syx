// suite_extensions.sy — 扩展：struct/class extension 加方法与计算属性、
// 内置类型（Int）extension。对应语言指南第 15 章。
// extension 追溯协议遵循的方法不分发（返回默认描述）、嵌套类型构造 C020，记 SKIP。前缀 Ex。

struct ExPoint {
    var x: Int
    var y: Int
}

extension ExPoint {
    func sum() -> Int { return self.x + self.y }
    var magnitude: Int {
        get { return self.x * self.x + self.y * self.y }
    }
}

class ExWallet {
    var cents: Int
    init(cents: Int) { self.cents = cents }
}

extension ExWallet {
    func dollars() -> Int { return self.cents / 100 }
    var doubled: Int {
        get { return self.cents * 2 }
    }
}

extension Int {
    func exSquared() -> Int { return self * self }
}

func runExtensions() -> (Int, Int, Int) {
    beginSuite("lang.extensions")

    // struct extension 方法
    let p = ExPoint(x: 3, y: 4)
    check("struct_ext_method", p.sum() == 7)

    // struct extension 计算属性
    check("struct_ext_computed", p.magnitude == 25)

    // class extension 方法
    let w = ExWallet(cents: 250)
    check("class_ext_method", w.dollars() == 2)

    // class extension 计算属性
    check("class_ext_computed", w.doubled == 500)

    // 内置类型 extension
    let n: Int = 6
    check("builtin_ext_int", n.exSquared() == 36)

    // extension 与原方法共存
    check("ext_and_original", w.cents == 250)

    // 已知缺口
    skipCase("retroactive_conformance", "extension Point: Protocol 的方法不分发（返回默认描述）")
    skipCase("nested_types", "Outer.Inner 嵌套类型构造 C020（Outer_Inner_init 未生成）")
    skipCase("opaque_boxed_types", "some/any  opaque/boxed 类型依赖 existential，当前不可用")

    return endSuite()
}