// suite_basics.sy — 语言基础：let/var、字面量、类型标注、元组、多行字符串、range、类型推断。
// 对应语言指南第 02 章。同包文件共享命名空间，无需 import；入口函数名全局唯一。
// 套件自含计数（beginSuite/endSuite），返回 (pass, fail, skip)。

func runBasics() -> (Int, Int, Int) {
    beginSuite("lang.basics")

    // let 不可变绑定
    let immutable = 42
    check("let_binding", immutable == 42)

    // var 可变绑定与重新赋值
    var mutable = 10
    mutable = 20
    check("var_reassign", mutable == 20)

    // 显式类型标注
    let x: Int = 10
    let name: String = "SYX"
    check("type_annotation_int", x == 10)
    check("type_annotation_string", name == "SYX")

    // 类型推断：首次赋值后冻结
    let n = 10
    check("type_inference", n + 5 == 15)

    // 数值字面量：进制与下划线分隔
    check("literal_hex", 0xFF == 255)
    check("literal_binary", 0b1010 == 10)
    check("literal_octal", 0o17 == 15)
    check("literal_underscore", 1_000_000 == 1000000)

    // 固定宽度整数后缀
    let small = 100i8
    let wide = 1000i64
    check("literal_suffix_i8", small == 100)
    check("literal_suffix_i64", wide == 1000)

    // 浮点：默认 Double，f32 后缀 Float32
    let d = 3.14
    let f = 3.14f32
    check("literal_double", d > 3.0)
    check("literal_float32", f > 3.0)
    check("literal_scientific", -2.5e2 == -250.0)

    // Bool 与 nil / Optional（用 ?? nil 合并检验 nil / some）
    let ok: Bool = true
    let maybe: Int? = nil
    let present: Int? = 7
    check("bool_true", ok)
    check("optional_nil", (maybe ?? -1) == -1)
    check("optional_some", (present ?? 0) == 7)

    // 元组
    let pair = (1, "two")
    check("tuple_access", pair.0 == 1)
    check("tuple_access_second", pair.1 == "two")

    // 多行字符串（当前实现保留起始换行：内容为 "\nline1\nline2\n"）
    let multi = """
line1
line2
"""
    check("multiline_string", multi.hasPrefix("\nline1"))
    check("multiline_count", multi.count == 13)

    // range
    var rangeSum = 0
    for i in 1...5 {
        rangeSum = rangeSum + i
    }
    check("closed_range", rangeSum == 15)

    // 块级作用域 shadow
    let outer = 1
    var shadowOk = false
    if true {
        let outer = 2
        shadowOk = outer == 2
    }
    check("scope_shadow", shadowOk)
    check("scope_outer_unchanged", outer == 1)

    return endSuite()
}