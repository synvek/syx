// suite_stdlib_math.sy — 标准库数学与随机：Math 函数族、Double.pi/sqrt、
// 数值转换 Int(String)、Int.random(in:)、Random.nextInt/nextUInt64。
// 实测：Double(String)/String(Int)/Int(Double) 构造器返回空对象（broken）；
// Random 无种子 API；Random.nextInt 恒 0。前缀 Sm。

import Math
import Random

func runStdlibMath() -> (Int, Int, Int) {
    beginSuite("stdlib.math")

    // Math 函数族（结果经插值比较，规避 Int64/Double 字面量类型差异）
    let a1 = Math.add(1, 2)
    check("math_add", "\(a1)" == "3")
    let a2 = Math.sqrt(16.0)
    check("math_sqrt", "\(a2)" == "4")
    let a3 = Math.abs(-5)
    check("math_abs", "\(a3)" == "5")
    let a4 = Math.min(3, 7)
    check("math_min", "\(a4)" == "3")
    let a5 = Math.max(3, 7)
    check("math_max", "\(a5)" == "7")
    let a6 = Math.pow(2.0, 10.0)
    check("math_pow", "\(a6)" == "1024")
    let a7 = Math.floor(3.7)
    check("math_floor", "\(a7)" == "3")
    let a8 = Math.ceil(3.2)
    check("math_ceil", "\(a8)" == "4")

    // Double 静态常量与方法
    let pi = Double.pi
    check("double_pi", "\(pi)".hasPrefix("3.14159"))
    let sq = Double.sqrt(x: 9.0)
    check("double_sqrt", "\(sq)" == "3")

    // 数值转换：Int(String) 可用
    let n1 = Int("42")
    check("int_from_string", (n1 ?? -1) == 42)
    let n2 = Int("abc")
    check("int_from_string_invalid", (n2 ?? -1) == -1)

    // Int.random(in:) 范围
    let r1 = Int.random(in: 100)
    check("int_random_range", r1 >= 0 && r1 < 100)

    // Random.nextUInt64：两次调用应不同
    let u1 = Random.nextUInt64()
    let u2 = Random.nextUInt64()
    check("random_uint64_varies", u1 != u2)

    // Random.nextInt：当前实测恒 0，FAIL 为有效覆盖
    let i1 = Random.nextInt()
    let i2 = Random.nextInt()
    checkMsg("random_nextInt_varies", i1 != i2, "两次 nextInt 均为 \(i1)（疑似恒 0）")

    // 已知缺口
    skipCase("random_seed", "Random 无种子固定 API（nextInt/nextUInt64/nextBytes 之外无 seed）")
    skipCase("double_from_string", "Double(\"3.5\") 构造器返回空对象")
    skipCase("string_from_int", "String(42) 构造器返回空对象")
    skipCase("int_from_double", "Int(3.9) 构造器返回空对象")

    return endSuite()
}