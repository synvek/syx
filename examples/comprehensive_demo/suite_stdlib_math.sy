// suite_stdlib_math.sy — stdlib math and randomness: Math function family, Double.pi/sqrt,
// numeric conversions Int(String), Int.random(in:), Random.nextInt/nextUInt64.
// Observed: Double(String)/String(Int)/Int(Double) constructors return empty objects (broken);
// Random has no seeding API; Random.nextInt is always 0. Prefix Sm.

import Math
import Random

func runStdlibMath() -> (Int, Int, Int) {
    beginSuite("stdlib.math")

    // Math function family (results compared via interpolation to avoid Int64/Double literal type mismatches)
    let a1 = Math.add(1, 2)
    check("math_add", "\(a1)" == "3")
    let a2 = Math.sqrt(16.0)
    check("math_sqrt", "\(a2)" == "4")
    let a3 = Math.abs(-5)
    check("math_abs", "\(a3)" == "5")
    let a4 = Math.min(3, 7)
    check("math_min", "\(a4)" == "3")
    let a5 = Math.max(3, 7)
    check("math_max", "\(a5)" == "7")
    let a6 = Math.pow(2.0, 10.0)
    check("math_pow", "\(a6)" == "1024")
    let a7 = Math.floor(3.7)
    check("math_floor", "\(a7)" == "3")
    let a8 = Math.ceil(3.2)
    check("math_ceil", "\(a8)" == "4")

    // Double static constants and methods
    let pi = Double.pi
    check("double_pi", "\(pi)".hasPrefix("3.14159"))
    let sq = Double.sqrt(x: 9.0)
    check("double_sqrt", "\(sq)" == "3")

    // Numeric conversion: Int(String) works
    let n1 = Int("42")
    check("int_from_string", (n1 ?? -1) == 42)
    let n2 = Int("abc")
    check("int_from_string_invalid", (n2 ?? -1) == -1)

    // Int.random(in:) range
    let r1 = Int.random(in: 100)
    check("int_random_range", r1 >= 0 && r1 < 100)

    // Random.nextUInt64: two calls should differ
    let u1 = Random.nextUInt64()
    let u2 = Random.nextUInt64()
    check("random_uint64_varies", u1 != u2)

    // Random.nextInt: observed to be always 0; the FAIL is valid coverage
    let i1 = Random.nextInt()
    let i2 = Random.nextInt()
    checkMsg("random_nextInt_varies", i1 != i2, "both nextInt calls returned \(i1) (appears always 0)")

    // Known gaps
    skipCase("random_seed", "Random has no seed-fixing API (no seed beyond nextInt/nextUInt64/nextBytes)")
    skipCase("double_from_string", "Double(\"3.5\") constructor returns an empty object")
    skipCase("string_from_int", "String(42) constructor returns an empty object")
    skipCase("int_from_double", "Int(3.9) constructor returns an empty object")

    return endSuite()
}