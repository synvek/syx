// suite_stdlib_time_path.sy — stdlib time and paths: Time.nowMs, Instant.now,
// DateTime.now/parseIso8601 (ADR-222 narrow calendar core), FilePath pure functions join/normalize/fileExtension/exists.
// Observed: DateTime.format(ms:) returns the ms string as-is (broken); Instant.now starts from 0. Prefix Sp.
// Note: the FilePath.exists case assumes running from the repository root (run_all.sh convention).

import System
import Text

func runStdlibTimePath() -> (Int, Int, Int) {
    beginSuite("stdlib.time_path")

    // Time.nowMs: wall clock is positive and monotonically non-decreasing
    let t1 = Time.nowMs()
    check("time_now_positive", t1 > 0)
    let t2 = Time.nowMs()
    check("time_monotonic", t2 >= t1)

    // Instant.now: monotonic ticks (currently starts from 0)
    let i1 = Instant.now()
    check("instant_nonnegative", i1 >= 0)
    let i2 = Instant.now()
    check("instant_monotonic", i2 >= i1)

    // DateTime.now: returns {iso, ms} (iso converted to String via interpolation before comparing)
    let now = DateTime.now()
    check("datetime_now_ms", now.ms > 0)
    let nowIso = "\(now.iso)"
    check("datetime_now_iso", nowIso.hasPrefix("20"))

    // DateTime.parseIso8601: known instant 2024-01-15T10:30:00Z
    let dt = DateTime.parseIso8601(text: "2024-01-15T10:30:00Z")
    check("datetime_parse_ms", dt.ms == 1705314600000)
    let dtIso = "\(dt.iso)"
    check("datetime_parse_iso", dtIso.hasPrefix("2024-01-15"))

    // DateTime.format: should output ISO text; observed to return ms as-is; the FAIL is valid coverage
    let fmt = DateTime.format(ms: 1700000000000)
    checkMsg("datetime_format_iso", fmt.hasPrefix("2023"), "format returned \(fmt) (expected ISO text for 2023-11-14)")

    // FilePath.join
    let joined = FilePath.join(a: "/tmp", b: "x.txt")
    check("path_join", joined == "/tmp/x.txt")

    // FilePath.normalize: resolves . and ..
    let norm = FilePath.normalize(path: "a/./b/../c")
    check("path_normalize", norm == "a/c")

    // FilePath.fileExtension
    let ext1 = FilePath.fileExtension(path: "a.tar.gz")
    check("path_extension", ext1 == "gz")
    let ext2 = FilePath.fileExtension(path: "noext")
    check("path_extension_none", ext2 == "")

    // FilePath.exists: this project's syx.toml (relative to the repo root; bind the Bool result first to avoid String arguments polluting the check name)
    let demoPath = FilePath.join(a: "examples/comprehensive_demo", b: "syx.toml")
    let existsOk = FilePath.exists(path: demoPath)
    check("path_exists", existsOk)
    check("path_exists_false", FilePath.exists(path: "no_such_file_xyz.txt") == false)

    // Known gaps
    skipCase("datetime_timezone", "formatWithTimezone/timezoneOffset not covered by the narrow calendar core verification")
    skipCase("datetime_parse_freeform", "DateTime.parse free-form parsing unverified")

    return endSuite()
}