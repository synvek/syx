// suite_simd.sy — SIMD：SIMD4<Int32> fromArray 构造、逐 lane + - * / %、reduceAdd 归约。
// 对应语言指南第 31 章。实测：% 归约恒 0（broken）；zero/splat/toArray 非 public（S005）。
// 后端：vm（native/wasm 视 SIMD  lowering 实测）。前缀 Sd。

import SIMD4

func runSimd() -> (Int, Int, Int) {
    beginSuite("host.simd")

    let v: SIMD4<Int32> = SIMD4.fromArray([1i32, 2i32, 3i32, 4i32])
    let w: SIMD4<Int32> = SIMD4.fromArray([10i32, 20i32, 30i32, 40i32])

    // reduceAdd 基线：1+2+3+4 = 10
    check("simd_reduce_base", SIMD4.reduceAdd(v) == 10)

    // 逐 lane 加法：[11,22,33,44] → 110
    let s = v + w
    check("simd_add", SIMD4.reduceAdd(s) == 110)

    // 逐 lane 减法：[9,18,27,36] → 90
    let d = w - v
    check("simd_sub", SIMD4.reduceAdd(d) == 90)

    // 逐 lane 乘法：[10,40,90,160] → 300
    let m = v * w
    check("simd_mul", SIMD4.reduceAdd(m) == 300)

    // 逐 lane 除法：w / [3,3,3,3] = [3,6,10,13] → 32
    let three: SIMD4<Int32> = SIMD4.fromArray([3i32, 3i32, 3i32, 3i32])
    let q = w / three
    check("simd_div", SIMD4.reduceAdd(q) == 32)

    // 逐 lane 取模：w % 3 = [1,2,0,1] → 4；当前实测恒 0，FAIL 为有效覆盖
    let r = w % three
    checkMsg("simd_mod", SIMD4.reduceAdd(r) == 4, "实际归约 \(SIMD4.reduceAdd(r))（疑似恒 0）")

    // 已知缺口
    skipCase("simd_zero_splat", "SIMD4.zero/splat 当前 S005 非 public")
    skipCase("simd_to_array", "SIMD4.toArray 当前 S005 非 public")
    skipCase("simd_mask_all_any", "比较掩码 all/any 未纳入本轮验证")
    skipCase("simd8_simd16", "SIMD8/SIMD16 宽向量未纳入本轮验证")

    return endSuite()
}