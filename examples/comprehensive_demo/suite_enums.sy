// suite_enums.sy — 枚举：简单枚举/tag、关联值（匿名/具名）、switch 解构、if case、泛型枚举。
// 对应语言指南第 09 章。枚举方法当前返回 nil（编译器缺口），改用自由函数 switch 匹配。
// indirect enum / String rawValue 未实现。类型名全局唯一，前缀 En。

enum EnStatus {
    case ok, err, pending
}

enum EnRes {
    case success(String)
    case failure(code: Int, message: String)
}

enum EnBox<T> {
    case some(T)
    case none
}

func enDescribe(_ r: EnRes) -> String {
    switch r {
    case .success(let d) { return "ok:\(d)" }
    case .failure(code: let c, message: let m) { return "fail:\(c):\(m)" }
    }
}

func enBoxValue(_ b: EnBox<Int>) -> Int {
    switch b {
    case .some(let v) { return v ?? -1 }
    case .none { return -1 }
    }
}

func runEnums() -> (Int, Int, Int) {
    beginSuite("lang.enums")

    // 简单枚举与 tag
    let s = EnStatus.ok
    check("simple_tag", s.tag == 0)
    check("simple_tag_pending", EnStatus.pending.tag == 2)

    // 关联值：匿名（enum 实例是 move 类型，每次用新构造避免复用）
    check("assoc_anonymous", enDescribe(EnRes.success("OK")) == "ok:OK")

    // 关联值：具名
    check("assoc_named", enDescribe(EnRes.failure(code: 404, message: "NF")) == "fail:404:NF")

    // switch 解构分支选择
    check("switch_branch_success", enDescribe(EnRes.success("X")) == "ok:X")
    check("switch_branch_failure", enDescribe(EnRes.failure(code: 500, message: "E")) == "fail:500:E")

    // if case
    var ifCaseOk = false
    if case .success(let d) = EnRes.success("OK") {
        ifCaseOk = d == "OK"
    }
    check("if_case", ifCaseOk)

    // 泛型枚举：声明与匹配函数可用，但实例化（单态化）与 @Equatable 宏冲突（Self 未解析），
    // 故跳过实例化用例，待编译器修复后启用。
    skipCase("generic_enum_some", "泛型枚举单态化与 @Equatable 宏冲突")
    skipCase("generic_enum_none", "泛型枚举单态化与 @Equatable 宏冲突")

    // 已知缺口
    skipCase("enum_method", "枚举方法当前返回 nil")
    skipCase("string_raw_value", "String rawValue 未实现")
    skipCase("indirect_enum", "indirect enum 未实现")

    return endSuite()
}