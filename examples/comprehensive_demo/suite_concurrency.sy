// suite_concurrency.sy — concurrency: Task/Task.detached + Concurrency.join, actor-isolated state,
// Channel (import Synchronization) send/recv/trySend/tryRecv/close/count/capacity.
// Corresponds to chapter 18 of the language guide. Observed: awaiting an async function inside a Task loses the result (returns nil / global not written); the FAIL is valid coverage.
// Backend: vm (native/wasm currently unavailable; see backendsFor in main.sy). Prefix Cc.

import Concurrency
import Synchronization

var gCcA = 0
var gCcB = 0

async func ccFetch() -> Int { return 42 }

actor CcCounter {
    var value: Int
    init(value: Int) { self.value = value }
    func increment() { self.value = self.value + 1 }
    func current() -> Int { return self.value }
}

func runConcurrency() -> (Int, Int, Int) {
    beginSuite("host.concurrency")

    // Task: closure side effects visible after join
    gCcA = 0
    let t1 = Task { gCcA = 7 }
    Concurrency.join(t1)
    check("task_side_effect", gCcA == 7)

    // Task.detached
    let t2 = Task.detached { gCcA = 11 }
    Concurrency.join(t2)
    check("task_detached", gCcA == 11)

    // actor: construction and isolated state
    let c = CcCounter(value: 5)
    check("actor_init", c.current() == 5)
    c.increment()
    c.increment()
    check("actor_increment", c.current() == 7)

    // Channel.create: bounded channel count/capacity
    let ch = Channel.create(2)
    ch.send(1)
    ch.send(2)
    check("channel_count", ch.count() == 2)
    check("channel_capacity", ch.capacity() == 2)

    // Channel: FIFO receive
    let x1 = ch.recv()
    check("channel_fifo", "\(x1)" == "1")
    let x2 = ch.recv()
    check("channel_fifo_second", "\(x2)" == "2")
    ch.close()

    // Channel(): unbounded by default (capacity 0)
    let ch2 = Channel()
    check("channel_default_capacity", ch2.capacity() == 0)
    ch2.send(5)
    let a = ch2.tryRecv()
    check("channel_try_recv", "\(a)" == "5")

    // tryRecv on an empty channel returns nil
    let b = ch2.tryRecv()
    check("channel_try_recv_empty", "\(b)" == "nil")

    // trySend returns true on success
    let ok = ch2.trySend(9)
    check("channel_try_send", ok)
    ch2.close()

    // async/await: awaiting an async function inside a Task currently loses the result; the FAIL is valid coverage
    gCcB = 0
    let t3 = Task {
        let v = await ccFetch()
        gCcB = v
    }
    Concurrency.join(t3)
    checkMsg("async_await_result", gCcB == 42, "await result not propagated back (gCcB=\(gCcB))")

    // Known gaps
    skipCase("task_group", "TaskGroup add/waitAll not covered in this round")
    skipCase("select", "Select.select/orDefault/timeout not covered in this round")
    skipCase("async_let", "async let parallel child tasks not covered in this round")

    return endSuite()
}