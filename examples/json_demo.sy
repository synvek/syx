/// SA-2-04: JSON demo via `JSON.encode`/`decode` (no `data class` / `@Codable`).
import JSON

func main() {
    print("=== JSON Demo for SYX Language ===")
    print("")
    print("--- Demo 1: Basic Person ---")
    var person: Object = {
        "id": 1,
        "name": "Alice",
        "email": "alice@example.com"
    }
    let personJson = JSON.encode(value: person)
    print("Encoded Person:")
    print(personJson)
    let decodedPerson: Object = JSON.decode(text: personJson)
    print("Decoded Person name:")
    print(decodedPerson.name)
    print("")
    print("--- Demo 2: Nested Employee ---")
    var address: Object = {
        "city": "Shanghai",
        "zip": 200000
    }
    var emp: Object = {
        "id": 42,
        "name": "Bob",
        "active": true
    }
    emp.address = address
    let empJson = JSON.encode(value: emp)
    print("Encoded Employee:")
    print(empJson)
    let decodedEmp: Object = JSON.decode(text: empJson)
    print("Decoded Employee city:")
    print(decodedEmp.address.city)
    print("")
    print("=== JSON Demo Complete ===")
}
