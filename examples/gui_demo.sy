import UI

func onGo() {
    print("guidemo:onGo")
}

func main() {
    print("SYX SynUI demo (Phase 135 v12)")
    let a = app()
    print("app: \(a)")
    let nameSig = signalNew("Alice")
    print("name signal: \(signalGet(nameSig))")
    print(signalSet(nameSig, "Bob"))
    print("name signal: \(signalGet(nameSig))")
    let agreeSig = signalBoolNew(false)
    print(signalBoolSet(agreeSig, true))
    let levelSig = signalNumberNew(0.25)
    let darkSig = signalBoolNew(false)
    print(signalBoolSet(darkSig, true))
    let optSig = signalBoolNew(true)
    let progressSig = signalNumberNew(0.35)
    let pickSig = signalNumberNew(2)
    let notesSig = signalNew("Draft notes")
    let listSig = signalNumberNew(1)
    let logoSig = signalNew("assets/logo.png")
    let scrollSig = signalNumberNew(0)
    let tabSig = signalNumberNew(0)
    let navSig = signalNumberNew(0)
    let title = label("Hello SynUI")
    let btn = button("Click me")
    print(onClick(btn, "onGo"))
    print(click(btn))
    let tf = textField("Name")
    print(bindTextField(tf, nameSig))
    let cb = checkbox("Agree", false)
    print(bindCheckbox(cb, agreeSig))
    let sl = slider(0.5, 0, 1)
    print(bindSlider(sl, levelSig))
    let sw = toggle(false)
    print(bindToggle(sw, darkSig))
    let rd = radio("Option A", false)
    print(bindRadio(rd, optSig))
    let bar = progress(0.6)
    print(bindProgress(bar, progressSig))
    let pick = picker("Red,Green,Blue", 1)
    print(bindPicker(pick, pickSig))
    let notes = textArea("Notes…")
    print(bindTextArea(notes, notesSig))
    let items = list("Alpha,Beta,Gamma")
    print(bindList(items, listSig))
    let logo = image("assets/logo.png")
    print(bindImage(logo, logoSig))
    let homePanel = label("Home tab")
    let settingsPanel = textArea("Settings tab")
    let detailPanel = label("Detail tab")
    let nav = navigation("Home,Settings,Detail", "\(homePanel),\(settingsPanel),\(detailPanel)")
    print(signalNumberSet(navSig, 1))
    print(bindNavigation(nav, navSig))
    let tabs = tabView("Home,Settings", "\(homePanel),\(settingsPanel)")
    print(signalNumberSet(tabSig, 1))
    print(bindTabView(tabs, tabSig))
    let gap = spacer(12, 1)
    let rule = divider(1)
    let scroll = scrollView("\(logo),\(gap),\(rule),\(notes)")
    print(signalNumberSet(scrollSig, 48))
    print(bindScrollView(scroll, scrollSig))
    let overlay = stack("\(title),\(btn)")
    let row = column("\(overlay),\(tf),\(cb),\(sl),\(sw),\(rd),\(bar),\(pick),\(items),\(nav),\(tabs),\(scroll)")
    print("row: \(row)")
    print("renderFingerprint: \(renderFingerprint())")
    print("pump: \(pump())")
    print("fingerprint: \(fingerprint())")
    print("run: \(run())")
    print("gui demo done")
}

