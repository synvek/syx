class Key: Hashable {
    var id: Int
    init(id: Int) { self.id = id }
    func hash(into hasher: Hasher) {
        hasher.combine(42)
    }
}

func main() {
    test001()
    test002()
}

func test001() {
    let a = Key(id: 1)
    let b = Key(id: 1)    
    var s: Set<Key> = []
    print(s.insert(a))
    print(s.insert(b))
   print(s.count)
}

func test002() {
    let a = Key(id: 1)
    let b = Key(id: 1)
    var d: Dictionary<Key, Int> = {a: 10, b: 20}
    print(d.count)
    print(d[a])
    print(d[b])
}