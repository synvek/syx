func test001() {
    var d: Dictionary<Int, Int> = {10: 100, 20: 200}
    print(d[10])
    print(d[20])
    print(d.containsKey(10))
    print(d.remove(10))
    print(d.containsKey(10))
    print(d.count)
    print(d[20])
}

func test002() {
    var d: Dictionary<Int, Int> = {10: 100, 20: 200, 30: 300}
    print(d.count)
    print(d.keys())
    for k in d.keys() {            
        print(k)
    }
}

func test003() {
    var d: Dictionary<String, Int> = ["a": 1, "b": 2]
    print(d.containsKey("a"))
    print(d.containsKey("z"))
    print(d.keys().count)
    print(d.values().count)
    print(d.remove("a"))
    print(d.containsKey("a"))
    print(d.count)
}

