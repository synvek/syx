// soga/client.sy — unified facade

public func chatComplete(cfg: Object, history: Object) -> Object {
    let cfgText = encodeJson(value: cfg)
    let histText = encodeJson(value: history)
    let snap = decodeObject(text: "\(cfgText)")
    let style = jStr(v: snap.api_style)
    if style == "anthropic" {
        return anthropicChatComplete(cfg: decodeObject(text: "\(cfgText)"), history: decodeObject(text: "\(histText)"))
    } else {
        return openaiChatComplete(cfg: decodeObject(text: "\(cfgText)"), history: decodeObject(text: "\(histText)"))
    }
}

public func ask(cfg: Object, system: String, prompt: String) -> Object {
    let cfgText = encodeJson(value: cfg)
    var history = newHistory()
    if system.count > 0 {
        history = historyAddSystem(history: history, content: "\(system)")
    }
    history = historyAddUser(history: history, content: "\(prompt)")
    let snap = decodeObject(text: "\(cfgText)")
    let style = jStr(v: snap.api_style)
    let histText = encodeJson(value: history)
    if style == "anthropic" {
        return anthropicChatComplete(cfg: decodeObject(text: "\(cfgText)"), history: decodeObject(text: "\(histText)"))
    } else {
        return openaiChatComplete(cfg: decodeObject(text: "\(cfgText)"), history: decodeObject(text: "\(histText)"))
    }
}

public func dryRun(cfg: Object, history: Object) -> Object {
    let cfgText = encodeJson(value: cfg)
    let histText = encodeJson(value: history)
    let snap = decodeObject(text: "\(cfgText)")
    let style = jStr(v: snap.api_style)
    if style == "anthropic" {
        return anthropicDryRun(cfg: decodeObject(text: "\(cfgText)"), history: decodeObject(text: "\(histText)"))
    } else {
        return openaiDryRun(cfg: decodeObject(text: "\(cfgText)"), history: decodeObject(text: "\(histText)"))
    }
}

public func printDryRun(info: Object) {
    let text = encodeJson(value: info)
    let s1 = decodeObject(text: "\(text)")
    let provider = jStr(v: s1.provider)
    let s2 = decodeObject(text: "\(text)")
    let model = jStr(v: s2.model)
    let s3 = decodeObject(text: "\(text)")
    let style = jStr(v: s3.api_style)
    let s4 = decodeObject(text: "\(text)")
    let url = jStr(v: s4.url)
    let s5 = decodeObject(text: "\(text)")
    let keyEnv = jStr(v: s5.api_key_env)
    let s6 = decodeObject(text: "\(text)")
    let hasKey = jBool(v: s6.has_api_key, fallback: false)
    print("[soga] dry-run provider=\(provider) style=\(style) model=\(model)")
    print("[soga] url=\(url)")
    print("[soga] api_key_env=\(keyEnv) has_key=\(hasKey)")
    print("[soga] full:")
    print(text)
}

public func describe(cfg: Object) -> String {
    let text = encodeJson(value: cfg)
    let s1 = decodeObject(text: "\(text)")
    let name = jStr(v: s1.name)
    let s2 = decodeObject(text: "\(text)")
    let style = jStr(v: s2.api_style)
    let s3 = decodeObject(text: "\(text)")
    let model = jStr(v: s3.model)
    let s4 = decodeObject(text: "\(text)")
    let base = jStr(v: s4.base_url)
    return "provider=\(name) style=\(style) model=\(model) base=\(base)"
}
