// soga/main.sy — non-interactive LLM demo

import Log
import Env

func printBanner() {
    Log.info("soga — SYX LLM chat library demo (non-interactive)")
    print("[soga] SOGA_DRY_RUN=")
    print(Env.get("SOGA_DRY_RUN"))
    print("[soga] SOGA_DEMO=")
    print(Env.get("SOGA_DEMO"))
    print("[soga] demoMode=")
    print(demoMode())
}

func printCfg(cfg: Object) {
    // Avoid interpolating encode dumps; describe returns a short String.
    let line = describe(cfg: cfg)
    print("[soga] ")
    print(line)
}

func buildDemoHistory(system: String, prompt: String) -> Object {
    var history = newHistory()
    // Demo path: user message only (system+user double-append has been flaky
    // with current SYX JSON/move semantics). Library APIs still support system.
    let _sysIgnored = system
    let userMsg = makeMessage(role: "user", content: prompt)
    history = historyAppend(history: history, msg: userMsg)
    return history
}

func runOneShot(cfg: Object, system: String, prompt: String) -> Object {
    print("[soga] --- one-shot ---")
    let cfgText = encodeJson(value: cfg)
    printCfg(cfg: decodeObject(text: "\(cfgText)"))

    let histText = encodeJson(value: buildDemoHistory(system: system, prompt: prompt))

    if dryRunEnabled() {
        let info = dryRun(cfg: decodeObject(text: "\(cfgText)"), history: decodeObject(text: "\(histText)"))
        printDryRun(info: info)
        return emptyObject()
    }

    let resultText = encodeJson(value: chatComplete(cfg: decodeObject(text: "\(cfgText)"), history: decodeObject(text: "\(histText)")))
    printResult(r: decodeObject(text: "\(resultText)"))
    return decodeObject(text: "\(resultText)")
}

func runMultiTurn(cfg: Object, system: String) -> Object {
    print("[soga] --- multi-turn script ---")
    let cfgText = encodeJson(value: cfg)
    printCfg(cfg: decodeObject(text: "\(cfgText)"))
    let _sysIgnored = system

    // Empty system for session bootstrap reliability in current SYX JSON/move model.
    let sessionText = encodeJson(value: create(cfg: decodeObject(text: "\(cfgText)"), system: ""))
    let promptsJson = "[\"In three words, what is SYX?\",\"Now repeat those three words in uppercase.\"]"

    if dryRunEnabled() {
        let preview = previewNext(session: decodeObject(text: "\(sessionText)"), userText: "In three words, what is SYX?")
        printDryRun(info: preview)
        return emptyObject()
    }

    let s = runScript(session: decodeObject(text: "\(sessionText)"), promptsJson: promptsJson)
    let sText = encodeJson(value: s)
    let sSnap = decodeObject(text: "\(sText)")
    let turns = jInt(v: sSnap.turns, fallback: 0)
    let n = historyCount(history: sSnap.history)
    print("[soga] session history messages=")
    print(n)
    print("[soga] turns=")
    print(turns)
    return decodeObject(text: "\(sText)")
}

func runProviderDemo(name: String) {
    let nameCopy = "\(name)"
    print("[soga] === provider ")
    print("\(nameCopy)")
    print(" ===")
    let probe = loadNamed(name: "\(nameCopy)")
    let probeText = encodeJson(value: probe)
    let p = decodeObject(text: "\(probeText)")
    let key = jStr(v: p.api_key)
    let p2 = decodeObject(text: "\(probeText)")
    let keyEnv = jStr(v: p2.api_key_env)
    if key.count == 0 {
        if !dryRunEnabled() {
            Log.warn("soga: no API key; forcing dry-run for this provider")
            print(keyEnv)
            let history = buildDemoHistory(system: "You are soga.", prompt: "Say hello.")
            let info = dryRun(cfg: loadNamed(name: "\(nameCopy)"), history: history)
            printDryRun(info: info)
            return
        }
    }
    // Literals / copies at each call site — String is move-consumed on by-value calls.
    runOneShot(cfg: loadNamed(name: "\(nameCopy)"), system: "You are soga.", prompt: "Say hello from SYX soga.")
    runMultiTurn(cfg: loadNamed(name: "\(nameCopy)"), system: "You are soga.")
}

func runAnthropicPathsDemo() {
    print("[soga] === anthropic-compatible paths ===")
    runOneShot(cfg: loadNamed(name: "deepseek-anthropic"), system: "You are soga.", prompt: "Say hello.")
    runOneShot(cfg: loadNamed(name: "minimax-anthropic"), system: "You are soga.", prompt: "Say hello.")
}

func main() {
    printBanner()
    let mode = demoMode()

    if mode == "provider" {
        runOneShot(cfg: loadFromEnv(), system: "You are soga.", prompt: "Say hello.")
        runMultiTurn(cfg: loadFromEnv(), system: "You are soga.")
        return
    }
    if mode == "deepseek" {
        runProviderDemo(name: "deepseek")
        return
    }
    if mode == "minimax" {
        runProviderDemo(name: "minimax")
        return
    }
    if mode == "both" {
        runProviderDemo(name: "deepseek")
        print("")
        runProviderDemo(name: "minimax")
        return
    }
    if mode == "anthropic-paths" {
        runAnthropicPathsDemo()
        return
    }
    runProviderDemo(name: mode)
}
