// soga/message.sy
// History: { "messages": [ ... ] }
//
// IMPORTANT: do not call single-label helpers like `userMessage(content: x)` —
// SYX may treat that as Type_init construction and then JSON-decode garbage.

public func makeMessage(role: String, content: String) -> Object {
    let roleJson = JSON.encode(value: role)
    let contentJson = JSON.encode(value: content)
    let text = "{\"role\":" + roleJson + ",\"content\":" + contentJson + "}"
    return JSON.decode(text: "\(text)")
}

public func newHistory() -> Object {
    return JSON.decode(text: "{\"messages\":[]}")
}

public func historyJson(history histBag: Object) -> String {
    let snap = JSON.decode(text: JSON.encode(value: histBag))
    return JSON.encode(value: snap.messages)
}

public func historyCount(history histBag: Object) -> Int {
    let snap = JSON.decode(text: JSON.encode(value: histBag))
    return snap.messages.count
}

public func historyAppend(history histBag: Object, msg: Object) -> Object {
    let hText = JSON.encode(value: histBag)
    let msgJson = JSON.encode(value: msg)
    let snap = JSON.decode(text: "\(hText)")
    let msgsJson = JSON.encode(value: snap.messages)
    var combined = "[]"
    if msgsJson == "[]" {
        combined = "[" + "\(msgJson)" + "]"
    } else {
        let head = "\(msgsJson)".substring(0, "\(msgsJson)".count - 1)
        combined = head + "," + "\(msgJson)" + "]"
    }
    return JSON.decode(text: "{\"messages\":" + combined + "}")
}

public func historyAddSystem(history histBag: Object, content: String) -> Object {
    let msg = makeMessage(role: "system", content: "\(content)")
    return historyAppend(history: histBag, msg: msg)
}

public func historyAddUser(history histBag: Object, content: String) -> Object {
    let msg = makeMessage(role: "user", content: "\(content)")
    return historyAppend(history: histBag, msg: msg)
}

public func historyAddAssistant(history histBag: Object, content: String) -> Object {
    let msg = makeMessage(role: "assistant", content: "\(content)")
    return historyAppend(history: histBag, msg: msg)
}

public func historyClone(history histBag: Object) -> Object {
    return JSON.decode(text: JSON.encode(value: histBag))
}

public func historyToOpenAIMessages(history histBag: Object) -> Object {
    let snap = JSON.decode(text: JSON.encode(value: histBag))
    return snap.messages
}

public func historyToAnthropic(history histBag: Object) -> Object {
    let hText = JSON.encode(value: histBag)
    let snap0 = JSON.decode(text: "\(hText)")
    let n = snap0.messages.count
    var systemText = ""
    var parts = ""
    var msgCount = 0
    var i = 0
    while i < n {
        let round = JSON.decode(text: "\(hText)")
        let m = round.messages[i]
        let role = "" + "\(m.role)"
        let contentCopy = "" + "\(m.content)"
        if role == "system" {
            if systemText.count == 0 {
                systemText = "" + contentCopy
            }
            if systemText.count > 0 {
                if systemText != contentCopy {
                    systemText = systemText + "\n" + contentCopy
                }
            }
        }
        if role == "user" {
            let piece = JSON.encode(value: makeMessage(role: "user", content: "" + contentCopy))
            if msgCount == 0 {
                parts = piece
            }
            if msgCount > 0 {
                parts = parts + "," + piece
            }
            msgCount = msgCount + 1
        }
        if role == "assistant" {
            let piece2 = JSON.encode(value: makeMessage(role: "assistant", content: "" + contentCopy))
            if msgCount == 0 {
                parts = piece2
            }
            if msgCount > 0 {
                parts = parts + "," + piece2
            }
            msgCount = msgCount + 1
        }
        i = i + 1
    }
    let sysJson = JSON.encode(value: systemText)
    return JSON.decode(text: "{\"system\":" + sysJson + ",\"messages\":[" + parts + "]}")
}
