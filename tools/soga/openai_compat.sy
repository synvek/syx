// soga/openai_compat.sy — OpenAI-compatible chat.completions

import Net

public func openaiBuildBody(model: String, maxTokens: Int, temperature: Double, history: Object, stream: Bool) -> Object {
    let arr = historyJson(history: history)
    var streamLit = "false"
    if stream { streamLit = "true" }
    let bodyText = "{\"model\":\"" + model + "\",\"messages\":" + arr + ",\"max_tokens\":" + "\(maxTokens)" + ",\"temperature\":" + "\(temperature)" + ",\"stream\":" + streamLit + "}"
    return decodeObject(text: "\(bodyText)")
}

public func openaiChatComplete(cfg: Object, history: Object) -> Object {
    let cfgText = encodeJson(value: cfg)
    let c = decodeObject(text: "\(cfgText)")
    let provider = jStr(v: c.name)
    let c2 = decodeObject(text: "\(cfgText)")
    let model = jStr(v: c2.model)
    let c3 = decodeObject(text: "\(cfgText)")
    let key = jStr(v: c3.api_key)
    let c4 = decodeObject(text: "\(cfgText)")
    let keyEnv = jStr(v: c4.api_key_env)
    let c5 = decodeObject(text: "\(cfgText)")
    let timeoutMs = jInt(v: c5.timeout_ms, fallback: 120000)
    let c6 = decodeObject(text: "\(cfgText)")
    let maxTokens = jInt(v: c6.max_tokens, fallback: 1024)
    let c7 = decodeObject(text: "\(cfgText)")
    let temperature = jDouble(v: c7.temperature, fallback: 0.7)
    let c8 = decodeObject(text: "\(cfgText)")
    let base = jStr(v: c8.base_url)
    let url = joinUrl(base: "\(base)", path: "/chat/completions")

    if key.count == 0 {
        return errResult(provider: "\(provider)", model: "\(model)", error: "missing api key (set \(keyEnv) or SOGA_API_KEY)", status: 0, raw: emptyObject())
    }

    let histUse = decodeObject(text: encodeJson(value: history))
    let body = openaiBuildBody(model: "\(model)", maxTokens: maxTokens, temperature: temperature, history: histUse, stream: false)
    let bodyText = encodeJson(value: body)
    let headersText = "{\"Authorization\":\"Bearer \(key)\",\"Content-Type\":\"application/json\",\"Accept\":\"application/json\"}"
    let opts = decodeObject(text: "{\"method\":\"POST\",\"timeout_ms\":\(timeoutMs),\"headers\":\(headersText),\"body\":\(bodyText)}")

    var status = 0
    var text = ""
    var transportErr = ""
    try {
        let resp = Http.fetch(url, opts)
        status = jInt(v: resp.status(), fallback: 0)
        text = "\(resp.text())"
    } catch (e) {
        transportErr = "http transport failed: \(e)"
    }

    if transportErr.count > 0 {
        return errResult(provider: "\(provider)", model: "\(model)", error: "\(transportErr)", status: status, raw: emptyObject())
    }

    if status < 200 {
        return errResult(provider: "\(provider)", model: "\(model)", error: "\(text)", status: status, raw: decodeObject(text: "\(text)"))
    }
    if status > 299 {
        let errSnap = decodeObject(text: "\(text)")
        let apiErr = jStr(v: errSnap.error.message)
        var msg = "\(text)"
        if apiErr.count > 0 { msg = "\(apiErr)" }
        return errResult(provider: "\(provider)", model: "\(model)", error: msg, status: status, raw: decodeObject(text: "\(text)"))
    }

    let content = openaiAssistantText(raw: decodeObject(text: "\(text)"))
    if content.count == 0 {
        return errResult(provider: "\(provider)", model: "\(model)", error: "empty assistant content; body=\(text)", status: status, raw: emptyObject())
    }
    let finish = openaiFinishReason(raw: decodeObject(text: "\(text)"))
    let usage = parseOpenAIUsage(raw: decodeObject(text: "\(text)"))
    return okResult(provider: "\(provider)", model: "\(model)", content: "\(content)", finish: "\(finish)", status: status, raw: decodeObject(text: "\(text)"), usage: usage)
}

public func openaiDryRun(cfg: Object, history: Object) -> Object {
    let cfgText = encodeJson(value: cfg)
    let c = decodeObject(text: "\(cfgText)")
    let provider = jStr(v: c.name)
    let c2 = decodeObject(text: "\(cfgText)")
    let model = jStr(v: c2.model)
    let c3 = decodeObject(text: "\(cfgText)")
    let keyEnv = jStr(v: c3.api_key_env)
    let c4 = decodeObject(text: "\(cfgText)")
    let key = jStr(v: c4.api_key)
    let c5 = decodeObject(text: "\(cfgText)")
    let maxTokens = jInt(v: c5.max_tokens, fallback: 1024)
    let c6 = decodeObject(text: "\(cfgText)")
    let temperature = jDouble(v: c6.temperature, fallback: 0.7)
    let c7 = decodeObject(text: "\(cfgText)")
    let base = jStr(v: c7.base_url)
    let url = joinUrl(base: "\(base)", path: "/chat/completions")
    let histUse = decodeObject(text: encodeJson(value: history))
    let body = openaiBuildBody(model: "\(model)", maxTokens: maxTokens, temperature: temperature, history: histUse, stream: false)
    let bodyText = encodeJson(value: body)
    var hasKey = "false"
    if key.count > 0 { hasKey = "true" }
    return decodeObject(text: "{\"url\":\"\(url)\",\"api_style\":\"openai\",\"provider\":\"\(provider)\",\"model\":\"\(model)\",\"api_key_env\":\"\(keyEnv)\",\"has_api_key\":\(hasKey),\"body\":\(bodyText)}")
}
