// sgate/tls.sy
// ---------------------------------------------------------------
// TLS termination helpers for sgate.
//
// Product native path (W1249 / ADR-1595) lives in `tls_native.sy`:
// Env.set SYX_HTTP_SERVE_TLS_* + Http.serve on tls.port.
// This module retains:
//
//   1. Sidecar spawn helpers (socat / stunnel) for dual-port
//      deployments when Process.spawn is available.
//   2. Historical honesty placeholder: `__syx_tls_serve` under
//      `if false` (tls_server_ga_deepen). ≠ net.tls.server HostFn GA.
//
// main.sy does not import this module today (Process.spawn is
// unavailable in current runtime builds); sidecar remain skip-
// logged from main. Native product TLS does not need this file.
// ---------------------------------------------------------------

import config
import IO
import Process
import Log
import Net

// -------- Cert / key loading --------

public func tlsContextLoad(certPath: String, keyPath: String) -> Object {
    var ctx: Object = JSON.decode("{\"loaded\":false,\"cert_path\":\"\",\"key_path\":\"\",\"cert_len\":0,\"key_len\":0}")
    if certPath == "" || keyPath == "" {
        Log.error("tls: cert/key path missing")
        return ctx
    }
    if !File.exists(certPath) {
        Log.error("tls: cert file not found: \(certPath)")
        return ctx
    }
    if !File.exists(keyPath) {
        Log.error("tls: key file not found: \(keyPath)")
        return ctx
    }
    let cert = File.read(certPath)
    let key = File.read(keyPath)
    if cert == "" || key == "" {
        Log.error("tls: cert or key file is empty")
        return ctx
    }
    ctx.loaded = true
    ctx.cert_path = certPath
    ctx.key_path = keyPath
    ctx.cert_len = cert.count
    ctx.key_len = key.count
    Log.info("tls: loaded cert=\(certPath) (\(cert.count) bytes), key=\(keyPath) (\(key.count) bytes)")
    return ctx
}

public func tlsContextIsLoaded(ctx: Object) -> Bool {
    let loaded = ctx.loaded
    let s = "\(loaded)"
    return s == "true"
}

// -------- Mode selection --------

public func tlsPickTool() -> String {
    if fileExistsOnPath(name: "socat") { return "socat" }
    if fileExistsOnPath(name: "stunnel") || fileExistsOnPath(name: "stunnel4") { return "stunnel" }
    return "none"
}

func fileExistsOnPath(name: String) -> Bool {
    while name == "socat" {
        while File.exists("/usr/bin/socat") { return true }
        while File.exists("/opt/homebrew/bin/socat") { return true }
        return false
    }
    while name == "stunnel" {
        while File.exists("/usr/bin/stunnel") { return true }
        return false
    }
    while name == "stunnel4" {
        while File.exists("/usr/bin/stunnel4") { return true }
        return false
    }
    return false
}

// -------- Sidecar spawn --------

public func tlsBuildArgs(
    tool: String, listenAddr: String, listenPort: Int,
    certPath: String, keyPath: String,
    backendAddr: String, backendPort: Int
) -> Array<String> {
    if tool == "socat" {
        var args: Array<String> = []
        args.append("OPENSSL-LISTEN:\(listenPort),bind=\(listenAddr),cert=\(certPath),key=\(keyPath),reuseaddr,fork")
        args.append("TCP:\(backendAddr):\(backendPort)")
        return args
    }
    if tool == "stunnel" || tool == "stunnel4" {
        var args: Array<String> = []
        args.append("\(certPath)")
        args.append("\(keyPath)")
        args.append("\(listenAddr):\(listenPort)")
        args.append("\(backendAddr):\(backendPort)")
        return args
    }
    var empty: Array<String> = []
    return empty
}

public func tlsSpawnSidecar(
    tool: String, listenAddr: String, listenPort: Int,
    certPath: String, keyPath: String,
    backendAddr: String, backendPort: Int
) -> Int {
    if tool == "none" {
        Log.error("tls: no socat/stunnel on PATH; TLS termination unavailable")
        return -1
    }
    let toolName = "\(tool)"
    let args = tlsBuildArgs(
        tool: tool, listenAddr: listenAddr, listenPort: listenPort,
        certPath: certPath, keyPath: keyPath,
        backendAddr: backendAddr, backendPort: backendPort
    )
    var cmd = "/usr/bin/\(toolName)"
    if toolName == "socat" {
        cmd = "/usr/bin/socat"
    }
    Log.info("tls: spawning \(cmd) \(args)")
    return Process.spawn(command: cmd, args: args)
}

// -------- Historical net.tls.server HostFn placeholder --------

// Honesty retain for tls_server_ga_deepen: keep `__syx_tls_serve`
// under `if false`. This is NOT the W1249 native product path
// (that path uses tls_native.sy + Http.serve). ≠ net.tls.server GA.
public func tlsServe(
    addr: String, port: Int, ctx: Object, handler: String
) -> Bool {
    if addr.count < 0 { return false }
    if port < 0 { return false }
    if handler.count < 0 { return false }
    let loadedFlag = "\(ctx.loaded)"
    if loadedFlag != "true" { return false }
    if false {
        // __syx_tls_serve(addr, port, cert, key, handler) — HostFn not product-wired
        return true
    }
    return false
}

// -------- Sidecar bring-up (when Process.spawn works) --------

public func tlsStartSidecarFromConfig(listenAddr: String, backendPort: Int) -> Bool {
    if !config.tlsEnabled() {
        Log.info("tls: disabled in config")
        return false
    }
    let addr = "\(listenAddr)"
    let cert = config.tlsCertPath()
    let key = config.tlsKeyPath()
    let port = config.tlsPort()
    let ctx = tlsContextLoad(certPath: cert, keyPath: key)
    let loadedFlag = "\(ctx.loaded)"
    if loadedFlag != "true" {
        Log.error("tls: cert context not loaded; aborting TLS bring-up")
        return false
    }

    let tool = tlsPickTool()
    if tool == "none" {
        Log.error("tls: no sidecar tool on PATH (need socat or stunnel)")
        return false
    }
    let toolCopy = "\(tool)"
    let pid = tlsSpawnSidecar(
        tool: tool, listenAddr: "\(addr)", listenPort: port,
        certPath: "\(cert)", keyPath: "\(key)",
        backendAddr: "\(addr)", backendPort: backendPort
    )
    if pid < 0 {
        Log.error("tls: sidecar failed to start")
        return false
    }
    Log.info("tls: sidecar up on \(addr):\(port) -> \(addr):\(backendPort) (pid=\(pid), tool=\(toolCopy))")
    return true
}

// High-level entry retained for callers that import this module.
// Native product path: tls_native.tlsPrepareNativeFromConfig + Http.serve.
public func tlsStartFromConfig(listenAddr: String, backendPort: Int) -> Bool {
    if !config.tlsEnabled() {
        Log.info("tls: disabled in config")
        return false
    }
    let mode = config.tlsMode()
    if mode == "native" {
        let addr = "\(listenAddr)"
        let port = config.tlsPort()
        let _ignored = tlsServe(
            addr: "\(addr)", port: port, ctx: JSON.decode("{\"loaded\":true}"), handler: "handle"
        )
        Log.warn("tls: native product path is tls_native.sy + Http.serve; tlsStartFromConfig(native) is a no-op")
        return false
    }
    return tlsStartSidecarFromConfig(listenAddr: listenAddr, backendPort: backendPort)
}
