public func upstreamCount() -> Int {
    return CONFIG.upstreams.count
}

public func upstreamName(idx: Int) -> String {
    if idx < 0
    return ""
    if idx >= CONFIG.upstreams.count
    return ""
    return jStr(v: CONFIG.upstreams[idx].name)
}

public func findUpstreamIndex(name: String) -> Int {
    // Name compare must not sit inside another while: a false match aborts the
    // outer while (VM quirk). Gate each index with a top-level flag instead.
    let want = "\(name)"
    var found = -1

    var n0 = CONFIG.upstreams.count
    var take0 = "0"
    while n0 > 0 {
        take0 = "1"
        n0 = 0
    }
    var p0 = ""
    while take0 == "1" {
        p0 = jStr(v: CONFIG.upstreams[0].name)
        take0 = "0"
    }
    var w = want
    while w == p0 {
        found = 0
        w = ""
    }

    var n1 = CONFIG.upstreams.count
    var take1 = "0"
    while n1 > 1 {
        take1 = "1"
        n1 = 0
    }
    var p1 = ""
    while take1 == "1" {
        p1 = jStr(v: CONFIG.upstreams[1].name)
        take1 = "0"
    }
    w = want
    while w == p1 {
        found = 1
        w = ""
    }

    var n2 = CONFIG.upstreams.count
    var take2 = "0"
    while n2 > 2 {
        take2 = "1"
        n2 = 0
    }
    var p2 = ""
    while take2 == "1" {
        p2 = jStr(v: CONFIG.upstreams[2].name)
        take2 = "0"
    }
    w = want
    while w == p2 {
        found = 2
        w = ""
    }

    var n3 = CONFIG.upstreams.count
    var take3 = "0"
    while n3 > 3 {
        take3 = "1"
        n3 = 0
    }
    var p3 = ""
    while take3 == "1" {
        p3 = jStr(v: CONFIG.upstreams[3].name)
        take3 = "0"
    }
    w = want
    while w == p3 {
        found = 3
        w = ""
    }

    return found
}

public func upstreamServersAt(idx: Int) -> Array<String> {
    var empty: Array<String> = []
    if idx < 0
    return empty
    if idx >= CONFIG.upstreams.count
    return empty
    let srv = CONFIG.upstreams[idx].servers
    var out: Array<String> = []
    var j = 0
    while j < srv.count {
        out.append(jStr(v: srv[j]))
        j = j + 1
    }
    return out
}

public func serversForUpstream(name: String) -> Array<String> {
    return upstreamServersAt(idx: findUpstreamIndex(name: name))
}

public func timeoutForUpstream(name: String) -> Int {
    let idx = findUpstreamIndex(name: name)
    if idx < 0
    return 5000
    return jInt(v: CONFIG.upstreams[idx].timeout_ms, fallback: 5000)
}

public func strategyForUpstream(name: String) -> String {
    let idx = findUpstreamIndex(name: name)
    if idx < 0
    return "round_robin"
    let s = jStr(v: CONFIG.upstreams[idx].strategy)
    if s == "" {
        return "round_robin"
    }
    return s
}

