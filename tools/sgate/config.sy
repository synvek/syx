import IO

public var CONFIG: Object = JSON.decode("{}")

/// Cross-module assignment to `CONFIG` is rejected by the checker;
/// other modules must call this setter instead of `CONFIG = …`.
public func setConfig(obj: Object) {
    CONFIG = obj
}

/// JSON field helpers — prefer `as?` / `??` (MIR once dropped `if let` and
/// mis-placed `??` stores; both are fixed). Missing / null → fallback.
func jStr(v: Any) -> String {
    return (v as? String) ?? ""
}

func jInt(v: Any, fallback: Int) -> Int {
    return (v as? Int) ?? fallback
}

func jBool(v: Any, fallback: Bool) -> Bool {
    return (v as? Bool) ?? fallback
}

public func loadConfig(path: String) -> Bool {
    if !File.exists("\(path)")
    return false
    let txt = File.read("\(path)")
    let parsed = JSON.decode(text: txt)
    setConfig(obj: parsed)
    return true
}

public func server_listen() -> String {
    let v = jStr(v: CONFIG.server.listen)
    if v == "" {
        return "0.0.0.0"
    }
    return v
}

public func server_port() -> Int {
    return jInt(v: CONFIG.server.port, fallback: 8080)
}

public func server_access_log() -> Bool {
    return jBool(v: CONFIG.server.access_log, fallback: true)
}

public func server_worker_name() -> String {
    let n = jStr(v: CONFIG.server.worker_name)
    if n == "" {
        return "sgate"
    }
    return n
}

