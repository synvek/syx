public func wsRouteName(i: Int) -> String {
    if i < 0
    return ""
    if i >= CONFIG.ws_routes.count
    return ""
    return jStr(v: CONFIG.ws_routes[i].name)
}

public func findWsRoute(path: String) -> Int {
    let n = wsRouteCount()
    var i = 0
    while i < n {
        if startsWith(text: path, prefix: wsRoutePath(i: i))
        return i
        i = i + 1
    }
    return -1
}
