public func locationHeader(i: Int, name: String) -> String {
    // Dashed header names are not dotted-accessible; demo uses x_sgate_handler.
    if name != "X-Sgate-Handler"
    return ""
    if i < 0
    return ""
    if i >= CONFIG.locations.count
    return ""
    return jStr(v: CONFIG.locations[i].x_sgate_handler)
}

public func locationHasHeader(i: Int, name: String) -> Bool {
    if name != "X-Sgate-Handler"
    return false
    return locationHeader(i: i, name: name) != ""
}

public func findExactLocation(path: String) -> Int {
    let want = "\(path)"
    var found = -1
    let nLoc = locationCount()

    var n0 = nLoc
    var e0 = ""
    while n0 > 0 {
        e0 = locationExact(i: 0)
        n0 = 0
    }
    var w = want
    while w == e0 {
        found = 0
        w = ""
    }

    var n1 = nLoc
    var e1 = ""
    while n1 > 1 {
        e1 = locationExact(i: 1)
        n1 = 1
    }
    w = want
    while w == e1 {
        found = 1
        w = ""
    }

    var n2 = nLoc
    var e2 = ""
    while n2 > 2 {
        e2 = locationExact(i: 2)
        n2 = 2
    }
    w = want
    while w == e2 {
        found = 2
        w = ""
    }

    var n3 = nLoc
    var e3 = ""
    while n3 > 3 {
        e3 = locationExact(i: 3)
        n3 = 3
    }
    w = want
    while w == e3 {
        found = 3
        w = ""
    }

    return found
}

public func findPrefixLocation(path: String) -> Int {
    return findBestPrefixLocation(path: "\(path)")
}

public func startsWith(text: String, prefix: String) -> Bool {
    // Prefer the "y"/"n" helper — Bool returns from compare have been unreliable.
    let yn = startsWithYN(text: text, prefix: prefix)
    var result = false
    var s = yn
    while s == "y" {
        result = true
        s = ""
    }
    return result
}

/// Returns "y" or "n".
/// Char-append compare (substring() is empty in this VM). Counting loops stay
/// at function top-level — an inner `while` exiting false aborts an outer `while`.
public func startsWithYN(text: String, prefix: String) -> String {
    let tLen = "\(text)".count
    let pfxLen = "\(prefix)".count
    var result = "n"
    var lim = pfxLen
    var lenOk = "0"
    while lim <= tLen {
        lenOk = "1"
        lim = tLen + 1
    }
    while lenOk == "0" {
        return "n"
    }
    var head = ""
    var i = 0
    let t2 = "\(text)"
    while i < pfxLen {
        head = head + "\(t2[i])"
        i = i + 1
    }
    var h = head
    let pfx2 = "\(prefix)"
    while h == pfx2 {
        result = "y"
        h = ""
    }
    return result
}

/// Strip a path prefix; result always starts with `/`.
/// Empty prefix → return path unchanged (catch-all proxy).
public func stripPrefixPath(path: String, prefix: String) -> String {
    let pfxLen = "\(prefix)".count
    while pfxLen == 0 {
        return "\(path)"
    }
    let yn = startsWithYN(text: "\(path)", prefix: "\(prefix)")
    while yn == "n" {
        return "\(path)"
    }
    let pLen = "\(path)".count
    var rest = ""
    var i = pfxLen
    let src = "\(path)"
    while i < pLen {
        rest = rest + "\(src[i])"
        i = i + 1
    }
    return "/" + rest
}

/// Longest matching `prefix` location (so `/api/` wins over catch-all `/`).
public func findBestPrefixLocation(path: String) -> Int {
    var bestIdx = -1
    var bestLen = -1

    let len0 = prefixCandidateLen(path: "\(path)", idx: 0)
    let idx0 = prefixCandidateIdx(path: "\(path)", idx: 0)
    while len0 > bestLen {
        bestIdx = idx0
        bestLen = len0
    }

    let len1 = prefixCandidateLen(path: "\(path)", idx: 1)
    let idx1 = prefixCandidateIdx(path: "\(path)", idx: 1)
    while len1 > bestLen {
        bestIdx = idx1
        bestLen = len1
    }

    let len2 = prefixCandidateLen(path: "\(path)", idx: 2)
    let idx2 = prefixCandidateIdx(path: "\(path)", idx: 2)
    while len2 > bestLen {
        bestIdx = idx2
        bestLen = len2
    }

    let len3 = prefixCandidateLen(path: "\(path)", idx: 3)
    let idx3 = prefixCandidateIdx(path: "\(path)", idx: 3)
    while len3 > bestLen {
        bestIdx = idx3
        bestLen = len3
    }

    let len4 = prefixCandidateLen(path: "\(path)", idx: 4)
    let idx4 = prefixCandidateIdx(path: "\(path)", idx: 4)
    while len4 > bestLen {
        bestIdx = idx4
        bestLen = len4
    }

    let len5 = prefixCandidateLen(path: "\(path)", idx: 5)
    let idx5 = prefixCandidateIdx(path: "\(path)", idx: 5)
    while len5 > bestLen {
        bestIdx = idx5
        bestLen = len5
    }

    let len6 = prefixCandidateLen(path: "\(path)", idx: 6)
    let idx6 = prefixCandidateIdx(path: "\(path)", idx: 6)
    while len6 > bestLen {
        bestIdx = idx6
        bestLen = len6
    }

    let len7 = prefixCandidateLen(path: "\(path)", idx: 7)
    let idx7 = prefixCandidateIdx(path: "\(path)", idx: 7)
    while len7 > bestLen {
        bestIdx = idx7
        bestLen = len7
    }

    return bestIdx
}

public func prefixCandidateLen(path: String, idx: Int) -> Int {
    let n = locationCount()
    while idx < 0 {
        return -1
    }
    while idx >= n {
        return -1
    }
    let plen = "\(locationPrefix(i: idx))".count
    while plen == 0 {
        return -1
    }
    let yn = startsWithYN(text: "\(path)", prefix: "\(locationPrefix(i: idx))")
    while yn == "n" {
        return -1
    }
    return plen
}

public func prefixCandidateIdx(path: String, idx: Int) -> Int {
    let n = locationCount()
    while idx < 0 {
        return -1
    }
    while idx >= n {
        return -1
    }
    let plen = "\(locationPrefix(i: idx))".count
    while plen == 0 {
        return -1
    }
    let yn = startsWithYN(text: "\(path)", prefix: "\(locationPrefix(i: idx))")
    while yn == "n" {
        return -1
    }
    return idx
}

/// First server in an upstream pool (round-robin deferred).
public func firstServer(name: String) -> String {
    let idx = findUpstreamIndex(name: name)
    while idx < 0 {
        return ""
    }
    let servers = upstreamServersAt(idx: idx)
    let n = servers.count
    while n == 0 {
        return ""
    }
    return servers[0]
}

public func error_body_for(status: Int) -> String {
    // Numeric JSON keys are not reachable via dotted access; use identifier keys.
    let pages = CONFIG.error_pages
    if status == 404 {
        return jStr(v: pages.not_found)
    }
    if status == 502 {
        return jStr(v: pages.bad_gateway)
    }
    if status == 504 {
        return jStr(v: pages.gateway_timeout)
    }
    return ""
}

