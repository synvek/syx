// sgate/sy
// ---------------------------------------------------------------
// Dedicated-port WebSocket sidecar for sgate `ws_routes`.
//
// Same-port HTTP Upgrade on the main `Http.serve` listener is
// handled in-process: `sy` returns `upgradeUpstream` and
// the VM dials + tunnels opaque bytes after 101 (frames pass
// through intact; no in-process frame codec / Sec-WebSocket-Accept).
// Third-slice evidence: stdlib masked text-frame round-trip nail.
// This module is only for `ws_routes` entries that open a
// separate listen port (e.g. :5001 for `/ws/`).
//
// SYX `TcpStream` is still client-only (no stdlib listen/accept),
// so those dedicated listeners spawn an external sidecar —
// `websocat`:
//
//   websocat -s 5001 ws://upstream-host:upstream-port/
//
// `websocat` speaks WebSocket on one end and forwards to the
//  The `-s` flag means "server mode" (accept inbound
// WebSocket connections on the listed port).
//
// sgate's `ws_routes` config table maps inbound paths to
// upstream pools. For each entry we spawn one `websocat`
// process; the matched inbound WS connection is then proxied
// by that process to a chosen upstream server (round-robin via
// the shared `sy` counter).
//
// The module deliberately mirrors the shape of `sy`:
//   * `wsBuildArgs(...)` builds the argv without
//     actually running anything — pure, easy to test.
//   * `wsSpawnSidecar(...)` does the actual spawn.
//   * `wsStartFromConfig()` is the high-level entry
//     point that reads `ws_routes` and brings them all up.
//
// Failure modes (tool not installed, port in use, etc.) are
// logged and the call returns false. The plain HTTP listener
// keeps serving even if WebSocket startup fails.
// ---------------------------------------------------------------

import Process
import Log
import IO

// Sidecar process handles (one per ws_route). We keep the
// process IDs so a future stop command can wait() on them;
// today we just leak them — the OS cleans up at exit.
var WS_PIDS: Array<Int> = []

// Pick a WS tool. Prefer `websocat`; fall back to `socat` if
// it has the right flags (socat on macOS / older Linux may
// lack them).
public func wsPickTool() -> String {
    if fileOnPath(name: "websocat") { return "websocat" }
    if fileOnPath(name: "socat")    { return "socat" }
    return "none"
}

func fileOnPath(name: String) -> Bool {
    // Process.execOutput is not available in all runtime builds.
    while name == "websocat" {
        while File.exists("/usr/bin/websocat") { return true }
        while File.exists("/opt/homebrew/bin/websocat") { return true }
        return false
    }
    while name == "socat" {
        while File.exists("/usr/bin/socat") { return true }
        while File.exists("/opt/homebrew/bin/socat") { return true }
        return false
    }
    return false
}

// Build the argv for a single ws_route. The output is meant
// to be passed to Process.spawn(websocat|socat, args).
//
//   listenAddr / listenPort — where sgate accepts WS clients
//   upstreamScheme         — "ws://" or "wss://"
//   upstreamAddr           — "host:port" of the backend
//   upstreamPath           — path to forward to (after strip_prefix)
//
// Note: `websocat` takes the listen port with `-s PORT` (or
// the older `ws-listen:PORT` URI form). We use the explicit
// form for clarity.
public func wsBuildArgs(
    tool: String,
    listenAddr: String, listenPort: Int,
    upstreamScheme: String, upstreamAddr: String, upstreamPath: String
) -> Array<String> {
    var args: Array<String> = []
    if tool == "websocat" {
        args.append("-s")
        args.append("\(listenPort)")
        // Bind address (websocat 1.8+ supports `tcp-l:HOST:PORT`):
        args.append("tcp-l:\(listenAddr):\(listenPort)")
        args.append("\(upstreamScheme)\(upstreamAddr)\(upstreamPath)")
    } else if tool == "socat" {
        // socat can speak WebSocket on either end, but the
        // flag set is fragile across versions. We assume a
        // recent socat with the EXEC: and OPENSSL: support.
        args.append("TCP-LISTEN:\(listenPort),bind=\(listenAddr),reuseaddr,fork")
        args.append("\(upstreamScheme)\(upstreamAddr)\(upstreamPath)")
    }
    return args
}

// Spawn the sidecar. Returns the child handle (Int) or -1 on
// failure. The handle is also pushed into WS_PIDS so a
// later `wsStopAll` can wait() on every one of them.
public func wsSpawnSidecar(
    tool: String,
    listenAddr: String, listenPort: Int,
    upstreamScheme: String, upstreamAddr: String, upstreamPath: String
) -> Int {
    if tool == "none" {
        Log.error("ws: no websocat/socat on PATH; WebSocket pass-through unavailable")
        return -1
    }
    let toolName = "\(tool)"
    let args = wsBuildArgs(
        tool: tool,
        listenAddr: listenAddr, listenPort: listenPort,
        upstreamScheme: upstreamScheme, upstreamAddr: upstreamAddr, upstreamPath: upstreamPath
    )
    var cmd = "/usr/bin/socat"
    if toolName == "websocat" {
        cmd = "/usr/local/bin/websocat"
    }
    Log.info("ws: spawning \(cmd) \(args)")
    let pid = Process.spawn(command: cmd, args: args)
    if pid >= 0 {
        WS_PIDS.append(pid)
    } else {
        Log.error("ws: sidecar spawn failed")
    }
    return pid
}

// Choose an upstream "host:port" for the given route index.
// We piggy-back on the sy round-robin counter so
// the WS load balancing matches the HTTP one. The caller is
// expected to wrap this in `ws://` (or `wss://`) when feeding
// it to the sidecar.
public func wsPickUpstream(i: Int) -> String {
    let poolName = wsRouteUpstream(i: i)
    if poolName == "" { return "" }
    return pickServer(name: poolName)
}

// Compute the path to forward to the upstream, after the
// configured prefix is stripped from the matched route.
public func wsStrippedPath(routeIdx: Int, rawPath: String) -> String {
    let strip = wsRouteStripPrefix(i: routeIdx)
    let src = "\(rawPath)"
    if strip == "" { return src }
    if !startsWith(text: "\(src)", prefix: "\(strip)") { return "\(src)" }
    let rest = "\(src)".substring("\(strip)".count, "\(src)".count)
    if rest == "" { return "/" }
    return rest
}

// High-level entry: walk `ws_routes`, spawn one sidecar per
// entry. Returns the number of sidecars successfully started.
public func wsStartFromConfig(listenAddr: String) -> Int {
    let n = wsRouteCount()
    if n == 0 {
        Log.info("ws: no ws_routes configured")
        return 0
    }
    let tool = wsPickTool()
    if tool == "none" {
        Log.error("ws: no sidecar tool on PATH (need websocat or socat)")
        return 0
    }
    Log.info("ws: bringing up \(n) ws_route(s) via \(tool)")
    var started = 0
    var i = 0
    while i < n {
        let path = wsRoutePath(i: i)
        if path == "" {
            i = i + 1
            continue
        }
        // The actual listen port is encoded in the path as
        // the integer after the prefix slash. We expect a
        // config like:
        //   "path": "ws://127.0.0.1:5001/"
        // For now we treat the path as opaque and ask the
        // caller to encode the listen port in `ws_listen_port`
        // — see wsListenPortFromRoute below.
        let listenPort = wsListenPortFromRoute(i: i)
        if listenPort <= 0 {
            Log.warn("ws: route [\(wsRouteName(i: i))] has no listen port; skipping")
            i = i + 1
            continue
        }
        let upstreamAddr = wsPickUpstream(i: i)
        if upstreamAddr == "" {
            Log.warn("ws: route [\(wsRouteName(i: i))] has no upstream pool; skipping")
            i = i + 1
            continue
        }
        // The path the inbound WS client requested. We use the
        // raw configured `ws_routes[i].path` as the target
        // path on the upstream side.
        let target = wsStrippedPath(routeIdx: i, rawPath: path)
        let pid = wsSpawnSidecar(
            tool: tool,
            listenAddr: listenAddr, listenPort: listenPort,
            upstreamScheme: "ws://", upstreamAddr: upstreamAddr,
            upstreamPath: target
        )
        if pid >= 0 { started = started + 1 }
        i = i + 1
    }
    return started
}

// Read a per-route listen port. We extend the JSON schema
// with an optional `listen_port` field on each ws_route. The
// fallback is the configured `server.port` (or 5001 if
// even that is missing) so the demo still runs.
public func wsListenPortFromRoute(i: Int) -> Int {
    let v = wsRouteListenPort(i: i)
    if v > 0 { return v }
    // Try port as a generic fallback. If neither is
    // set, use 5001 (the mock's default WS port).
    let p = tlsPort()
    if p > 0 && p != 8443 { return p }
    return 5001
}

// Diagnostic: number of sidecars we've successfully spawned.
public func wsCount() -> Int {
    return WS_PIDS.count
}
