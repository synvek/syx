// sgate/main.sy
// ---------------------------------------------------------------
// Entry point for sgate — a minimal nginx-like HTTP gateway
// driven by a JSON config file.
//
//   Usage:
//     syx run tools/sgate
//     SYX_SGATE_CONFIG=/path/to.json syx run tools/sgate
//
// Lifecycle:
//   1. Resolve config (env SYX_SGATE_CONFIG, argv *.json, or defaults).
//   2. Load the JSON config (config.sy).
//   3. TLS bring-up (W1249):
//        - mode native → Env.set PEM + Http.serve on tls.port
//        - mode sidecar → honest skip when Process.spawn unavailable
//          (plain Http.serve on server.port; socat path remains in tls.sy)
//   4. Print a startup banner.
//   5. Hand off to Http.serve with `handle` as the request callback.
// ---------------------------------------------------------------

import config
import router
import tls_native
import Net
import Process
import Log
import IO
import Env

func printBanner() {
    let worker = config.server_worker_name()
    let listen = config.server_listen()
    let port = config.server_port()
    Log.info("sgate \(worker) starting on \(listen):\(port)")
    let tlsOn = config.tlsEnabled()
    if tlsOn == true {
        let tp = config.tlsPort()
        let tm = config.tlsMode()
        Log.info("    tls: enabled, port=\(tp), mode=\(tm)")
    }
    if tlsOn == false {
        Log.info("    tls: disabled")
    }
    let hrOn = config.hotReloadEnabled()
    if hrOn == true {
        let iv = config.hotReloadIntervalMs()
        Log.info("    hot_reload: enabled, interval=\(iv)ms")
    }
    if hrOn == false {
        Log.info("    hot_reload: disabled")
    }
    let nLoc = config.locationCount()
    var i = 0
    while i < nLoc {
        let n = config.locationName(i: i)
        let e = config.locationExact(i: i)
        let p = config.locationPrefix(i: i)
        let u = config.locationUpstream(i: i)
        let r = config.locationRoot(i: i)
        Log.info("    [\(n)] exact=\(e) prefix=\(p) upstream=\(u) root=\(r)")
        i = i + 1
    }
    let nUp = config.upstreamCount()
    Log.info("    upstreams: \(nUp)")
    var j = 0
    while j < nUp {
        let n = config.upstreamName(idx: j)
        Log.info("      [\(j)] \(n)")
        j = j + 1
    }
    Log.info("    error pages: 404=\"\(config.error_body_for(status: 404))\" 502=\"\(config.error_body_for(status: 502))\" 504=\"\(config.error_body_for(status: 504))\"")
}

func endsWithJson(s: String) -> Bool {
    if s.count < 5 { return false }
    let n = s.count
    if s[n - 5] != "." { return false }
    if s[n - 4] != "j" { return false }
    if s[n - 3] != "s" { return false }
    if s[n - 2] != "o" { return false }
    if s[n - 1] != "n" { return false }
    return true
}

func resolveConfigPath() -> String {
    // Prefer explicit env (syx run only accepts one PATH).
    let fromEnv = Env.get("SYX_SGATE_CONFIG")
    while fromEnv != "" {
        return fromEnv
    }
    // Process.args() is the full CLI argv (e.g. syx, run, path, …).
    // Prefer an explicit *.json argument when the CLI permits it.
    // NOTE: do not use `if cond { }` inside this while — a false condition
    // aborts the enclosing function in the current VM.
    let args = Process.args()
    var chosen = ""
    var i = 0
    while i < args.count {
        let a = args[i]
        var probe = "\(a)"
        while endsWithJson(s: probe) {
            chosen = "\(a)"
            probe = ""
        }
        i = i + 1
    }
    while chosen != "" {
        return chosen
    }
    // cwd may be the repo root (`syx run ./tools/sgate`) or tools/sgate itself.
    while File.exists("sgate.json") {
        return "sgate.json"
    }
    while File.exists("tools/sgate/sgate.json") {
        return "tools/sgate/sgate.json"
    }
    return "sgate.json"
}

func main() {
    let cfgPath = resolveConfigPath()
    Log.info("sgate: loading config from \(cfgPath)")
    let ok = config.loadConfig(path: cfgPath)
    if !ok {
        Log.error("sgate: failed to load config at \(cfgPath)")
        return
    }

    // NOTE: reload.reloadBind currently corrupts module globals in the VM
    // when assigning RELOAD_PATH (wipes config.CONFIG). Hot-reload is
    // therefore deferred; config is loaded once at startup.

    let listen = config.server_listen()
    var port = config.server_port()

    // W1249 / ADR-1595: native TLS → PEM env + serve tls.port.
    // Sidecar: Process.spawn unavailable in this runtime — honest skip
    // (tls.sy retains socat/stunnel for docs / future; ws_routes unchanged).
    if config.tlsEnabled() {
        let mode = config.tlsMode()
        if mode == "native" {
            let ready = tls_native.tlsPrepareNativeFromConfig()
            if ready {
                port = config.tlsPort()
                Log.info("sgate: TLS native — Http.serve HTTPS on \(listen):\(port) (in-process rustls)")
            }
            if !ready {
                Log.error("sgate: TLS native prepare failed; falling back to plain")
            }
        }
        if mode == "sidecar" {
            Log.info("tls/ws sidecars: skipped (Process.spawn unavailable in this runtime); plain Http.serve on \(listen):\(port)")
        }
    }
    if !config.tlsEnabled() {
        Log.info("tls: disabled")
    }

    printBanner()
    Http.serve(addr: listen, port: port, handler: "handle")
}
