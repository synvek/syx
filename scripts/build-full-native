#!/usr/bin/env bash
# Build syx-cli with --features full-native.
# On Windows MSVC, inject +crt-static /INCLUDE:malloc only for this invocation
# (must not live in .cargo/config.toml — that contaminates syx_rt for native link).
#
# Linux host deps (Debian/Ubuntu) for llvm-sys system libs:
#   sudo apt install build-essential libffi-dev zlib1g-dev libxml2-dev libzstd-dev
#
# Linux note: SYX_LLVM static archives often contain *LLVM bitcode* (not ELF).
# rust-lld (rustc's LLVM, e.g. 23.x) ThinLTO of those objects aborts with
# `VP !prof should not have duplicate profile values`. Host bfd cannot read
# bitcode either (`file format not recognized`). Link with SYX clang/ld.lld
# (same LLVM major as the archives) instead. Prefer rebuilding ../llvm without
# -flto for native ELF .a when possible.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

TARGET="${CARGO_BUILD_TARGET:-}"
if [[ -z "$TARGET" ]]; then
  # Consume all of `rustc -vV` stdout. An early `awk …; exit` closes the pipe
  # while rustc is still writing; with `set -o pipefail` that becomes status 141
  # and this script exits before cargo runs ("instant success/fail").
  TARGET="$(rustc -vV | awk '/^host:/{print $2}')"
fi

ARGS=(build --release -p syx-cli --features full-native)
if [[ -n "${CARGO_BUILD_TARGET:-}" ]]; then
  ARGS+=(--target "$CARGO_BUILD_TARGET")
fi

json_rustflags() {
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@"
}

case "$TARGET" in
  *-pc-windows-msvc)
    # Keep default target/ free of crt-static so `cargo build -p syx-rt` / native
    # link keep a normal /MD runtime archive.
    ARGS+=(
      --target-dir target-full-native
      --config
      "target.${TARGET}.rustflags=[\"-C\",\"target-feature=+crt-static\",\"-C\",\"link-arg=/INCLUDE:malloc\"]"
    )
    ;;
  *-unknown-linux-*)
    PREFIX="${SYX_LLVM_PREFIX:-$ROOT/../llvm}"
    CLANG="$PREFIX/bin/clang"
    LLD="$PREFIX/bin/ld.lld"
    # Never `-Wl,--lto=off` (rust-lld rejects mode `off`).
    # SYX clang alone still defaults to /usr/bin/ld (bfd), which cannot read
    # bitcode .a → "file format not recognized". Must pass -fuse-ld=<SYX ld.lld>
    # so LTO uses the same LLVM major as the archives; also disable rust-lld.
    if [[ -x "$CLANG" && -x "$LLD" ]]; then
      RF="$(json_rustflags \
        -C lto=off \
        -C linker-features=-lld \
        -C "linker=${CLANG}" \
        -C "link-arg=-fuse-ld=${LLD}")"
      echo "build-full-native: Linux linker=${CLANG} fuse-ld=${LLD}"
    elif [[ -x "$LLD" ]]; then
      RF="$(json_rustflags -C lto=off -C linker-features=-lld -C "link-arg=-fuse-ld=${LLD}")"
      echo "build-full-native: Linux fuse-ld=${LLD} (cc driver; rust-lld off)"
    else
      echo "build-full-native: ERROR: need executable $LLD (and preferably $CLANG)" >&2
      echo "  to link SYX_LLVM bitcode archives. Host bfd cannot read bitcode;" >&2
      echo "  rust-lld ThinLTO with rustc LLVM aborts (VP !prof)." >&2
      echo "  Fix: install ld.lld/clang into the prefix, or rebuild LLVM without -flto." >&2
      exit 1
    fi
    ARGS+=(--config "target.${TARGET}.rustflags=${RF}")
    ;;
esac

if [[ -x "$ROOT/scripts/with-syx-llvm" ]]; then
  exec "$ROOT/scripts/with-syx-llvm" cargo "${ARGS[@]}" "$@"
fi
exec cargo "${ARGS[@]}" "$@"
