#!/usr/bin/env bash
# Build syx-cli with --features full-native.
# On Windows MSVC, inject +crt-static /INCLUDE:malloc only for this invocation
# (must not live in .cargo/config.toml — that contaminates syx_rt for native link).
#
# Linux host deps (Debian/Ubuntu) for llvm-sys system libs:
#   sudo apt install build-essential libffi-dev zlib1g-dev libxml2-dev libzstd-dev
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

TARGET="${CARGO_BUILD_TARGET:-}"
if [[ -z "$TARGET" ]]; then
  # Consume all of `rustc -vV` stdout. An early `awk …; exit` closes the pipe
  # while rustc is still writing; with `set -o pipefail` that becomes status 141
  # and this script exits before cargo runs ("instant success/fail").
  TARGET="$(rustc -vV | awk '/^host:/{print $2}')"
fi

ARGS=(build --release -p syx-cli --features full-native)
if [[ -n "${CARGO_BUILD_TARGET:-}" ]]; then
  ARGS+=(--target "$CARGO_BUILD_TARGET")
fi

case "$TARGET" in
  *-pc-windows-msvc)
    # Keep default target/ free of crt-static so `cargo build -p syx-rt` / native
    # link keep a normal /MD runtime archive.
    ARGS+=(
      --target-dir target-full-native
      --config
      "target.${TARGET}.rustflags=[\"-C\",\"target-feature=+crt-static\",\"-C\",\"link-arg=/INCLUDE:malloc\"]"
    )
    ;;
  *-unknown-linux-*)
    # Official LLVM .a often embeds bitcode. Default rust-lld then runs ThinLTO
    # with *rustc's* LLVM (e.g. 23.x) against SYX_LLVM 21 objects → abort
    # `VP !prof should not have duplicate profile values` (AMDGPUAsmParser…).
    # `-Wl,--lto=off` is invalid (lld only accepts full|thin|default).
    # Opt out of rust-lld so the host `cc`+bfd/gold link treats objects as ELF.
    ARGS+=(
      --config
      "target.${TARGET}.rustflags=[\"-C\",\"lto=off\",\"-C\",\"linker-features=-lld\"]"
    )
    ;;
esac

if [[ -x "$ROOT/scripts/with-syx-llvm" ]]; then
  exec "$ROOT/scripts/with-syx-llvm" cargo "${ARGS[@]}" "$@"
fi
exec cargo "${ARGS[@]}" "$@"
