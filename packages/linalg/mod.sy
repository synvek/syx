    /// Swap rows.
    public func swapRows(_ i: Int, _ j: Int) -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let nr = self.rows
        let nc = self.cols
        let n = nr * nc
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(nr, nc)
        let q = __syx_plugin_faer_to(out.handle)
        var k = 0
        while k < n {
            let row = k / nc
            let col = k % nc
            let dI = row - i
            let dJ = row - j
            let pickJ = 1 - __syx_int_min(1, __syx_int_max(0, dI) + __syx_int_max(0, 0 - dI))
            let pickI = 1 - __syx_int_min(1, __syx_int_max(0, dJ) + __syx_int_max(0, 0 - dJ))
            let sr = row + (j - row) * pickJ + (i - row) * pickI
            q[k] = 0.0 + p[sr * nc + col]
            k = k + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(q, nr, nc)
        out.rows = nr
        out.cols = nc
        return out
    }

