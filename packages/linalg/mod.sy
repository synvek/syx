    /// Argmin.
    public func argmin() -> Int {
        let p = __syx_plugin_faer_to(self.handle)
        let n = self.rows * self.cols
        var best = 0.0 + p[0]
        var bi = 0
        var i = 1
        while i < n {
            let x = 0.0 + p[i]
            let nb = __syx_f64_min(best, x)
            let changed = __syx_f64_compare(nb, best)
            let flag = 0 - changed
            bi = bi + (i - bi) * flag
            best = nb
            i = i + 1
        }
        return bi
    }

    /// Argmax.
