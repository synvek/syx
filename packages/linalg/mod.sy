/// W1072 / ADR-1418: P-SURF packed-SYX element-div/scalar-broadcast first-slice.
/// div / addScalar / subScalar / divScalar walk packed (no new faer host).
/// W1071 unary stay; `*` remains matmul.
/// W1068 / ADR-1414: structure/replication first-slice.
/// tile / kron / tril / triu walk packed (no new faer host).
/// W1067 reduce/norm stay.
/// Methods call `__syx_plugin_faer_to` directly (not `self.packed()`).
/// Flat /% loops for writeback (nested ArraySet historically broken).
/// No `A[i,j]` / no in-place setAt / no faer add host.
/// Not a Core prelude type; `import Linalg`. Not product Mat GA (needs E-00).
/// Must not live in `packages/core/math.sy`.

/// Packed-SYX matrix (`handle` + `rows`/`cols`); faer-backed via plugin host. ≠ product Mat GA.
public class Mat {
    public var handle: Int
    public var rows: Int
    public var cols: Int

    /// Construct from row-major packed data with `rows`×`cols`.
    public init(_ packed: Array<Float64>, rows: Int, cols: Int) {
        self.handle = __syx_plugin_faer_from(packed, rows, cols)
        self.rows = rows
        self.cols = cols
    }

    /// Drop the faer handle.
    deinit {
        __syx_plugin_v2probe_drop(self.handle)
    }

    /// Factory: matrix from packed Float64 data.
    public static func from(_ packed: Array<Float64>, rows: Int, cols: Int) -> Mat {
        return Mat(packed, rows: rows, cols: cols)
    }

    /// Factory: all-zero matrix.
    public static func zeros(rows: Int, cols: Int) -> Mat {
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(rows, cols)
        out.rows = rows
        out.cols = cols
        return out
    }

    /// Sum the first `n` elements of packed array `p`.
    public static func sumPacked(_ p: Array<Float64>, _ n: Int) -> Float64 {
        var acc = 0.0
        var i = 0
        while i < n {
            acc = acc + p[i]
            i = i + 1
        }
        return acc
    }

    /// Factory: all-ones matrix.
    public static func ones(rows: Int, cols: Int) -> Mat {
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(rows, cols)
        let p = __syx_plugin_faer_to(out.handle)
        var i = 0
        let n = rows * cols
        while i < n {
            p[i] = 1.0
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(p, rows, cols)
        out.rows = rows
        out.cols = cols
        return out
    }

    /// Factory: matrix filled with `v`.
    public static func filled(rows: Int, cols: Int, _ v: Float64) -> Mat {
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(rows, cols)
        let p = __syx_plugin_faer_to(out.handle)
        var i = 0
        let n = rows * cols
        while i < n {
            p[i] = v
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(p, rows, cols)
        out.rows = rows
        out.cols = cols
        return out
    }

    /// Factory: identity matrix of size `n`.
    public static func eye(_ n: Int) -> Mat {
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(n, n)
        let p = __syx_plugin_faer_to(out.handle)
        var i = 0
        while i < n {
            p[i * n + i] = 1.0
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(p, n, n)
        out.rows = n
        out.cols = n
        return out
    }

    /// Factory: diagonal matrix from vector/matrix `d`.
    public static func fromDiagonal(_ d: Mat) -> Mat {
        let p = __syx_plugin_faer_to(d.handle)
        var k = d.rows
        if d.cols > k {
            k = d.cols
        }
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(k, k)
        let q = __syx_plugin_faer_to(out.handle)
        var i = 0
        while i < k {
            q[i * k + i] = p[i]
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(q, k, k)
        out.rows = k
        out.cols = k
        return out
    }

    /// Export row-major packed Float64 data.
    public func packed() -> Array<Float64> {
        return __syx_plugin_faer_to(self.handle)
    }

    /// Element at (`row`, `col`).
    public func at(_ row: Int, col: Int) -> Float64 {
        let p = __syx_plugin_faer_to(self.handle)
        return p[row * self.cols + col]
    }

    /// Copy with element (`row`, `col`) replaced.
    public func withAt(_ row: Int, col: Int, _ v: Float64) -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let nr = self.rows
        let nc = self.cols
        let n = nr * nc
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(nr, nc)
        let q = __syx_plugin_faer_to(out.handle)
        var i = 0
        while i < n {
            q[i] = p[i]
            i = i + 1
        }
        q[row * nc + col] = v
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(q, nr, nc)
        out.rows = nr
        out.cols = nc
        return out
    }

    /// Extract row as a matrix/vector.
    public func row(_ i: Int) -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let nc = self.cols
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(1, nc)
        let q = __syx_plugin_faer_to(out.handle)
        var c = 0
        while c < nc {
            q[c] = p[i * nc + c]
            c = c + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(q, 1, nc)
        out.rows = 1
        out.cols = nc
        return out
    }

    /// Extract column as a matrix/vector.
    public func col(_ j: Int) -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let nr = self.rows
        let nc = self.cols
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(nr, 1)
        let q = __syx_plugin_faer_to(out.handle)
        var r = 0
        while r < nr {
            q[r] = p[r * nc + j]
            r = r + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(q, nr, 1)
        out.rows = nr
        out.cols = 1
        return out
    }

    /// Extract the main diagonal.
    public func diagonal() -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let nr = self.rows
        let nc = self.cols
        var k = nr
        if nc < nr {
            k = nc
        }
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(k, 1)
        let q = __syx_plugin_faer_to(out.handle)
        var i = 0
        while i < k {
            q[i] = p[i * nc + i]
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(q, k, 1)
        out.rows = k
        out.cols = 1
        return out
    }

    /// Sum of diagonal elements.
    public func trace() -> Float64 {
        let p = __syx_plugin_faer_to(self.handle)
        let nr = self.rows
        let nc = self.cols
        var k = nr
        if nc < nr {
            k = nc
        }
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(k, 1)
        let q = __syx_plugin_faer_to(out.handle)
        var i = 0
        while i < k {
            q[i] = p[i * nc + i]
            i = i + 1
        }
        return Mat.sumPacked(q, k)
    }

    /// Element-wise absolute value.
    public func abs() -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let nr = self.rows
        let nc = self.cols
        let n = nr * nc
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(nr, nc)
        let q = __syx_plugin_faer_to(out.handle)
        var i = 0
        while i < n {
            q[i] = p[i]
            i = i + 1
        }
        i = 0
        while i < n {
            let x = q[i] * 1.0
            q[i] = __syx_f64_max(x, 0.0 - x)
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(q, nr, nc)
        out.rows = nr
        out.cols = nc
        return out
    }

    /// Reshape to new dimensions (packed size must match).
    public func reshape(_ rows: Int, cols: Int) -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let n = rows * cols
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(rows, cols)
        let q = __syx_plugin_faer_to(out.handle)
        var i = 0
        while i < n {
            q[i] = p[i]
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(q, rows, cols)
        out.rows = rows
        out.cols = cols
        return out
    }

    /// Flatten to a row or column vector.
    public func flatten() -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let n = self.rows * self.cols
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(1, n)
        let q = __syx_plugin_faer_to(out.handle)
        var i = 0
        while i < n {
            q[i] = p[i]
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(q, 1, n)
        out.rows = 1
        out.cols = n
        return out
    }

    /// Horizontal stack.
    public func hstack(_ other: Mat) -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let q = __syx_plugin_faer_to(other.handle)
        let nr = self.rows
        let ncA = self.cols
        let ncB = other.cols
        let nc = ncA + ncB
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(nr, nc)
        let r = __syx_plugin_faer_to(out.handle)
        var i = 0
        let nA = nr * ncA
        while i < nA {
            let row = i / ncA
            let c = i % ncA
            r[row * nc + c] = p[i]
            i = i + 1
        }
        i = 0
        let nB = nr * ncB
        while i < nB {
            let row = i / ncB
            let c = i % ncB
            r[row * nc + ncA + c] = q[i]
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(r, nr, nc)
        out.rows = nr
        out.cols = nc
        return out
    }

    /// Vertical stack.
    public func vstack(_ other: Mat) -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let q = __syx_plugin_faer_to(other.handle)
        let nc = self.cols
        let nrA = self.rows
        let nrB = other.rows
        let nr = nrA + nrB
        let nA = nrA * nc
        let nB = nrB * nc
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(nr, nc)
        let r = __syx_plugin_faer_to(out.handle)
        var i = 0
        while i < nA {
            r[i] = p[i]
            i = i + 1
        }
        i = 0
        while i < nB {
            r[nA + i] = q[i]
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(r, nr, nc)
        out.rows = nr
        out.cols = nc
        return out
    }

    /// Deep copy (new handle).
    public func copy() -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let nr = self.rows
        let nc = self.cols
        let n = nr * nc
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(nr, nc)
        let q = __syx_plugin_faer_to(out.handle)
        var i = 0
        while i < n {
            q[i] = p[i]
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(q, nr, nc)
        out.rows = nr
        out.cols = nc
        return out
    }

    /// Matrix transpose.
    public func transposed() -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let nr = self.rows
        let nc = self.cols
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(nc, nr)
        let q = __syx_plugin_faer_to(out.handle)
        var i = 0
        let n = nr * nc
        while i < n {
            let r = i / nc
            let c = i % nc
            q[c * nr + r] = p[i]
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(q, nc, nr)
        out.rows = nc
        out.cols = nr
        return out
    }

    // W1125: thin-wire scale via filled + in-process faer_hadamard (compose; no faer_scale host).
    /// Scale all elements by a scalar.
    public func scale(_ factor: Float64) -> Mat {
        let s = Mat.filled(rows: self.rows, cols: self.cols, factor)
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_hadamard(self.handle, s.handle)
        out.rows = self.rows
        out.cols = self.cols
        __syx_plugin_v2probe_drop(s.handle)
        return out
    }

    // W1124: thin-wire negated via zeros + in-process faer_sub.
    /// Element-wise negation.
    public func negated() -> Mat {
        let z = Mat.zeros(rows: self.rows, cols: self.cols)
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_sub(z.handle, self.handle)
        out.rows = self.rows
        out.cols = self.cols
        __syx_plugin_v2probe_drop(z.handle)
        return out
    }

    // W1121: thin-wire to in-process faer hadamard.
    /// Element-wise (Hadamard) product.
    public func hadamard(_ other: Mat) -> Mat {
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_hadamard(self.handle, other.handle)
        out.rows = self.rows
        out.cols = self.cols
        return out
    }

    /// Sum of all elements.
    public func sum() -> Float64 {
        let p = __syx_plugin_faer_to(self.handle)
        return Mat.sumPacked(p, self.rows * self.cols)
    }

    /// Mean of all elements.
    public func mean() -> Float64 {
        let p = __syx_plugin_faer_to(self.handle)
        let n = self.rows * self.cols
        let s = Mat.sumPacked(p, n)
        var dn = 0.0
        var i = 0
        while i < n {
            dn = dn + 1.0
            i = i + 1
        }
        return s / dn
    }

    // W1117: median / quantile / medianRows / medianCols.
    // Whole-matrix: faer_to copy + Array.sorted.
    // Axis: in-place bubble on a detached copy (row windows / manual transpose
    // buffer for cols). Avoid live zeros(nc) scratch alongside zeros(nr) acc —
    // identical zero Arrays of equal length can alias under ArraySet.
    /// Median sorted.
    public static func medianSorted(_ s: Array<Float64>, _ n: Int) -> Float64 {
        let odd = n % 2
        if odd == 1 {
            return 0.0 + s[n / 2]
        }
        let a = 0.0 + s[n / 2 - 1]
        let b = 0.0 + s[n / 2]
        return (a + b) / 2.0
    }

    /// Median of a contiguous sorted packed range.
    public static func medianSortedRange(_ s: Array<Float64>, _ start: Int, _ n: Int) -> Float64 {
        let odd = n % 2
        if odd == 1 {
            return 0.0 + s[start + n / 2]
        }
        let a = 0.0 + s[start + n / 2 - 1]
        let b = 0.0 + s[start + n / 2]
        return (a + b) / 2.0
    }

    /// Quantile `q` of a sorted packed vector.
    public static func quantileSorted(_ s: Array<Float64>, _ n: Int, _ q: Float64) -> Float64 {
        return Mat.quantileSortedRange(s, 0, n, q)
    }

    /// Quantile `q` of a contiguous sorted packed range.
    public static func quantileSortedRange(
        _ s: Array<Float64>,
        _ start: Int,
        _ n: Int,
        _ q: Float64
    ) -> Float64 {
        var nm1 = 0.0
        var t = 1
        while t < n {
            nm1 = nm1 + 1.0
            t = t + 1
        }
        let pos = q * nm1
        let fl = __syx_f64_floor(pos)
        var lo = 0
        var i = 0
        while i < n {
            let fi = 0.0 + i
            let c = __syx_f64_compare(fi, fl)
            let absC = c * c
            let flag = 1 - absC
            lo = lo + (i - lo) * flag
            i = i + 1
        }
        var hi = lo
        if lo + 1 < n {
            hi = lo + 1
        }
        let frac = pos - fl
        let a = 0.0 + s[start + lo]
        let b = 0.0 + s[start + hi]
        return a + (b - a) * frac
    }

    /// Return a sorted copy of packed data.
    public static func sortedCopyPacked(_ p: Array<Float64>, _ n: Int) -> Array<Float64> {
        let tmp = Mat.zeros(rows: 1, cols: n)
        let q = __syx_plugin_faer_to(tmp.handle)
        var i = 0
        while i < n {
            q[i] = 0.0 + p[i]
            i = i + 1
        }
        return q.sorted()
    }

    /// In-place bubble-sort a packed range (helper).
    public static func bubbleSortRange(_ a: Array<Float64>, _ start: Int, _ n: Int) {
        var i = 0
        while i < n {
            var j = 0
            while j < n - 1 - i {
                let x = 0.0 + a[start + j]
                let y = 0.0 + a[start + j + 1]
                let cmp = __syx_f64_compare(x, y)
                if cmp > 0 {
                    a[start + j] = 0.0 + y
                    a[start + j + 1] = 0.0 + x
                }
                j = j + 1
            }
            i = i + 1
        }
    }

    /// Median.
    public func median() -> Float64 {
        let p = __syx_plugin_faer_to(self.handle)
        let n = self.rows * self.cols
        let s = Mat.sortedCopyPacked(p, n)
        return Mat.medianSorted(s, n)
    }

    /// Quantile.
    public func quantile(_ q: Float64) -> Float64 {
        let p = __syx_plugin_faer_to(self.handle)
        let n = self.rows * self.cols
        let s = Mat.sortedCopyPacked(p, n)
        return Mat.quantileSorted(s, n, q)
    }

    /// Median rows.
    public func medianRows() -> Mat {
        let nr = self.rows
        let nc = self.cols
        let src = __syx_plugin_faer_to(self.handle)
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(nr, 1)
        let r = __syx_plugin_faer_to(out.handle)
        var row = 0
        while row < nr {
            Mat.bubbleSortRange(src, row * nc, nc)
            let m = Mat.medianSortedRange(src, row * nc, nc)
            r[row] = 0.0 + m
            row = row + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(r, nr, 1)
        out.rows = nr
        out.cols = 1
        return out
    }

    /// Median cols.
    public func medianCols() -> Mat {
        let nr = self.rows
        let nc = self.cols
        let n = nr * nc
        let p = __syx_plugin_faer_to(self.handle)
        // Materialize transpose into a detached buffer before allocating the result.
        let tMat = Mat.zeros(rows: 1, cols: n)
        let src = __syx_plugin_faer_to(tMat.handle)
        var i = 0
        while i < n {
            let row = i / nc
            let col = i % nc
            src[col * nr + row] = 0.0 + p[i]
            i = i + 1
        }
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(1, nc)
        let r = __syx_plugin_faer_to(out.handle)
        var col = 0
        while col < nc {
            Mat.bubbleSortRange(src, col * nr, nr)
            let m = Mat.medianSortedRange(src, col * nr, nr)
            r[col] = 0.0 + m
            col = col + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(r, 1, nc)
        out.rows = 1
        out.cols = nc
        return out
    }

    // W1118: quantileRows / quantileCols — same axis shapes + W1117 quantileSorted rule.
    /// Quantile rows.
    public func quantileRows(_ q: Float64) -> Mat {
        let nr = self.rows
        let nc = self.cols
        let src = __syx_plugin_faer_to(self.handle)
        let out = Mat([0.0], rows: 1, cols: 1)
