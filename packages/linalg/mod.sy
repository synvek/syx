    /// Sqrt.
    public func sqrt() -> Mat {
        let p = __syx_plugin_faer_to(self.handle)
        let nr = self.rows
        let nc = self.cols
        let n = nr * nc
        let out = Mat([0.0], rows: 1, cols: 1)
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_zeros(nr, nc)
        let q = __syx_plugin_faer_to(out.handle)
        var i = 0
        while i < n {
            let x = 0.0 + p[i]
            // Avoid MathFloat HostFn on ArraySet RHS (ArgsEarly double-push).
            // Unrolled Heron — nested while in this slot historically zeros writeback.
            var y = 0.5 * x + 0.5
            y = 0.5 * (y + x / y)
            y = 0.5 * (y + x / y)
            y = 0.5 * (y + x / y)
            y = 0.5 * (y + x / y)
            y = 0.5 * (y + x / y)
            y = 0.5 * (y + x / y)
            y = 0.5 * (y + x / y)
            y = 0.5 * (y + x / y)
            q[i] = y
            i = i + 1
        }
        __syx_plugin_v2probe_drop(out.handle)
        out.handle = __syx_plugin_faer_from(q, nr, nc)
        out.rows = nr
        out.cols = nc
        return out
    }

