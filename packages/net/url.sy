/// ADR-236 / M2-S4-01: `Url.parse` returns `Url` (not糊墙 `Object`).
/// Runtime parse bag also has `protocol` (keyword; not declared as a property).
public class Url {
    public var href: String
    public var host: String
    public var port: Int
    public var path: String
    public var query: String

    /// Parse a URL string into components.
    public static func parse(text: String) -> Url {
        return SyxHost.url_parse(text)
    }

    /// Encode query dictionary → query string. R-9-01: `query: Dictionary` (≠ Object).
    public static func encodeQuery(query: Dictionary) -> String {
        return SyxHost.url_encode_query(query)
    }

    /// Build a URL string from components. R-9-01: `query: Dictionary` (≠ Object).
    public static func build(base: String, path: String, query: Dictionary) -> String {
        return SyxHost.url_build(base, path, query)
    }
}
