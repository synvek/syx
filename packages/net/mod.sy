/// ADR-236 / M2-S4-01: facade returns `HTTPResponse` (not a paste-wall any-value bag).
/// SA-4-02: primary fetch/request/post paths are typed (no untyped options/body parameters).
public class Http {
    /// HTTP fetch (GET) returning `HTTPResponse`.
    public static func fetch(url: String) -> HTTPResponse {
        return SyxHost.http_get(url)
    }

    /// Generic HTTP GET request; returns `HTTPResponse`.
    public static func request(url: String) -> HTTPResponse {
        return SyxHost.http_get(url)
    }

    /// HTTP GET `url`; returns `HTTPResponse`.
    public static func get(url: String) -> HTTPResponse {
        return SyxHost.http_get(url)
    }

    /// HTTP POST `url` with UTF-8 `body`; returns `HTTPResponse`.
    public static func post(url: String, body: String) -> HTTPResponse {
        return SyxHost.http_post(url, body)
    }

    /// Build an `HTTPResponse` shell from status + body text.
    public static func response(status: Int, body: String) -> HTTPResponse {
        return SyxHost.http_make_response(status, body)
    }

    /// Serve HTTP on `addr`:`port` with `handler`.
    public static func serve(addr: String, port: Int, handler: String) {
        SyxHost.http_serve(addr, port, handler)
    }

    /// ADR-238 / M2-S4-03b: stop accepting; finish in-flight request; `serve` returns.
    public static func shutdown() {
        SyxHost.http_serve_shutdown()
    }
}
