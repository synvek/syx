// Process environment variables (host `__syx_env_*`).

/// Read and write environment variables for the current process.
public class Env {
    /// Read environment variable `key` (empty if unset).
    public static func get(key: String) -> String {
    return __syx_env_get(key)
}
    /// Set environment variable `key` to `value`.
    public static func set(key: String, value: String) {
    __syx_env_set(key, value)
}
}
