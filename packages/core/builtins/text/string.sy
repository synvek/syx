// Unicode string. Prelude; hand-authored authority (not regenerated by build.rs).

/// UTF-8 text value; host ops via `__syx_str_*`.
@builtin("text.string")
public class String: Equatable, Hashable, CustomStringConvertible, Comparable {
    /// Split on separator `sep`.
    public static func split(text: String, sep: String) -> Array {
        return __syx_str_split(text, sep)
    }

    /// Trim leading/trailing whitespace.
    public static func trim(text: String) -> String {
        return __syx_str_trim(text)
    }

    /// Whether `text` starts with `prefix`.
    public static func hasPrefix(text: String, prefix: String) -> Bool {
        return __syx_str_has_prefix(text, prefix)
    }

    /// Lowercase copy.
    public static func lowercased(text: String) -> String {
        return __syx_str_lowercased(text)
    }

    /// Uppercase copy.
    public static func uppercased(text: String) -> String {
        return __syx_str_uppercased(text)
    }

    /// Regex match groups / hits for `pattern`.
    public static func matches(text: String, pattern: String) -> Array {
        return __syx_str_matches(text, pattern)
    }

    /// Extended grapheme / character count (host length).
    public static func count(text: String) -> Int {
        return __syx_str_length(text)
    }

    /// Unicode scalar count.
    public static func unicodeScalarCount(text: String) -> Int {
        return __syx_str_unicode_scalar_count(text)
    }

    /// Unicode scalars as an array.
    public static func unicodeScalars(text: String) -> Array {
        return __syx_str_unicode_scalars(text)
    }

    /// UTF-8 byte count.
    public static func utf8Count(text: String) -> Int {
        return __syx_str_utf8_count(text)
    }

    /// UTF-8 bytes as an array.
    public static func utf8Bytes(text: String) -> Array {
        return __syx_str_utf8_bytes(text)
    }

    /// NFC normalization.
    public static func normalizedNFC(text: String) -> String {
        return __syx_str_normalized_nfc(text)
    }

    /// NFD normalization.
    public static func normalizedNFD(text: String) -> String {
        return __syx_str_normalized_nfd(text)
    }

    /// Case-folded copy for caseless compare.
    public static func caseFolded(text: String) -> String {
        return __syx_str_case_folded(text)
    }
}

extension String {
    /// Character / grapheme count (host `__syx_str_length`).
    var count: Int {
        get { return __syx_str_length(self) }
    }

    /// Whether the string has zero grapheme characters (S1-I11 book `isEmpty`).
    var isEmpty: Bool {
        get { return __syx_str_length(self) == 0 }
    }

    /// Split on separator `sep`.
    func split(sep: String) -> Array {
        return __syx_str_split(self, sep)
    }

    /// Trim leading/trailing whitespace.
    func trim() -> String {
        return __syx_str_trim(self)
    }

    /// Whether this string starts with `prefix`.
    func hasPrefix(prefix: String) -> Bool {
        return __syx_str_has_prefix(self, prefix)
    }

    /// Lowercase copy.
    func lowercased() -> String {
        return __syx_str_lowercased(self)
    }

    /// Uppercase copy.
    func uppercased() -> String {
        return __syx_str_uppercased(self)
    }

    /// Regex match groups / hits for `pattern`.
    func matches(pattern: String) -> Array {
        return __syx_str_matches(self, pattern)
    }

    /// Combine into a hasher (`Hashable`).
    func hash(into hasher: Hasher) {
        Hasher.combine(hasher: hasher, value: self)
    }

    /// User-facing string conversion (`CustomStringConvertible`).
    func description() -> String {
        return __syx_value_description(self)
    }

    /// Debug string conversion.
    func debugDescription() -> String {
        return __syx_value_debug_description(self)
    }

    /// Three-way compare (`Comparable`); host `__syx_value_compare`.
    func compare(other: String) -> Int {
        return __syx_value_compare(self, other)
    }
}
