// Untyped reference / dictionary shell. Hand-authored authority (not regenerated).
// Dictionary-like members on Object enable dynamic key access during the String-shell era.

/// Root reference type (`Equatable` / `Hashable` / `CustomStringConvertible`).
@builtin("reference.object")
public class Object: Equatable, Hashable, CustomStringConvertible {
}

extension Object {
    /// Entry count when treated as a dictionary shell.
    var count: Int {
        get { return SyxHost.dict_count(self) }
    }

    /// Whether the dictionary shell has no entries.
    var isEmpty: Bool {
        get { return SyxHost.dict_count(self) == 0 }
    }

    /// Lookup value for `key` (`SyxHost.dict_get`).
    func valueForKey(key: String) -> Object {
        return SyxHost.dict_get(self, key)
    }

    /// Set `key` → `value`; returns the updated shell.
    func put(key: String, value: Object) -> Object {
        return SyxHost.dict_set(self, key, value)
    }

    /// Whether `key` is present.
    func containsKey(key: String) -> Bool {
        return SyxHost.dict_contains(self, key)
    }

    /// All keys as an `Array`.
    func keys() -> Array {
        return SyxHost.dict_keys(self)
    }

    /// All values as an `Array`.
    func values() -> Array {
        return SyxHost.dict_values(self)
    }

    /// Remove `key`; returns whether it was present.
    func remove(key: String) -> Bool {
        return SyxHost.dict_remove(self, key)
    }

    /// Combine into a hasher (`Hashable`).
    func hash(into hasher: Hasher) {
        SyxHost.hasher_combine(hasher, self)
    }

    /// User-facing string conversion (`CustomStringConvertible`).
    func description() -> String {
        return SyxHost.value_description(self)
    }

    /// Debug string conversion.
    func debugDescription() -> String {
        return SyxHost.value_debug_description(self)
    }
}
