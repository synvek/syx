// Ordered unique collection. Prelude; hand-authored authority.
// R-41: public Object-shell → OrderedSet / Sendable (insertion order preserved);
// not a full generic OrderedSet<T> product GA.

/// Unique elements in insertion order; host `SyxHost.ordered_set_*`.
@builtin("collection.ordered_set")
public class OrderedSet {
    /// Create an empty ordered set.
    public static func new() -> OrderedSet {
        return SyxHost.ordered_set_new()
    }

    /// Insert `item` if absent; returns the set.
    public static func insert(set: OrderedSet, item: Sendable) -> OrderedSet {
        return SyxHost.ordered_set_insert(set, item)
    }

    /// Membership test.
    public static func contains(set: OrderedSet, item: Sendable) -> Bool {
        return SyxHost.ordered_set_contains(set, item)
    }
}
