    }

    /// Clamp `x` into `[lo, hi]` (inclusive); host `SyxHost.{{SLUG}}_min` / `_max`.
    public static func clamp(x: {{TY}}, lo: {{TY}}, hi: {{TY}}) -> {{TY}} {
        return SyxHost.{{SLUG}}_min(SyxHost.{{SLUG}}_max(x, lo), hi)
    }

