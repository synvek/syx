/// 8-bit signed integer (`Int8`). Prelude; host ops via `__syx_i8_*`.
@builtin("numeric.i8")
public class Int8: Equatable, Hashable, CustomStringConvertible, Comparable {
    /// Smallest representable value (type bound, not binary min).
    public static let min: Int8 = -128i8

    /// Largest representable value (type bound, not binary max).
    public static let max: Int8 = 127i8

    /// Absolute value (host `__syx_i8_abs`).
    public static func abs(x: Int8) -> Int8 {
        return __syx_i8_abs(x)
    }

    /// Signum: `-1`, `0`, or `1`.
    public static func sign(x: Int8) -> Int {
        if x < 0i8 {
            return -1
        }
        if x > 0i8 {
            return 1
        }
        return 0
    }

    /// Bit width of the underlying representation.
    public static func bitWidth() -> Int {
        return 8
    }

    /// Byte width of the underlying representation.
    public static func byteWidth() -> Int {
        return 1
    }

    /// Additive identity for this type.
    public static func zero() -> Int8 {
        return 0i8
    }

    /// Clamp `x` into `[lo, hi]` (inclusive); host `__syx_i8_min` / `_max`.
    public static func clamp(x: Int8, lo: Int8, hi: Int8) -> Int8 {
        return __syx_i8_min(__syx_i8_max(x, lo), hi)
    }

}

extension Int8 {
