// Arbitrary-precision integer. Prelude; hand-authored authority (not regenerated).

/// Unbounded signed integer; host ops via `SyxHost.bigint_*`.
@builtin("numeric.bigint")
public class BigInt: Equatable, Hashable, CustomStringConvertible, Comparable {
    /// Parse a decimal integer string into a `BigInt`.
    public static func fromString(text: String) -> BigInt {
        return SyxHost.bigint_from_string(text)
    }

    /// Addition.
    public static func add(a: BigInt, b: BigInt) -> BigInt {
        return SyxHost.bigint_add(a, b)
    }

    /// Subtraction.
    public static func sub(a: BigInt, b: BigInt) -> BigInt {
        return SyxHost.bigint_sub(a, b)
    }

    /// Multiplication.
    public static func mul(a: BigInt, b: BigInt) -> BigInt {
        return SyxHost.bigint_mul(a, b)
    }

    /// Three-way compare as a free function (`-1` / `0` / `1`).
    public static func cmp(a: BigInt, b: BigInt) -> Int {
        return SyxHost.bigint_cmp(a, b)
    }
}

extension BigInt {
    /// Combine into a hasher (`Hashable`).
    func hash(into hasher: Hasher) {
        SyxHost.hasher_combine(hasher, self)
    }

    /// User-facing string conversion (`CustomStringConvertible`).
    func description() -> String {
        return SyxHost.value_description(self)
    }

    /// Debug string conversion.
    func debugDescription() -> String {
        return SyxHost.value_debug_description(self)
    }

    /// Three-way compare (`Comparable`); host `SyxHost.bigint_cmp`.
    func compare(other: BigInt) -> Int {
        return SyxHost.bigint_cmp(self, other)
    }
}
