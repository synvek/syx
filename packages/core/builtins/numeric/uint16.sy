/// 16-bit unsigned integer (`UInt16`). Prelude; host ops via `SyxHost.u16_*`.
@builtin("numeric.u16")
public class UInt16: Equatable, Hashable, CustomStringConvertible, Comparable {
    /// Smallest representable value (type bound, not binary min).
    public static let min: UInt16 = 0u16

    /// Largest representable value (type bound, not binary max).
    public static let max: UInt16 = 65535u16

    /// Bit width of the underlying representation.
    public static func bitWidth() -> Int {
        return 16
    }

    /// Byte width of the underlying representation.
    public static func byteWidth() -> Int {
        return 2
    }

    /// Additive identity for this type.
    public static func zero() -> UInt16 {
        return 0u16
    }

    /// Clamp `x` into `[lo, hi]` (inclusive); host `SyxHost.u16_min` / `_max`.
    public static func clamp(x: UInt16, lo: UInt16, hi: UInt16) -> UInt16 {
        return SyxHost.u16_min(SyxHost.u16_max(x, lo), hi)
    }

}

