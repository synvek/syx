/// 128-bit signed integer (`Int128`). Prelude; host ops via `__syx_i128_*`.
@builtin("numeric.i128")
public class Int128: Equatable, Hashable, CustomStringConvertible, Comparable {
    /// Smallest representable value (type bound, not binary min).
    public static var min: Int128 {
        get {
            let one: Int128 = 1i128
            return one << 127
        }
    }

    /// Largest representable value (type bound, not binary max).
    public static var max: Int128 {
        get {
            let one: Int128 = 1i128
            let mn: Int128 = one << 127
            return mn - 1i128
