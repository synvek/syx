    public static func clamp(x: Int128, lo: Int128, hi: Int128) -> Int128 {
        return __syx_i128_min(__syx_i128_max(x, lo), hi)
    }

    /// Leading zero bit count for a `UInt128` bit pattern (via `Math`).
    public static func leadingZeros(x: UInt128) -> Int {
