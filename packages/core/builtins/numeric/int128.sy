    /// Signum: `-1`, `0`, or `1`.
    public static func sign(x: Int128) -> Int {
        if x < 0i128 {
            return -1
        }
        if x > 0i128 {
            return 1
        }
        return 0
    }

    /// Bit width of the underlying representation.
    public static func bitWidth() -> Int {
