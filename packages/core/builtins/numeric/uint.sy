/// 64-bit unsigned integer (`UInt`). Prelude; host ops via `SyxHost.uint_*`.
@builtin("numeric.uint")
public class UInt: Equatable, Hashable, CustomStringConvertible, Comparable {
    /// Smallest representable value (type bound, not binary min).
    public static let min: UInt = 0

    /// Largest representable value (type bound, not binary max).
    public static var max: UInt {
        get {
            let z: UInt = 0
            let one: UInt = 1
            return z - one
        }
    }

    /// Bit width of the underlying representation.
    public static func bitWidth() -> Int {
        return 64
    }

    /// Byte width of the underlying representation.
    public static func byteWidth() -> Int {
        return 8
    }

    /// Additive identity for this type.
    public static func zero() -> UInt {
        return 0
    }

    /// Clamp `x` into `[lo, hi]` (inclusive); host `SyxHost.uint_min` / `_max`.
    public static func clamp(x: UInt, lo: UInt, hi: UInt) -> UInt {
        return SyxHost.uint_min(SyxHost.uint_max(x, lo), hi)
    }

}

extension UInt {
    /// Combine into a hasher (`Hashable`).
    func hash(into hasher: Hasher) {
        SyxHost.hasher_combine(hasher, self)
    }

    /// User-facing string conversion (`CustomStringConvertible`).
    func description() -> String {
