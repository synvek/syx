    }

    /// Debug string conversion.
    func debugDescription() -> String {
        return SyxHost.value_debug_description(self)
    }

    /// Three-way compare (`Comparable`); host `SyxHost.uint_compare`.
    func compare(other: UInt) -> Int {
        return SyxHost.uint_compare(self, other)
    }
}

