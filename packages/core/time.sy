// Wall-clock milliseconds and sleep (SyxHost.time_*).
// Higher-level calendar types live under `import System`.

/// Epoch milliseconds, sleep, and simple timestamp parse.
public class Time {
    /// Current wall-clock time in milliseconds.
    public static func nowMs() -> Int {
        return SyxHost.time_now_ms()
    }
    /// Block the current task for `ms` milliseconds.
    public static func sleepMs(ms: Int) {
        SyxHost.time_sleep_ms(ms)
    }
    /// Parse timestamp string to epoch ms (empty → now).
    public static func parseTimestampMs(s: String) -> Int {
        if s == ""
        return SyxHost.time_now_ms()
        let parsed = SyxHost.datetime_parse(s)
        return SyxHost.keypath_get(parsed, "DateTime", "ms", false)
    }
}

