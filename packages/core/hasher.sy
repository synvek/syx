public class Hasher {
    public static func newHasher() -> Hasher {
    return __syx_hasher_new()
}
    public static func combine(hasher: Hasher, value: Object) -> Hasher {
    return __syx_hasher_combine(hasher, value)
}
    public static func finalize(hasher: Hasher) -> Int {
    return __syx_hasher_finalize(hasher)
}
    public static func objectId(value: Object) -> ObjectIdentifier {
    return __syx_object_identifier(value)
}
}
