// Incremental hasher for `Hashable` (host `SyxHost.hasher_*`).

/// Combine values into a hash; used by `hash(into:)` witnesses.
public class Hasher {
    /// Create a new incremental `Hasher`.
    public static func newHasher() -> Hasher {
    return SyxHost.hasher_new()
}
    /// Combine `value` into `hasher`; returns the hasher.
    public static func combine(hasher: Hasher, value: Object) -> Hasher {
    return SyxHost.hasher_combine(hasher, value)
}
    /// Finalize `hasher` into an `Int` hash.
    public static func finalize(hasher: Hasher) -> Int {
    return SyxHost.hasher_finalize(hasher)
}
    /// Stable `ObjectIdentifier` for a class instance.
    public static func objectId(value: Object) -> ObjectIdentifier {
    return SyxHost.object_identifier(value)
}
}
