public class Math {
    // --- constants (Rust f64::consts; lowercase static getters) ---
    public static func pi() -> Float64 {
        return 3.141592653589793
    }
    public static func e() -> Float64 {
        return 2.718281828459045
    }
    public static func tau() -> Float64 {
        return 6.283185307179586
    }
    public static func ln2() -> Float64 {
        return 0.6931471805599453
    }
    public static func ln10() -> Float64 {
        return 2.302585092994046
    }
    public static func log2e() -> Float64 {
        return 1.4426950408889634
    }
    public static func log10e() -> Float64 {
        return 0.4342944819032518
    }
    public static func sqrt2() -> Float64 {
        return 1.4142135623730951
    }
    public static func fracPi2() -> Float64 {
        return 1.5707963267948966
    }
    public static func fracPi4() -> Float64 {
        return 0.7853981633974483
    }

    public static func add(_ a: Int, _ b: Int) -> Int {
        return a + b
    }
    public static func sub(_ a: Int, _ b: Int) -> Int {
        return a - b
    }
    public static func max(_ a: Int, _ b: Int) -> Int {
        return __syx_int_max(a, b)
    }
    public static func min(_ a: Int, _ b: Int) -> Int {
        return __syx_int_min(a, b)
    }
    public static func abs(_ x: Int) -> Int {
        return __syx_int_abs(x)
    }
    public static func abs128(_ x: Int128) -> Int128 {
        return __syx_i128_abs(x)
    }
    public static func leadingZeros128(_ x: UInt128) -> Int {
        return __syx_leading_zeros128(x)
    }

    // Int tools (pure SYX)
    public static func sign(_ x: Int) -> Int {
        if x < 0 {
            return -1
        }
        if x > 0 {
            return 1
        }
        return 0
    }
    public static func clamp(_ x: Int, _ lo: Int, _ hi: Int) -> Int {
        return __syx_int_min(__syx_int_max(x, lo), hi)
    }
    public static func gcd(_ a: Int, _ b: Int) -> Int {
        var x = __syx_int_abs(a)
        var y = __syx_int_abs(b)
        while y != 0 {
            let t = x % y
            x = y
            y = t
        }
        return x
    }
    public static func lcm(_ a: Int, _ b: Int) -> Int {
        if a == 0 || b == 0 {
            return 0
        }
        let g = Math.gcd(a, b)
        return __syx_int_abs(a / g * b)
    }

    // Float64 convenience
    public static func fmax(_ a: Float64, _ b: Float64) -> Float64 {
        return __syx_f64_max(a, b)
    }
    public static func fmin(_ a: Float64, _ b: Float64) -> Float64 {
        return __syx_f64_min(a, b)
    }
    public static func fabs(_ x: Float64) -> Float64 {
        return __syx_f64_abs(x)
    }
    public static func fclamp(_ x: Float64, _ lo: Float64, _ hi: Float64) -> Float64 {
        return __syx_f64_min(__syx_f64_max(x, lo), hi)
    }
    public static func toDegrees(_ x: Float64) -> Float64 {
        return x * 180.0 / Math.pi()
    }
    public static func toRadians(_ x: Float64) -> Float64 {
        return x * Math.pi() / 180.0
    }

    public static func sin(_ x: Float64) -> Float64 {
        return __syx_f64_sin(x)
    }
    public static func cos(_ x: Float64) -> Float64 {
        return __syx_f64_cos(x)
    }
    public static func tan(_ x: Float64) -> Float64 {
        return __syx_f64_tan(x)
    }
    public static func asin(_ x: Float64) -> Float64 {
        return __syx_f64_asin(x)
    }
    public static func acos(_ x: Float64) -> Float64 {
        return __syx_f64_acos(x)
    }
    public static func atan(_ x: Float64) -> Float64 {
        return __syx_f64_atan(x)
    }
    public static func atan2(_ y: Float64, _ x: Float64) -> Float64 {
        return __syx_f64_atan2(y, x)
    }
    public static func sqrt(_ x: Float64) -> Float64 {
        return __syx_f64_sqrt(x)
    }
    public static func cbrt(_ x: Float64) -> Float64 {
        return __syx_f64_cbrt(x)
    }
    public static func hypot(_ x: Float64, _ y: Float64) -> Float64 {
        return __syx_f64_hypot(x, y)
    }
    public static func pow(_ base: Float64, _ exp: Float64) -> Float64 {
        return __syx_f64_pow(base, exp)
    }
    public static func exp(_ x: Float64) -> Float64 {
        return __syx_f64_exp(x)
    }
    public static func exp2(_ x: Float64) -> Float64 {
        return __syx_f64_exp2(x)
    }
    public static func floor(_ x: Float64) -> Float64 {
        return __syx_f64_floor(x)
    }
    public static func ceil(_ x: Float64) -> Float64 {
        return __syx_f64_ceil(x)
    }
    public static func round(_ x: Float64) -> Float64 {
        return __syx_f64_round(x)
    }
    public static func trunc(_ x: Float64) -> Float64 {
        return __syx_f64_trunc(x)
    }
    // natural log (ln); ≠ log10 / log2
    public static func log(_ x: Float64) -> Float64 {
        return __syx_f64_log(x)
    }
    public static func ln(_ x: Float64) -> Float64 {
        return __syx_f64_log(x)
    }
    public static func log2(_ x: Float64) -> Float64 {
        return __syx_f64_log2(x)
    }
    public static func log10(_ x: Float64) -> Float64 {
        return __syx_f64_log10(x)
    }
    public static func sinh(_ x: Float64) -> Float64 {
        return __syx_f64_sinh(x)
    }
    public static func cosh(_ x: Float64) -> Float64 {
        return __syx_f64_cosh(x)
    }
    public static func tanh(_ x: Float64) -> Float64 {
        return __syx_f64_tanh(x)
    }
    public static func fmod(_ x: Float64, _ y: Float64) -> Float64 {
        return __syx_f64_fmod(x, y)
    }
    public static func copysign(_ mag: Float64, _ sign: Float64) -> Float64 {
        return __syx_f64_copysign(mag, sign)
    }
    public static func isNaN(_ x: Float64) -> Bool {
        return __syx_f64_isnan(x)
    }
    public static func isInfinite(_ x: Float64) -> Bool {
        return __syx_f64_isinf(x)
    }
    public static func isFinite(_ x: Float64) -> Bool {
        return __syx_f64_isfinite(x)
    }
    public static func expm1(_ x: Float64) -> Float64 {
        return __syx_f64_expm1(x)
    }
    public static func log1p(_ x: Float64) -> Float64 {
        return __syx_f64_log1p(x)
    }
    public static func asinh(_ x: Float64) -> Float64 {
        return __syx_f64_asinh(x)
    }
    public static func acosh(_ x: Float64) -> Float64 {
        return __syx_f64_acosh(x)
    }
    public static func atanh(_ x: Float64) -> Float64 {
        return __syx_f64_atanh(x)
    }
    public static func remainder(_ x: Float64, _ y: Float64) -> Float64 {
        return __syx_f64_remainder(x, y)
    }
    public static func nextUp(_ x: Float64) -> Float64 {
        return __syx_f64_next_up(x)
    }
    public static func nextDown(_ x: Float64) -> Float64 {
        return __syx_f64_next_down(x)
    }
    public static func mulAdd(_ a: Float64, _ b: Float64, _ c: Float64) -> Float64 {
        return __syx_f64_mul_add(a, b, c)
    }
    public static func erf(_ x: Float64) -> Float64 {
