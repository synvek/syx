// Text utilities: formatting, regex, encoding, builders, bytes.

/// Print, printLine, format, and debug stringification.
public class Fmt {
    /// Print `value` without a trailing newline.
    public static func print(value: Sendable) {
        SyxHost.fmt_print(value)
    }
    /// Print `value` followed by a newline.
    public static func printLine(value: Sendable) {
        SyxHost.fmt_print_line(value)
    }
    /// Format `args` into `pattern`; returns the string.
    public static func format(pattern: String, args: Array<Sendable>) -> String {
        return SyxHost.fmt_format(pattern, args)
    }
    /// Debug-string representation of `value`.
    public static func debug(value: Sendable) -> String {
        return SyxHost.fmt_debug(value)
    }
}

/// Regex match / compile / findAll / replaceAll (host `SyxHost.regex_*`).
public class Regex {
    /// Whether Match (host `SyxHost.regex_match`).
    public static func isMatch(text: String, pattern: String) -> Bool {
        let hits = SyxHost.regex_match(text, pattern)
        return hits.count > 0
    }
    /// Compile `pattern` (returns host pattern id/string).
    public static func compile(pattern: String) -> String {
        return SyxHost.regex_compile(pattern)
    }
    /// Find All (host `SyxHost.regex_find_all`).
    public static func findAll(text: String, pattern: String) -> Array<String> {
        return SyxHost.regex_find_all(text, pattern)
    }
    /// Replace All (host `SyxHost.regex_replace_all`).
    public static func replaceAll(text: String, pattern: String, replacement: String) -> String {
        return SyxHost.regex_replace_all(text, pattern, replacement)
    }
}

/// Base64 / hex / URL encode and decode helpers.
public class Encoding {
    /// Base64 Encode (host `SyxHost.base64_encode`).
    public static func base64Encode(data: String) -> String {
        return SyxHost.base64_encode(data)
    }
    /// Base64 Decode (host `SyxHost.base64_decode`).
    public static func base64Decode(encoded: String) -> String {
        return SyxHost.base64_decode(encoded)
    }
    /// Hex Encode (host `SyxHost.hex_encode`).
    public static func hexEncode(data: String) -> String {
        return SyxHost.hex_encode(data)
    }
    /// Hex Decode (host `SyxHost.hex_decode`).
    public static func hexDecode(encoded: String) -> String {
        return SyxHost.hex_decode(encoded)
    }
    /// Url Encode (host `SyxHost.url_encode`).
    public static func urlEncode(text: String) -> String {
        return SyxHost.url_encode(text)
    }
    /// Url Decode (host `SyxHost.url_decode`).
    public static func urlDecode(text: String) -> String {
        return SyxHost.url_decode(text)
    }
}

/// Mutable string builder session (handle id + append / toString).
public class StringBuilder {
    /// Create a `StringBuilder` session; returns handle id.
    public static func create() -> Int {
        return SyxHost.string_builder_new()
    }
    /// Append `text` to builder handle.
    public static func append(builder: Int, text: String) {
        SyxHost.string_builder_append(builder, text)
    }
    /// Convert to string (host `SyxHost.string_builder_to_string`).
    public static func toString(builder: Int) -> String {
        return SyxHost.string_builder_to_string(builder)
    }
}

/// Byte-array helpers: fromArray / slice / concat.
public class Bytes {
    /// Construct from array (host `SyxHost.bytes_from_array`).
    public static func fromArray(data: Array<UInt8>) -> Array<UInt8> {
        return SyxHost.bytes_from_array(data)
    }
    /// Slice `data` from `start` to `end`.
    public static func slice(data: Array<UInt8>, start: Int, end: Int) -> Array<UInt8> {
        return SyxHost.bytes_slice(data, start, end)
    }
    /// Concatenate byte arrays `a` and `b`.
    public static func concat(a: Array<UInt8>, b: Array<UInt8>) -> Array<UInt8> {
        return SyxHost.bytes_concat(a, b)
    }
}

