public func stack(children: String) -> String {
    return __syx_synui_stack(children)
}

/// Create a scroll view.
public func scrollView(children: String) -> String {
    return __syx_synui_scroll_view(children)
}

/// Create a tab view.
public func tabView(tabs: String, children: String) -> String {
