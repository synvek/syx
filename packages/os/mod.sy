/// SA-4-01: System runtime queries via `ProcessInfo` + unified `SystemError`.
/// (Former `Os` / `OsError` surface removed — destructive, no aliases.)

/// Unified System-domain failure (merges former OsError / IOError / ProcessError).
public enum SystemError: Error {
    case failed(code: Int, message: String)
}

/// Process / host runtime info (Swift `ProcessInfo` shape; caseless enum namespace).
public enum ProcessInfo {
    /// Logical CPU count.
    public static var processorCount: Int {
        return SyxHost.os_cpu_count()
    }

    /// Total physical memory in bytes.
    public static func memoryTotal() throws -> Int {
        do {
            return SyxHost.os_memory_total()
        } catch (e) {
            throw SystemError.failed(code: 7, message: "os memoryTotal failed")
        }
    }

    /// Approx. available memory in bytes.
    public static func memoryAvailable() throws -> Int {
        do {
            return SyxHost.os_memory_available()
        } catch (e) {
            throw SystemError.failed(code: 8, message: "os memoryAvailable failed")
        }
    }

    /// Current user name.
    public static func userName() throws -> String {
        do {
            return SyxHost.os_user_name()
        } catch (e) {
            throw SystemError.failed(code: 5, message: "os userName failed")
        }
    }

    /// Home directory path.
    public static func homeDir() throws -> String {
        do {
            return SyxHost.os_home_dir()
        } catch (e) {
            throw SystemError.failed(code: 6, message: "os homeDir failed")
        }
    }

    /// Host name.
    public static func hostname() throws -> String {
        do {
            return SyxHost.os_hostname()
        } catch (e) {
            throw SystemError.failed(code: 1, message: "os hostname failed")
        }
    }

    /// Process / host uptime in milliseconds.
    public static func uptimeMs() throws -> Int {
        do {
            return SyxHost.os_uptime_ms()
        } catch (e) {
            throw SystemError.failed(code: 9, message: "os uptimeMs failed")
        }
    }

    /// Total disk space in bytes for `path`.
    public static func diskTotal(path: String) throws -> Int {
        do {
            return SyxHost.os_disk_total(path)
        } catch (e) {
            throw SystemError.failed(code: 2, message: "os diskTotal failed")
        }
    }

    /// Available disk space in bytes for `path`.
    public static func diskAvailable(path: String) throws -> Int {
        do {
            return SyxHost.os_disk_available(path)
        } catch (e) {
            throw SystemError.failed(code: 3, message: "os diskAvailable failed")
        }
    }

    /// 1-minute load average scaled by 100 (e.g. `125` = 1.25).
    public static func loadAverage() throws -> Int {
        do {
            return SyxHost.os_load_average()
        } catch (e) {
            throw SystemError.failed(code: 10, message: "os loadAverage failed")
        }
    }

    /// Best-effort primary non-loopback IPv4.
    public static func primaryIpv4() throws -> String {
        do {
            return SyxHost.os_primary_ipv4()
        } catch (e) {
            throw SystemError.failed(code: 4, message: "os primaryIpv4 failed")
        }
    }
}
