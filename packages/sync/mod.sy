/// Bounded/unbounded channel. Prefer instance API (`ch.send(v)`).
/// - `Channel()` — default init, unbounded (capacity 0)
/// - `Channel.create(n)` — factory, returns `Channel` (not a raw host id)
/// Note: do not add `init(capacity:)` alongside `init()`; labeled ctor currently
/// resolves to the zero-arg init and would ignore capacity.
public class Channel {
    /// Host channel id (`Int`). Select accepts `Channel` and unwraps this.
    /// R-6-01: was Object `{__channel_id}` bag; create now returns bare Int (VM dual-track still accepts old bags).
    public var handle: Int = -1

    /// Unbounded channel (`capacity == 0`).
    public init() {
        let h = SyxHost.channel_create(0)
        self.handle = h
    }

    /// Bounded when `capacity > 0`; unbounded when `capacity == 0`.
    public static func create(_ capacity: Int) -> Channel {
        let ch = Channel()
        let h = SyxHost.channel_create(capacity)
        ch.handle = h
        return ch
    }

    /// Send `value` (blocks if bounded and full). R-2-01: `Sendable` (≠ Object).
    public func send(_ value: Sendable) {
        SyxHost.channel_send(self.handle, value)
    }
    /// Receive one value (blocks if empty). R-3-01: `Sendable` (≠ Object).
    /// Empty/closed after drain surfaces runtime `nil` (≠ typed Optional).
    public func recv() -> Sendable {
        return SyxHost.channel_recv(self.handle)
    }
    /// Non-blocking send; `false` if full/closed. R-2-01: `Sendable` (≠ Object).
    public func trySend(_ value: Sendable) -> Bool {
        return SyxHost.channel_try_send(self.handle, value)
    }
    /// Non-blocking receive; nil/sentinel if empty. R-3-01: `Sendable` (≠ Object).
    public func tryRecv() -> Sendable {
        return SyxHost.channel_try_recv(self.handle)
    }
    /// Close the channel (further sends fail).
    public func close() {
        SyxHost.channel_close(self.handle)
    }
    /// Current buffered element count.
    public func count() -> Int {
        return SyxHost.channel_length(self.handle)
    }
    /// Buffer capacity (`0` = unbounded).
    public func capacity() -> Int {
        return SyxHost.channel_capacity(self.handle)
    }
}

/// Multi-channel select: first-ready, default, or timeout.
public class Select {
    /// Wait until one channel is ready; returns value or `nil`.
    /// R-4-01: `Array<Channel> -> Sendable` (≠ Object).
    /// Prefer host result via `SyxHost.value_compare` on bound idx (HeapSlot-aware).
    public static func select(channels: Array<Channel>) -> Sendable {
        let r = SyxHost.channel_select(channels)
        let idx = r[0]
        let val = r[1]
        if SyxHost.value_compare(idx, "-1") == 0 {
            return nil
        }
        return val
    }
    /// Select with `fallback` when none are ready immediately.
    /// R-4-01: `Array<Channel>` + `fallback: Sendable` (≠ Object).
    public static func orDefault(channels: Array<Channel>, fallback: Sendable) -> Sendable {
        let miss = "SyxHost.select_pkg_miss__"
        let r = SyxHost.channel_select_default(channels, miss)
        let idx = r[0]
        let val = r[1]
        if SyxHost.value_compare(idx, "-1") == 0 {
            return fallback
        }
        return val
    }
    /// Select with timeout `ms`; `nil` on timeout.
    /// R-4-01: `Array<Channel> -> Sendable` (≠ Object).
    public static func timeout(channels: Array<Channel>, ms: Int) -> Sendable {
        let r = SyxHost.channel_select_timeout(channels, ms)
        // Host returns indexed `[idx, value]` or miss `["-1", …]` (Array), not bare nil.
        let idx = r[0]
        let val = r[1]
        if SyxHost.value_compare(idx, "-1") == 0 {
            return nil
        }
        return val
    }
}

/// RAII unlock guard for `Mutex.lockGuard` (`deinit` → unlock).
public class MutexGuard {
    public var mutexId: Int = -1
    /// Unlock the mutex on scope exit.
    deinit {
        SyxHost.mutex_unlock_quiet(self.mutexId)
    }
}

/// Mutual exclusion: create / lock / unlock / lockGuard.
public class Mutex {
    /// Create a mutex host id. R-5-01: `-> Int` (≠ Object).
    public static func create() -> Int {
        return SyxHost.mutex_create()
    }
    /// Acquire mutex (blocking). R-5-01: `mutex: Int`.
    public static func lock(mutex: Int) {
        SyxHost.mutex_lock_wait(mutex)
    }
    /// Release mutex. R-5-01: `mutex: Int`.
    public static func unlock(mutex: Int) {
        SyxHost.mutex_unlock(mutex)
    }
    /// Lock and return an RAII `MutexGuard`. R-5-01: `mutex: Int`.
    public static func lockGuard(mutex: Int) -> MutexGuard {
        let ok = SyxHost.mutex_lock_wait(mutex)
        let g = MutexGuard()
        if ok
        g.mutexId = mutex
        return g
    }
}

/// RAII signal guard for `Semaphore.waitGuard` (`deinit` → signal).
public class SemaphoreGuard {
    public var semId: Int = -1
    /// Signal the semaphore on scope exit.
    deinit {
        SyxHost.semaphore_signal_quiet(self.semId)
    }
}

/// Counting semaphore: create / wait / tryWait / signal / waitGuard.
public class Semaphore {
    /// Create a semaphore with `permits`. R-5-01: `-> Int` (≠ Object).
    public static func create(permits: Int) -> Int {
        return SyxHost.semaphore_create(permits)
    }
    /// Acquire one semaphore permit (blocking). R-5-01: `sem: Int`.
    public static func wait(sem: Int) {
        SyxHost.semaphore_wait(sem)
    }
    /// Try acquire; `false` if no permit. R-5-01: `sem: Int`.
    public static func tryWait(sem: Int) -> Bool {
        return SyxHost.semaphore_try_wait(sem)
    }
    /// Release one semaphore permit. R-5-01: `sem: Int`.
    public static func signal(sem: Int) {
        SyxHost.semaphore_signal(sem)
    }
    /// Wait and return an RAII `SemaphoreGuard`. R-5-01: `sem: Int`.
    public static func waitGuard(sem: Int) -> SemaphoreGuard {
        let ok = SyxHost.semaphore_wait(sem)
        let g = SemaphoreGuard()
        if ok
        g.semId = sem
        return g
    }
}

