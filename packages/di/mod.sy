/// Phase 127 / Service DI v8 surface; Phase 128 adds `@Lazy` + cycle-break proxies (v9).
/// Prefer `import DI`. Dynamic resolve uses `SyxHost.service_resolve_dynamic`.

public class Di {
    /// Resolve a registered `@Service` / `@Component` / `@Bean` by type name (or binding alias).
    public static func resolve(typeName: String) -> Object {
        return SyxHost.service_resolve_dynamic(typeName)
    }

    /// Enter a request-scoped DI context.
    public static func beginRequest() {
        SyxHost.service_begin_request()
    }

    /// Leave the current request-scoped DI context.
    public static func endRequest() {
        SyxHost.service_end_request()
    }

    /// Run `handlerName` inside a fresh request scope.
    public static func withRequest(handlerName: String) {
        SyxHost.service_run_in_request(handlerName)
    }

    /// Run `handlerName` inside a request scope (alias of `withRequest`).
    public static func runInRequest(handlerName: String) {
        SyxHost.service_run_in_request(handlerName)
    }

    /// Select active DI profile by `name`.
    public static func setProfile(name: String) {
        SyxHost.service_set_profile(name)
    }

    /// Tear down the DI container.
    public static func destroy() {
        SyxHost.service_destroy()
    }

    /// Reset DI container state (tests / re-init).
    public static func reset() {
        SyxHost.service_reset()
    }
}
