// Hashing, HMAC, AES-GCM, Ed25519, PBKDF2, and random bytes.
// Prefer `import Crypto`. Experimental surfaces note GA status inline.

/// Cryptographic primitives via host `SyxHost.crypto_*` / `SyxHost.random_*`.
public class Crypto {
    /// SHA-256 digest of `s` (host encoding).
    public static func sha256(_ s: String) -> String {
        return SyxHost.crypto_sha256(s)
    }

    /// SHA-512 digest of `s` (host encoding).
    public static func sha512(_ s: String) -> String {
        return SyxHost.crypto_sha512(s)
    }

    /// HMAC-SHA256 of `message` under `key`.
    public static func hmacSha256(key: String, message: String) -> String {
        return SyxHost.crypto_hmac_sha256(key, message)
    }

    /// AES-GCM encrypt `plaintext` with `key` and `nonce`.
    public static func aesGcmEncrypt(key: String, nonce: String, plaintext: String) -> String {
        return SyxHost.crypto_aes_gcm_encrypt(key, nonce, plaintext)
    }

    /// Ed25519 sign `message` with `key`.
    public static func ed25519Sign(key: String, message: String) -> String {
        return SyxHost.crypto_ed25519_sign(key, message)
    }

    /// Verify Ed25519 `signature` for `message` with `key`.
    public static func ed25519Verify(key: String, message: String, signature: String) -> Bool {
        return SyxHost.crypto_ed25519_verify(key, message, signature)
    }

    /// M0-B04: experimental — ABI aligned with host (password, salt, iterations, dkLen).
    /// Not production GA until RFC vector suite is complete (W2+).
    public static func pbkdf2(password: String, salt: String, iterations: Int, dkLen: Int) -> String {
        return SyxHost.crypto_pbkdf2(password, salt, iterations, dkLen)
    }

    /// Fill `count` cryptographically random bytes.
    public static func randomBytes(_ count: Int) -> Array<UInt8> {
        return SyxHost.random_fill_bytes(count)
    }
}
