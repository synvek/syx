/// M2 W3 / ADR-147: open/close throw `IOError`.
/// M2 W5 / ADR-149: read/write throw `IOError` (registry host bypass cleared).
/// M2 W8 / ADR-152: seek throw `IOError` (registry host bypass cleared).
/// M2 W9 / ADR-153: readAllBytes throw `IOError` (registry host bypass cleared).
/// M2 W90 / ADR-234: Reader/Writer/Seekable/Closeable + instance RAII + withOpen.

/// Thin IOError (ADR-138 target type; full Error hierarchy → later M2 windows).
public data class IOError(code: Int, message: String)

/// Open file handle: chunked read/write/seek (throws `IOError`; RAII via `FileResource`).
public class FileHandle {
    /// Open `path` with `mode`; returns handle id (throws `IOError`).
    public static func open(path: String, mode: String) -> Int throws {
        try {
            return __syx_file_open(path, mode)
        } catch (e) {
            throw IOError(code: 1, message: "file open failed")
        }
    }

    /// Read up to `maxBytes` from handle (throws `IOError`).
    public static func read(handle: Int, maxBytes: Int) -> Array<UInt8> throws {
        try {
            return __syx_file_read_chunk(handle, maxBytes)
        } catch (e) {
            throw IOError(code: 3, message: "file read failed")
        }
    }

    /// Write `bytes` to handle; returns byte count (throws `IOError`).
    public static func write(handle: Int, bytes: Array<UInt8>) -> Int throws {
        try {
            return __syx_file_write_chunk(handle, bytes)
        } catch (e) {
            throw IOError(code: 4, message: "file write failed")
        }
    }

    /// Close handle (throws `IOError`).
    public static func close(handle: Int) throws {
        try {
            __syx_file_close(handle)
        } catch (e) {
            throw IOError(code: 2, message: "file close failed")
        }
    }

    /// Seek handle to `offset` (throws `IOError`).
    public static func seek(handle: Int, offset: Int) throws {
        try {
            __syx_file_seek(handle, offset)
        } catch (e) {
            throw IOError(code: 5, message: "file seek failed")
        }
    }

    /// Read remaining bytes from handle to end (throws `IOError`).
    public static func readAllBytes(handle: Int) -> Array<UInt8> throws {
        // M0-B07 / ADR-241: was `readMmap`; host is `read_to_end` (≠ OS mmap; S3-04 rename closeout).
        try {
            return __syx_file_read_all_bytes(handle)
        } catch (e) {
            throw IOError(code: 6, message: "file readAllBytes failed")
        }
    }

    /// ADR-234: instance resource open (Reader/Writer/Seekable/Closeable markers).
    public static func openResource(path: String, mode: String) -> FileResource throws {
        try {
            let h = __syx_file_open(path, mode)
            let f = FileResource()
            f.handle = h
            return f
        } catch (e) {
            throw IOError(code: 1, message: "file open failed")
        }
    }

    /// ADR-234: RAII/`with` — host runs `body(handle: Int)` then always closes.
    /// Body must return `>= 0` on success; negative / non-Int → `IOError` after close.
    public static func withOpen(path: String, mode: String, body: Object) -> Int throws {
        try {
            return __syx_file_with_open(path, mode, body)
        } catch (e) {
            throw IOError(code: 99, message: "withOpen body failed")
        }
    }
}

/// ADR-234: instance FileHandle resource (implements Reader/Writer/Seekable/Closeable markers).
public class FileResource {
    public var handle: Int = -1

    /// Read up to `maxBytes` from handle (throws `IOError`).
    public func read(maxBytes: Int) -> Array<UInt8> throws {
        try {
            return __syx_file_read_chunk(self.handle, maxBytes)
        } catch (e) {
            throw IOError(code: 3, message: "file read failed")
        }
    }

    /// Write `bytes` to handle; returns byte count (throws `IOError`).
    public func write(bytes: Array<UInt8>) -> Int throws {
        try {
            return __syx_file_write_chunk(self.handle, bytes)
        } catch (e) {
            throw IOError(code: 4, message: "file write failed")
        }
    }

    /// Seek handle to `offset` (throws `IOError`).
    public func seek(offset: Int) throws {
        try {
            __syx_file_seek(self.handle, offset)
        } catch (e) {
            throw IOError(code: 5, message: "file seek failed")
        }
    }

    /// Close handle (throws `IOError`).
    public func close() throws {
        let h = self.handle
        if h < 0 {
            return
        }
        self.handle = -1
        try {
            __syx_file_close(h)
        } catch (e) {
            throw IOError(code: 2, message: "file close failed")
        }
    }

    /// Read remaining bytes from handle to end (throws `IOError`).
    public func readAllBytes() -> Array<UInt8> throws {
        try {
            return __syx_file_read_all_bytes(self.handle)
        } catch (e) {
            throw IOError(code: 6, message: "file readAllBytes failed")
        }
    }

    /// Close the handle quietly on destruction.
    deinit {
        __syx_file_close_quiet(self.handle)
    }
}
