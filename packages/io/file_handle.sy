/// M2 W3 / ADR-147: open/close throw `SystemError`.
/// M2 W5 / ADR-149: read/write throw `SystemError` (registry host bypass cleared).
/// M2 W8 / ADR-152: seek throw `SystemError` (registry host bypass cleared).
/// M2 W9 / ADR-153: readAllBytes throw `SystemError` (registry host bypass cleared).
/// M2 W90 / ADR-234: Reader/Writer/Seekable/Closeable + instance RAII + withOpen.

/// Errors: `SystemError` (SA-4-01; former `SystemError` merged).

/// Open file handle: chunked read/write/seek (throws `SystemError`; RAII via `FileResource`).
public class FileHandle {
    /// Open `path` with `mode`; returns handle id (throws `SystemError`).
    public static func open(path: String, mode: String) throws -> Int {
        do {
            return SyxHost.file_open(path, mode)
        } catch (e) {
            throw SystemError.failed(code: 1, message: "file open failed")
        }
    }

    /// Read up to `maxBytes` from handle (throws `SystemError`).
    public static func read(handle: Int, maxBytes: Int) throws -> Array<UInt8> {
        do {
            return SyxHost.file_read_chunk(handle, maxBytes)
        } catch (e) {
            throw SystemError.failed(code: 3, message: "file read failed")
        }
    }

    /// Write `bytes` to handle; returns byte count (throws `SystemError`).
    public static func write(handle: Int, bytes: Array<UInt8>) throws -> Int {
        do {
            return SyxHost.file_write_chunk(handle, bytes)
        } catch (e) {
            throw SystemError.failed(code: 4, message: "file write failed")
        }
    }

    /// Close handle (throws `SystemError`).
    public static func close(handle: Int) throws {
        do {
            SyxHost.file_close(handle)
        } catch (e) {
            throw SystemError.failed(code: 2, message: "file close failed")
        }
    }

    /// Seek handle to `offset` (throws `SystemError`).
    public static func seek(handle: Int, offset: Int) throws {
        do {
            SyxHost.file_seek(handle, offset)
        } catch (e) {
            throw SystemError.failed(code: 5, message: "file seek failed")
        }
    }

    /// Read remaining bytes from handle to end (throws `SystemError`).
    public static func readAllBytes(handle: Int) throws -> Array<UInt8> {
        // M0-B07 / ADR-241: was `readMmap`; host is `read_to_end` (≠ OS mmap; S3-04 rename closeout).
        do {
            return SyxHost.file_read_all_bytes(handle)
        } catch (e) {
            throw SystemError.failed(code: 6, message: "file readAllBytes failed")
        }
    }

    /// ADR-234: instance resource open (Reader/Writer/Seekable/Closeable markers).
    public static func openResource(path: String, mode: String) throws -> FileResource {
        do {
            let h = SyxHost.file_open(path, mode)
            let f = FileResource()
            f.handle = h
            return f
        } catch (e) {
            throw SystemError.failed(code: 1, message: "file open failed")
        }
    }

    /// ADR-234: RAII/`with` — host runs `body(handle: Int)` then always closes.
    /// Body must return `>= 0` on success; negative / non-Int → `SystemError` after close.
    /// SA-6 residual: closure body still `Object` until function-typed host/closure unify.
    public static func withOpen(path: String, mode: String, body: Object) throws -> Int {
        do {
            return SyxHost.file_with_open(path, mode, body)
        } catch (e) {
            throw SystemError.failed(code: 99, message: "withOpen body failed")
        }
    }
}

/// ADR-234: instance FileHandle resource (implements Reader/Writer/Seekable/Closeable markers).
public class FileResource {
    public var handle: Int = -1

    /// Read up to `maxBytes` from handle (throws `SystemError`).
    public func read(maxBytes: Int) throws -> Array<UInt8> {
        do {
            return SyxHost.file_read_chunk(self.handle, maxBytes)
        } catch (e) {
            throw SystemError.failed(code: 3, message: "file read failed")
        }
    }

    /// Write `bytes` to handle; returns byte count (throws `SystemError`).
    public func write(bytes: Array<UInt8>) throws -> Int {
        do {
            return SyxHost.file_write_chunk(self.handle, bytes)
        } catch (e) {
            throw SystemError.failed(code: 4, message: "file write failed")
        }
    }

    /// Seek handle to `offset` (throws `SystemError`).
    public func seek(offset: Int) throws {
        do {
            SyxHost.file_seek(self.handle, offset)
        } catch (e) {
            throw SystemError.failed(code: 5, message: "file seek failed")
        }
    }

    /// Close handle (throws `SystemError`).
    public func close() throws {
        let h = self.handle
        if h < 0 {
            return
        }
        self.handle = -1
        do {
            SyxHost.file_close(h)
        } catch (e) {
            throw SystemError.failed(code: 2, message: "file close failed")
        }
    }

    /// Read remaining bytes from handle to end (throws `SystemError`).
    public func readAllBytes() throws -> Array<UInt8> {
        do {
            return SyxHost.file_read_all_bytes(self.handle)
        } catch (e) {
            throw SystemError.failed(code: 6, message: "file readAllBytes failed")
        }
    }

    /// Close the handle quietly on destruction.
    deinit {
        SyxHost.file_close_quiet(self.handle)
    }
}
