/// ADR-240 / M2-S3-03: FileStream chunked-read session (≠ File.read whole-file; ≠ mmap S3-04).
/// Close then readChunk must fail.

public class FileStream {
    /// Open a streaming file session (throws `SystemError`).
    public static func open(path: String, mode: String) throws -> Int {
        do {
            return SyxHost.file_stream_open(path, mode)
        } catch (e) {
            throw SystemError.failed(code: 1, message: "FileStream open failed")
        }
    }

    /// Empty array means EOF.
    public static func readChunk(handle: Int, maxBytes: Int) throws -> Array<UInt8> {
        do {
            return SyxHost.file_stream_read_chunk(handle, maxBytes)
        } catch (e) {
            throw SystemError.failed(code: 3, message: "FileStream read failed")
        }
    }

    /// Close the file-stream session (throws).
    public static func close(handle: Int) throws {
        do {
            SyxHost.file_stream_close(handle)
        } catch (e) {
            throw SystemError.failed(code: 2, message: "FileStream close failed")
        }
    }
}
