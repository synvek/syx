// Path-based file / directory / stdin helpers (`import System`).
// Handle-based RAII lives in `FileHandle` / `FileStream` / `FileWatcher`.

/// Whole-file read/write/copy/stat and one-shot watch kick.
public class File {
    /// Read entire file at `path` as UTF-8 text.
    public static func read(path: String) -> String {
        return SyxHost.file_read(path)
    }

    /// ADR-278 / M3-B02: async read on blocking_pool (awaitable); ≠ epoll reactor GA.
    /// SA-6-01: awaitable bag typed as `Dictionary` (≠ Object; ≠ reactor GA).
    public static func readAsync(_ path: String) -> Dictionary {
        return SyxHost.file_read_async(path)
    }

    /// Read file at `path` as an array of lines.
    public static func readLines(path: String) -> Array<String> {
        return SyxHost.file_read_lines(path)
    }

    /// Write `content` to `path` (overwrite).
    public static func write(path: String, content: String) {
        SyxHost.file_write(path, content)
    }

    /// Append `content` to `path`.
    public static func append(path: String, content: String) {
        SyxHost.file_append(path, content)
    }

    /// Whether `path` exists.
    public static func exists(path: String) -> Bool {
        return SyxHost.file_exists(path)
    }

    /// Delete file at `path`.
    public static func delete(path: String) {
        SyxHost.file_delete(path)
    }

    /// Copy file from `from` to `to`.
    public static func copy(from: String, to: String) {
        SyxHost.file_copy(from, to)
    }

    /// Move/rename file from `from` to `to`.
    public static func move(from: String, to: String) {
        SyxHost.file_move(from, to)
    }

    /// Read file at `path` as raw bytes.
    public static func readBytes(path: String) -> Array<UInt8> {
        return SyxHost.file_read_bytes(path)
    }

    /// Write raw `bytes` to `path`.
    public static func writeBytes(path: String, bytes: Array<UInt8>) {
        SyxHost.file_write_bytes(path, bytes)
    }

    /// Filesystem metadata for `path` (`size` / `isFile` / `isDir` / `modifiedMs`).
    /// SA-6-01: typed as `Dictionary` (≠ Object bag signature).
    public static func stat(path: String) -> Dictionary {
        return SyxHost.file_stat(path)
    }

    /// Create symlink at `linkPath` pointing to `target`.
    public static func symlink(target: String, linkPath: String) {
        SyxHost.file_symlink(target, linkPath)
    }

    /// Read symlink target at `path`.
    public static func readLink(path: String) -> String {
        return SyxHost.file_read_link(path)
    }

    /// Change mode bits on `path`.
    public static func chmod(path: String, mode: Int) {
        SyxHost.file_chmod(path, mode)
    }

    /// One-shot kick (mock/OS); ≠ FileWatcher lifecycle (ADR-240).
    public static func watch(path: String) -> Array<String> {
        return SyxHost.file_watch(path)
    }
}

/// Create / list / exists for directories.
public class Directory {
    /// Create directory at `path`.
    public static func create(path: String) {
        SyxHost.dir_create(path)
    }

    /// List directory entries at `path`.
    public static func list(path: String) -> Array<String> {
        return SyxHost.dir_list(path)
    }

    /// Whether directory `path` exists.
    public static func exists(path: String) -> Bool {
        return SyxHost.dir_exists(path)
    }
}

/// Read a line from standard input (`SyxHost.read_line`).
public class Stdin {
    /// Read one line from standard input.
    public static func readLine() -> String {
        return SyxHost.read_line()
    }
}
