/// SA-3-01: `import System` aggregate.
/// Edit domain sources listed in scripts/gen_system_mod.py; re-run this script.
/// Runtime/workspace load prepends packages/internal/system_host.sy (SA-4-04a).
/// Keep crates/syx-driver/src/embedded_std.rs SYSTEM_SOURCE file list in sync.

// Process environment variables (SyxHost.env_*).

/// Read and write environment variables for the current process.
public class Env {
    /// Read environment variable `key` (empty if unset).
    public static func get(key: String) -> String {
    return SyxHost.env_get(key)
}
    /// Set environment variable `key` to `value`.
    public static func set(key: String, value: String) {
    SyxHost.env_set(key, value)
}
}

// Filesystem path string helpers (SyxHost.path_*).

/// Join / normalize / exists / extension for path strings (SA-4-01: `FilePath`).
public enum FilePath {
    /// Join path components `a` and `b`.
    public static func join(a: String, b: String) -> String {
        return SyxHost.path_join(a, b)
    }
    /// Normalize `path` (`.` / `..` / separators).
    public static func normalize(path: String) -> String {
        return SyxHost.path_normalize(path)
    }
    /// Whether `path` exists on the filesystem.
    public static func exists(path: String) -> Bool {
        return SyxHost.path_exists(path)
    }
    /// File extension of `path` (without dot rules per host).
    public static func fileExtension(path: String) -> String {
        return SyxHost.path_extension(path)
    }
}

// Wall-clock milliseconds and sleep (SyxHost.time_*).
// Higher-level calendar types live under `import System`.

/// Epoch milliseconds, sleep, and simple timestamp parse.
public class Time {
    /// Current wall-clock time in milliseconds.
    public static func nowMs() -> Int {
        return SyxHost.time_now_ms()
    }
    /// Block the current task for `ms` milliseconds.
    public static func sleepMs(ms: Int) {
        SyxHost.time_sleep_ms(ms)
    }
    /// Parse timestamp string to epoch ms (empty → now).
    public static func parseTimestampMs(s: String) -> Int {
        if s == ""
        return SyxHost.time_now_ms()
        let parsed = SyxHost.datetime_parse(s)
        return SyxHost.keypath_get(parsed, "DateTime", "ms", false)
    }
}


// Calendar time, durations, clocks, and monotonic instants.

/// Parse / format / timezone helpers over epoch milliseconds.
public class DateTime {
    /// Current wall-clock time as epoch milliseconds (SA-4: typed; no Object bag).
    public static func now() -> Int {
        return SyxHost.time_now_ms()
    }
    /// Parse a date-time string to epoch milliseconds (delegates to `Time.parseTimestampMs`).
    public static func parse(text: String) -> Int {
        return Time.parseTimestampMs(s: text)
    }
    /// Parse an ISO-8601 date-time string to epoch milliseconds.
    public static func parseIso8601(text: String) -> Int {
        return Time.parseTimestampMs(s: text)
    }
    /// Format epoch `ms` with `pattern`.
    public static func format(ms: Int, pattern: String) -> String {
        return SyxHost.datetime_format(ms, pattern)
    }
    /// Format epoch `ms` with `pattern` in `timezone` (throws).
    public static func formatWithTimezone(ms: Int, pattern: String, timezone: String) throws -> String {
        return SyxHost.datetime_format_with_timezone(ms, pattern, timezone)
    }
    /// Add `deltaMs` to epoch `ms`.
    public static func addDuration(ms: Int, deltaMs: Int) -> Int {
        return ms + deltaMs
    }
    /// Timezone offset for `ms` in `timezone` (throws).
    public static func timezoneOffset(ms: Int, timezone: String) throws -> Int {
        return SyxHost.datetime_timezone_offset(ms, timezone)
    }
}

/// Duration constructors returning millisecond deltas.
public class Duration {
    /// Duration of `value` milliseconds.
    public static func ms(value: Int) -> Int {
        return value
    }
    /// Duration of `value` seconds as milliseconds.
    public static func seconds(value: Int) -> Int {
        return value * 1000
    }
    /// Duration of `value` minutes as milliseconds.
    public static func minutes(value: Int) -> Int {
        return value * 60 * 1000
    }
    /// Duration of `value` hours as milliseconds.
    public static func hours(value: Int) -> Int {
        return value * 60 * 60 * 1000
    }
}

/// Wall-clock now in milliseconds (`SyxHost.time_now_ms`).
public class Clock {
    /// Now Ms (host `SyxHost.time_now_ms`).
    public static func nowMs() -> Int {
        return SyxHost.time_now_ms()
    }
}

/// Monotonic-ish instant helpers for elapsed timing.
public class Instant {
    /// Monotonic-ish instant now in milliseconds.
    public static func now() -> Int {
        return SyxHost.instant_now_ms()
    }
    /// Elapsed milliseconds since `start` instant.
    public static func elapsedMs(start: Int) -> Int {
        let n = Instant.now()
        if n < start
        return 0
        return n - start
    }
}


/// SA-4-01: System runtime queries via `ProcessInfo` + unified `SystemError`.
/// (Former `Os` / `OsError` surface removed — destructive, no aliases.)

/// Unified System-domain failure (merges former OsError / IOError / ProcessError).
public enum SystemError: Error {
    case failed(code: Int, message: String)
}

/// Process / host runtime info (Swift `ProcessInfo` shape; caseless enum namespace).
public enum ProcessInfo {
    /// Logical CPU count.
    public static var processorCount: Int {
        return SyxHost.os_cpu_count()
    }

    /// Total physical memory in bytes.
    public static func memoryTotal() throws -> Int {
        do {
            return SyxHost.os_memory_total()
        } catch (e) {
            throw SystemError.failed(code: 7, message: "os memoryTotal failed")
        }
    }

    /// Approx. available memory in bytes.
    public static func memoryAvailable() throws -> Int {
        do {
            return SyxHost.os_memory_available()
        } catch (e) {
            throw SystemError.failed(code: 8, message: "os memoryAvailable failed")
        }
    }

    /// Current user name.
    public static func userName() throws -> String {
        do {
            return SyxHost.os_user_name()
        } catch (e) {
            throw SystemError.failed(code: 5, message: "os userName failed")
        }
    }

    /// Home directory path.
    public static func homeDir() throws -> String {
        do {
            return SyxHost.os_home_dir()
        } catch (e) {
            throw SystemError.failed(code: 6, message: "os homeDir failed")
        }
    }

    /// Host name.
    public static func hostname() throws -> String {
        do {
            return SyxHost.os_hostname()
        } catch (e) {
            throw SystemError.failed(code: 1, message: "os hostname failed")
        }
    }

    /// Process / host uptime in milliseconds.
    public static func uptimeMs() throws -> Int {
        do {
            return SyxHost.os_uptime_ms()
        } catch (e) {
            throw SystemError.failed(code: 9, message: "os uptimeMs failed")
        }
    }

    /// Total disk space in bytes for `path`.
    public static func diskTotal(path: String) throws -> Int {
        do {
            return SyxHost.os_disk_total(path)
        } catch (e) {
            throw SystemError.failed(code: 2, message: "os diskTotal failed")
        }
    }

    /// Available disk space in bytes for `path`.
    public static func diskAvailable(path: String) throws -> Int {
        do {
            return SyxHost.os_disk_available(path)
        } catch (e) {
            throw SystemError.failed(code: 3, message: "os diskAvailable failed")
        }
    }

    /// 1-minute load average scaled by 100 (e.g. `125` = 1.25).
    public static func loadAverage() throws -> Int {
        do {
            return SyxHost.os_load_average()
        } catch (e) {
            throw SystemError.failed(code: 10, message: "os loadAverage failed")
        }
    }

    /// Best-effort primary non-loopback IPv4.
    public static func primaryIpv4() throws -> String {
        do {
            return SyxHost.os_primary_ipv4()
        } catch (e) {
            throw SystemError.failed(code: 4, message: "os primaryIpv4 failed")
        }
    }
}

/// Legacy Process surface (sentinel `-1` on spawn/wait fail).
/// Prefer `ProcessBuilder` / `Child` (ADR-242) for cwd/env/kill/timeout + throws.

public class Process {
    /// Current process argument list.
    public static func args() -> Array<String> {
        return SyxHost.process_args()
    }

    /// Current process environment map/object.
    public static func env(key: String) -> String {
        return SyxHost.process_env(key)
    }

    /// Execute a process (legacy spawn surface).
    public static func exec(command: String, args: Array<String>) -> Int {
        return SyxHost.process_exec(command, args)
    }

    /// Execute output (host `SyxHost.process_exec_output`).
    public static func execOutput(command: String, args: Array<String>) -> String {
        return SyxHost.process_exec_output(command, args)
    }

    /// Legacy spawn (no cwd/env overlay). Prefer `ProcessBuilder.spawn` (ADR-242).
    public static func spawn(command: String, args: Array<String>) -> Int {
        return SyxHost.process_spawn(command, args)
    }

    /// Legacy wait (sentinel `-1`). Prefer `Child.wait` / `waitTimeout` (ADR-242).
    public static func wait(handle: Int) -> Int {
        return SyxHost.process_wait(handle)
    }

    /// Exit Code (host `SyxHost.process_exit_code`).
    public static func exitCode() -> Int {
        return SyxHost.process_exit_code()
    }
}

/// ADR-242 / M2-S6-01: ProcessBuilder cwd/env overlay + Child kill/waitTimeout.
/// ADR-243 / M2-S6-02b: Child.stdout/stderr/stdin + ChildPipe readChunk/write/close.
/// ADR-244 / M2-S6-03: Child.signal(TERM/INT/KILL); ≠ Child.kill (force + remove).
/// Wait/kill then again must fail. Close pipe then read/write must fail.
/// Legacy `Process.spawn`/`wait` remain sentinel-compatible (≠ this surface).

/// Errors: `SystemError` (SA-4-01; former `SystemError` merged).

/// Build a child process: create / cwd / env / spawn (throws `SystemError`).
public class ProcessBuilder {
    /// Create a builder for `command` + `args` (throws `SystemError`).
    public static func create(command: String, args: Array<String>) throws -> Int {
        do {
            return SyxHost.process_builder_create(command, args)
        } catch (e) {
            throw SystemError.failed(code: 1, message: "ProcessBuilder create failed")
        }
    }

    /// Set working directory for the child (throws).
    public static func cwd(builder: Int, path: String) throws {
        do {
            SyxHost.process_builder_cwd(builder, path)
        } catch (e) {
            throw SystemError.failed(code: 2, message: "ProcessBuilder cwd failed")
        }
    }

    /// Set/override environment `key`=`value` (throws).
    public static func env(builder: Int, key: String, value: String) throws {
        do {
            SyxHost.process_builder_env(builder, key, value)
        } catch (e) {
            throw SystemError.failed(code: 3, message: "ProcessBuilder env failed")
        }
    }

    /// Spawn the child; returns child handle (throws).
    public static func spawn(builder: Int) throws -> Int {
        do {
            return SyxHost.process_builder_spawn(builder)
        } catch (e) {
            throw SystemError.failed(code: 4, message: "ProcessBuilder spawn failed")
        }
    }
}

/// Spawned child: wait / kill / signal / pipes (ADR-242…244).
public class Child {
    /// Wait for exit; returns status code (throws).
    public static func wait(handle: Int) throws -> Int {
        do {
            return SyxHost.child_wait(handle)
        } catch (e) {
            throw SystemError.failed(code: 5, message: "Child wait failed")
        }
    }

    /// Force-kill the child and remove handle (throws).
    public static func kill(handle: Int) throws {
        do {
            SyxHost.child_kill(handle)
        } catch (e) {
            throw SystemError.failed(code: 6, message: "Child kill failed")
        }
    }

    /// ADR-244: send TERM/INT/KILL without removing handle (still waitable).
    /// Windows: only KILL; TERM/INT throw unsupported.
    public static func signal(handle: Int, name: String) throws {
        do {
            SyxHost.child_signal(handle, name)
        } catch (e) {
            throw SystemError.failed(code: 14, message: "Child signal failed")
        }
    }

    /// On timeout the child is killed and this throws.
    public static func waitTimeout(handle: Int, timeoutMs: Int) throws -> Int {
        do {
            return SyxHost.child_wait_timeout(handle, timeoutMs)
        } catch (e) {
            throw SystemError.failed(code: 7, message: "Child waitTimeout failed")
        }
    }

    /// ADR-243: take stdout into a ChildPipe session (once).
    public static func stdout(handle: Int) throws -> Int {
        do {
            return SyxHost.child_stdout(handle)
        } catch (e) {
            throw SystemError.failed(code: 8, message: "Child stdout take failed")
        }
    }

    /// Take stderr into a `ChildPipe` session (once; throws).
    public static func stderr(handle: Int) throws -> Int {
        do {
            return SyxHost.child_stderr(handle)
        } catch (e) {
            throw SystemError.failed(code: 9, message: "Child stderr take failed")
        }
    }

    /// Take stdin into a `ChildPipe` session (once; throws).
    public static func stdin(handle: Int) throws -> Int {
        do {
            return SyxHost.child_stdin(handle)
        } catch (e) {
            throw SystemError.failed(code: 10, message: "Child stdin take failed")
        }
    }
}

/// Stdio pipe session: readChunk / write / close.
public class ChildPipe {
    /// Empty array means EOF.
    public static func readChunk(pipe: Int, maxBytes: Int) throws -> Array<UInt8> {
        do {
            return SyxHost.child_pipe_read_chunk(pipe, maxBytes)
        } catch (e) {
            throw SystemError.failed(code: 11, message: "ChildPipe read failed")
        }
    }

    /// Write `bytes` to the pipe (throws).
    public static func write(pipe: Int, bytes: Array<UInt8>) throws -> Int {
        do {
            return SyxHost.child_pipe_write(pipe, bytes)
        } catch (e) {
            throw SystemError.failed(code: 12, message: "ChildPipe write failed")
        }
    }

    /// Close the pipe (throws).
    public static func close(pipe: Int) throws {
        do {
            SyxHost.child_pipe_close(pipe)
        } catch (e) {
            throw SystemError.failed(code: 13, message: "ChildPipe close failed")
        }
    }
}

// Path-based file / directory / stdin helpers (`import System`).
// Handle-based RAII lives in `FileHandle` / `FileStream` / `FileWatcher`.

/// Whole-file read/write/copy/stat and one-shot watch kick.
public class File {
    /// Read entire file at `path` as UTF-8 text.
    public static func read(path: String) -> String {
        return SyxHost.file_read(path)
    }

    /// ADR-278 / M3-B02: async read on blocking_pool (awaitable); ≠ epoll reactor GA.
    /// SA-6-01: awaitable bag typed as `Dictionary` (≠ Object; ≠ reactor GA).
    public static func readAsync(_ path: String) -> Dictionary {
        return SyxHost.file_read_async(path)
    }

    /// Read file at `path` as an array of lines.
    public static func readLines(path: String) -> Array<String> {
        return SyxHost.file_read_lines(path)
    }

    /// Write `content` to `path` (overwrite).
    public static func write(path: String, content: String) {
        SyxHost.file_write(path, content)
    }

    /// Append `content` to `path`.
    public static func append(path: String, content: String) {
        SyxHost.file_append(path, content)
    }

    /// Whether `path` exists.
    public static func exists(path: String) -> Bool {
        return SyxHost.file_exists(path)
    }

    /// Delete file at `path`.
    public static func delete(path: String) {
        SyxHost.file_delete(path)
    }

    /// Copy file from `from` to `to`.
    public static func copy(from: String, to: String) {
        SyxHost.file_copy(from, to)
    }

    /// Move/rename file from `from` to `to`.
    public static func move(from: String, to: String) {
        SyxHost.file_move(from, to)
    }

    /// Read file at `path` as raw bytes.
    public static func readBytes(path: String) -> Array<UInt8> {
        return SyxHost.file_read_bytes(path)
    }

    /// Write raw `bytes` to `path`.
    public static func writeBytes(path: String, bytes: Array<UInt8>) {
        SyxHost.file_write_bytes(path, bytes)
    }

    /// Filesystem metadata for `path` (`size` / `isFile` / `isDir` / `modifiedMs`).
    /// SA-6-01: typed as `Dictionary` (≠ Object bag signature).
    public static func stat(path: String) -> Dictionary {
        return SyxHost.file_stat(path)
    }

    /// Create symlink at `linkPath` pointing to `target`.
    public static func symlink(target: String, linkPath: String) {
        SyxHost.file_symlink(target, linkPath)
    }

    /// Read symlink target at `path`.
    public static func readLink(path: String) -> String {
        return SyxHost.file_read_link(path)
    }

    /// Change mode bits on `path`.
    public static func chmod(path: String, mode: Int) {
        SyxHost.file_chmod(path, mode)
    }

    /// One-shot kick (mock/OS); ≠ FileWatcher lifecycle (ADR-240).
    public static func watch(path: String) -> Array<String> {
        return SyxHost.file_watch(path)
    }
}

/// Create / list / exists for directories.
public class Directory {
    /// Create directory at `path`.
    public static func create(path: String) {
        SyxHost.dir_create(path)
    }

    /// List directory entries at `path`.
    public static func list(path: String) -> Array<String> {
        return SyxHost.dir_list(path)
    }

    /// Whether directory `path` exists.
    public static func exists(path: String) -> Bool {
        return SyxHost.dir_exists(path)
    }
}

/// Read a line from standard input (`SyxHost.read_line`).
public class Stdin {
    /// Read one line from standard input.
    public static func readLine() -> String {
        return SyxHost.read_line()
    }
}

/// M2 W3 / ADR-147: open/close throw `SystemError`.
/// M2 W5 / ADR-149: read/write throw `SystemError` (registry host bypass cleared).
/// M2 W8 / ADR-152: seek throw `SystemError` (registry host bypass cleared).
/// M2 W9 / ADR-153: readAllBytes throw `SystemError` (registry host bypass cleared).
/// M2 W90 / ADR-234: Reader/Writer/Seekable/Closeable + instance RAII + withOpen.

/// Errors: `SystemError` (SA-4-01; former `SystemError` merged).

/// Open file handle: chunked read/write/seek (throws `SystemError`; RAII via `FileResource`).
public class FileHandle {
    /// Open `path` with `mode`; returns handle id (throws `SystemError`).
    public static func open(path: String, mode: String) throws -> Int {
        do {
            return SyxHost.file_open(path, mode)
        } catch (e) {
            throw SystemError.failed(code: 1, message: "file open failed")
        }
    }

    /// Read up to `maxBytes` from handle (throws `SystemError`).
    public static func read(handle: Int, maxBytes: Int) throws -> Array<UInt8> {
        do {
            return SyxHost.file_read_chunk(handle, maxBytes)
        } catch (e) {
            throw SystemError.failed(code: 3, message: "file read failed")
        }
    }

    /// Write `bytes` to handle; returns byte count (throws `SystemError`).
    public static func write(handle: Int, bytes: Array<UInt8>) throws -> Int {
        do {
            return SyxHost.file_write_chunk(handle, bytes)
        } catch (e) {
            throw SystemError.failed(code: 4, message: "file write failed")
        }
    }

    /// Close handle (throws `SystemError`).
    public static func close(handle: Int) throws {
        do {
            SyxHost.file_close(handle)
        } catch (e) {
            throw SystemError.failed(code: 2, message: "file close failed")
        }
    }

    /// Seek handle to `offset` (throws `SystemError`).
    public static func seek(handle: Int, offset: Int) throws {
        do {
            SyxHost.file_seek(handle, offset)
        } catch (e) {
            throw SystemError.failed(code: 5, message: "file seek failed")
        }
    }

    /// Read remaining bytes from handle to end (throws `SystemError`).
    public static func readAllBytes(handle: Int) throws -> Array<UInt8> {
        // M0-B07 / ADR-241: was `readMmap`; host is `read_to_end` (≠ OS mmap; S3-04 rename closeout).
        do {
            return SyxHost.file_read_all_bytes(handle)
        } catch (e) {
            throw SystemError.failed(code: 6, message: "file readAllBytes failed")
        }
    }

    /// ADR-234: instance resource open (Reader/Writer/Seekable/Closeable markers).
    public static func openResource(path: String, mode: String) throws -> FileResource {
        do {
            let h = SyxHost.file_open(path, mode)
            let f = FileResource()
            f.handle = h
            return f
        } catch (e) {
            throw SystemError.failed(code: 1, message: "file open failed")
        }
    }

    /// ADR-234: RAII/`with` — host runs `body(handle: Int)` then always closes.
    /// Body must return `>= 0` on success; negative / non-Int → `SystemError` after close.
    /// R-1-01: public body typed `Function` (≠ Object). Call sites: `{ h in ... }` /
    /// `{ (h: Int) -> Int in ... }` when parser supports the latter (today: prefer untyped `{ h in }`).
    public static func withOpen(path: String, mode: String, body: Function) throws -> Int {
        do {
            return SyxHost.file_with_open(path, mode, body)
        } catch (e) {
            throw SystemError.failed(code: 99, message: "withOpen body failed")
        }
    }
}

/// ADR-234: instance FileHandle resource (implements Reader/Writer/Seekable/Closeable markers).
public class FileResource {
    public var handle: Int = -1

    /// Read up to `maxBytes` from handle (throws `SystemError`).
    public func read(maxBytes: Int) throws -> Array<UInt8> {
        do {
            return SyxHost.file_read_chunk(self.handle, maxBytes)
        } catch (e) {
            throw SystemError.failed(code: 3, message: "file read failed")
        }
    }

    /// Write `bytes` to handle; returns byte count (throws `SystemError`).
    public func write(bytes: Array<UInt8>) throws -> Int {
        do {
            return SyxHost.file_write_chunk(self.handle, bytes)
        } catch (e) {
            throw SystemError.failed(code: 4, message: "file write failed")
        }
    }

    /// Seek handle to `offset` (throws `SystemError`).
    public func seek(offset: Int) throws {
        do {
            SyxHost.file_seek(self.handle, offset)
        } catch (e) {
            throw SystemError.failed(code: 5, message: "file seek failed")
        }
    }

    /// Close handle (throws `SystemError`).
    public func close() throws {
        let h = self.handle
        if h < 0 {
            return
        }
        self.handle = -1
        do {
            SyxHost.file_close(h)
        } catch (e) {
            throw SystemError.failed(code: 2, message: "file close failed")
        }
    }

    /// Read remaining bytes from handle to end (throws `SystemError`).
    public func readAllBytes() throws -> Array<UInt8> {
        do {
            return SyxHost.file_read_all_bytes(self.handle)
        } catch (e) {
            throw SystemError.failed(code: 6, message: "file readAllBytes failed")
        }
    }

    /// Close the handle quietly on destruction.
    deinit {
        SyxHost.file_close_quiet(self.handle)
    }
}

/// ADR-240 / M2-S3-03: FileStream chunked-read session (≠ File.read whole-file; ≠ mmap S3-04).
/// Close then readChunk must fail.

public class FileStream {
    /// Open a streaming file session (throws `SystemError`).
    public static func open(path: String, mode: String) throws -> Int {
        do {
            return SyxHost.file_stream_open(path, mode)
        } catch (e) {
            throw SystemError.failed(code: 1, message: "FileStream open failed")
        }
    }

    /// Empty array means EOF.
    public static func readChunk(handle: Int, maxBytes: Int) throws -> Array<UInt8> {
        do {
            return SyxHost.file_stream_read_chunk(handle, maxBytes)
        } catch (e) {
            throw SystemError.failed(code: 3, message: "FileStream read failed")
        }
    }

    /// Close the file-stream session (throws).
    public static func close(handle: Int) throws {
        do {
            SyxHost.file_stream_close(handle)
        } catch (e) {
            throw SystemError.failed(code: 2, message: "FileStream close failed")
        }
    }
}

/// ADR-240 / M2-S3-03: FileWatcher lifecycle session (≠ one-shot File.watch).
/// Close then poll must fail. Mock-default events (partial OS notify).

public class FileWatcher {
    /// Open a file watcher on `path` (throws).
    public static func open(path: String) throws -> Int {
        do {
            return SyxHost.file_watcher_open(path)
        } catch (e) {
            throw SystemError.failed(code: 10, message: "FileWatcher open failed")
        }
    }

    /// Poll watcher events (throws).
    public static func poll(handle: Int) throws -> Array<String> {
        do {
            return SyxHost.file_watcher_poll(handle)
        } catch (e) {
            throw SystemError.failed(code: 11, message: "FileWatcher poll failed")
        }
    }

    /// Close the file watcher (throws).
    public static func close(handle: Int) throws {
        do {
            SyxHost.file_watcher_close(handle)
        } catch (e) {
            throw SystemError.failed(code: 12, message: "FileWatcher close failed")
        }
    }
}

