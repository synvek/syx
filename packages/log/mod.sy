// Leveled logging + structured field lines (ADR-292 / ADR-293).

/// Global min-level filter and debug/info/warn/error (plain + fields).
public class Log {
    /// Emit a DEBUG log line.
    public static func debug(message: String) {
        __syx_log_debug(message)
    }

    /// Emit an INFO log line.
    public static func info(message: String) {
        __syx_log_info(message)
    }

    /// Emit a WARN log line.
    public static func warn(message: String) {
        __syx_log_warn(message)
    }

    /// Emit an ERROR log line.
    public static func error(message: String) {
        __syx_log_error(message)
    }

    /// ADR-292 / M3-D01: set global min level (`DEBUG`/`INFO`/`WARN`/`ERROR`).
    public static func setMinLevel(level: String) -> Bool {
        return __syx_log_set_min_level(level)
    }

    /// Current global minimum log level string.
    public static func minLevel() -> String {
        return __syx_log_min_level()
    }

    /// Fingerprint `log-v1-fields` (ADR-293; ≠ JSON GA / ≠ D02).
    public static func policy() -> String {
        return __syx_log_policy()
    }

    /// Structured INFO line; empty string if filtered below min level.
    public static func infoFields(message: String, fields: Dictionary) -> String {
        return __syx_log_info_fields(message, fields)
    }

    /// ADR-293: structured DEBUG/WARN/ERROR field lines (same format as infoFields).
    public static func debugFields(message: String, fields: Dictionary) -> String {
        return __syx_log_debug_fields(message, fields)
    }

    /// Structured WARN line with `fields`; empty if filtered.
    public static func warnFields(message: String, fields: Dictionary) -> String {
        return __syx_log_warn_fields(message, fields)
    }

    /// Structured ERROR line with `fields`; empty if filtered.
    public static func errorFields(message: String, fields: Dictionary) -> String {
        return __syx_log_error_fields(message, fields)
    }

    /// Last successfully emitted line (cleared on read); for filter nails.
    public static func takeLast() -> String {
        return __syx_log_take_last()
    }
}
