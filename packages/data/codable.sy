// Codable L14 migration / rename smoke helpers (host `SyxHost.codable_*`).
// Not the Encodable/Decodable protocols — those live under `core/protocols/`.

/// Register User Schema (host `SyxHost.codable_l14_register_migration`).
public func registerUserSchema() -> Bool {
    return SyxHost.codable_l14_register_migration("name", "User")
}

/// Register User Rename (host `SyxHost.codable_l14_register_rename`).
public func registerUserRename() -> Bool {
    return SyxHost.codable_l14_register_rename("User", "name", "fullName")
}

/// Encode user (host `SyxHost.codable_encode_l14`).
public func encodeUser(name: String) -> Array {
    return SyxHost.codable_encode_l14(name, "User")
}

/// Decode user (host `SyxHost.codable_decode_l14`).
public func decodeUser(wire: Array) -> String {
    return SyxHost.codable_decode_l14("User", wire)
}

