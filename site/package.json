{
  "name": "syx-site",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-content.mjs",
    "prebuild": "node scripts/sync-content.mjs",
    "dev": "vitepress dev docs --port 5174 --host 127.0.0.1",
    "build": "vitepress build docs",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vitepress preview docs --port 4174 --host 127.0.0.1",
    "sync": "node scripts/sync-content.mjs",
